        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जारीकर्ता किसी भी खाते में, आपके खाते में भी, इस टोकन को मूव या बर्न कर सकता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
