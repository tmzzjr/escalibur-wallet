    "Apps de fora da App Store podem ler o que este app guarda." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للتطبيقات من خارج App Store قراءة ما يحفظه هذا التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps von außerhalb des App Store können lesen, was diese App speichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps from outside the App Store can read what this app stores."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de fuera de la App Store pueden leer lo que guarda esta app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des apps installées hors de l’App Store peuvent lire ce que cette app stocke."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store के बाहर के ऐप इस ऐप में सेव किया गया डेटा पढ़ सकते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dari luar App Store bisa membaca data yang disimpan aplikasi ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 以外のアプリが、このアプリの保存データを読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 외부의 앱이 이 앱에 저장된 데이터를 읽을 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store dışından gelen uygulamalar bu uygulamanın sakladıklarını okuyabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng từ bên ngoài App Store có thể đọc dữ liệu mà ứng dụng này lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 App Store 以外的 App 可以读取此 App 存储的内容。"
          }
        }
      }
    },
    "Apps de fora da App Store podem ler o que este app guarda. Para valor alto, prefira uma carteira de hardware." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للتطبيقات من خارج App Store قراءة ما يحفظه هذا التطبيق. للمبالغ الكبيرة، استخدم محفظة أجهزة بدلًا منه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps von außerhalb des App Store können lesen, was diese App speichert. Für große Beträge nimm lieber ein Hardware-Wallet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps from outside the App Store can read what this app stores. For large amounts, use a hardware wallet instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps de fuera de la App Store pueden leer lo que guarda esta app. Para cantidades altas, mejor usa una billetera de hardware."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des apps installées hors de l’App Store peuvent lire ce que cette app stocke. Pour des montants élevés, préférez un portefeuille matériel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store के बाहर के ऐप इस ऐप में सेव किया गया डेटा पढ़ सकते हैं. बड़ी राशि के लिए हार्डवेयर वॉलेट इस्तेमाल करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikasi dari luar App Store bisa membaca data yang disimpan aplikasi ini. Untuk jumlah besar, gunakan dompet hardware."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 以外のアプリが、このアプリの保存データを読み取れます。高額の資産にはハードウェアウォレットを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 외부의 앱이 이 앱에 저장된 데이터를 읽을 수 있습니다. 큰 금액은 하드웨어 지갑을 사용하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store dışından gelen uygulamalar bu uygulamanın sakladıklarını okuyabilir. Yüksek tutarlar için bir donanım cüzdanı tercih et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng từ bên ngoài App Store có thể đọc dữ liệu mà ứng dụng này lưu. Với số tiền lớn, hãy dùng ví phần cứng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 App Store 以外的 App 可以读取此 App 存储的内容。大额资产请改用硬件钱包。"
          }
        }
      }
    },
    "Aqui errar não conta como tentativa." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأخطاء هنا لا تُحتسب كمحاولات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler zählen hier nicht als Versuch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mistakes here don't count as attempts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí los errores no cuentan como intentos."
