          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun relayeur n’a livré dans les délais, et Across a restitué le dépôt sur votre compte."
          }
        }
      }
    },
    "Nenhum: %@ que sobraria fica abaixo do mínimo que vale guardar e vai para a taxa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
