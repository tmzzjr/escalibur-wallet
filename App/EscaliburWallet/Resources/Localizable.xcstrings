        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントの別のトランザクションが先に処理されました。もう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 다른 트랜잭션이 먼저 들어갔습니다. 다시 검토하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesaptan başka bir işlem bundan önce girdi. Yeniden incele."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một giao dịch khác của tài khoản này đã vào trước giao dịch này. Hãy xem lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
