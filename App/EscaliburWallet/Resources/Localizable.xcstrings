    "Taxa da rede: cerca de %@. O máximo deixa %@ reservados para a taxa, e o que não for usado volta para a conta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network fee: about %@. The maximum leaves %@ reserved for the fee, and whatever isn't used returns to the account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comisión de red: unos %@. El máximo deja %@ reservados para la comisión, y lo que no se use vuelve a la cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frais de réseau : environ %@. Le maximum laisse %@ en réserve pour les frais, et ce qui n’est pas utilisé revient sur le compte."
          }
