    },
    "O CoinGecko publicou um aviso sobre %@ (ataque, migração ou golpe). Confira as notícias da moeda antes de receber." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشرت CoinGecko تحذيرًا بشأن %@ (هجوم أو ترحيل أو احتيال). اطّلع على أخبار العملة قبل الاستلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko hat eine Warnung zu %@ veröffentlicht (Angriff, Migration oder Betrug). Prüfe die Neuigkeiten zum Coin, bevor du empfängst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko published a warning about %@ (attack, migration or scam). Check the coin's news before receiving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko publicó un aviso sobre %@ (ataque, migración o estafa). Revisa las noticias de la moneda antes de recibir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko a publié un avertissement sur %@ (attaque, migration ou arnaque). Consultez l’actualité de la monnaie avant de recevoir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko ने %@ के बारे में चेतावनी जारी की है (हमला, माइग्रेशन या स्कैम). प्राप्त करने से पहले कॉइन की खबरें देखें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko menerbitkan peringatan tentang %@ (serangan, migrasi, atau penipuan). Periksa berita koin ini sebelum menerima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko が %@ に関する警告（攻撃、移行、詐欺）を公開しています。受け取る前に、このコインのニュースを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko가 %@에 대한 경고(공격, 마이그레이션 또는 사기)를 게시했습니다. 받기 전에 이 코인의 소식을 확인하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko %@ hakkında bir uyarı yayımladı (saldırı, geçiş veya dolandırıcılık). Almadan önce coin'in haberlerini kontrol et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko đã công bố cảnh báo về %@ (tấn công, chuyển đổi hợp đồng hoặc lừa đảo). Hãy xem tin tức về coin này trước khi nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko 发布了关于 %@ 的警告（攻击、迁移或诈骗）。接收前请先查看该币种的新闻。"
          }
        }
      }
    },
    "O Espelhamento do iPhone no Mac não aparece para os apps. Não use o espelhamento para digitar as palavras." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظهر محاكاة iPhone على Mac للتطبيقات. لا تستخدم محاكاة iPhone لكتابة الكلمات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps sehen die iPhone-Synchronisierung auf dem Mac nicht. Nutze die iPhone-Synchronisierung nicht, um die Wörter einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps can't see iPhone Mirroring on the Mac. Don't use mirroring to type the words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps no pueden ver la Duplicación del iPhone en el Mac. No uses la duplicación para escribir las palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps ne voient pas la recopie de l’iPhone sur le Mac. N’utilisez pas la recopie pour saisir les mots."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac पर iPhone मिररिंग ऐप्स को नहीं दिखती. शब्द टाइप करने के लिए मिररिंग का इस्तेमाल न करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencerminan iPhone di Mac tidak terlihat oleh aplikasi. Jangan gunakan Pencerminan iPhone untuk mengetik kata-kata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac での iPhoneミラーリングはアプリから検出できません。単語の入力に iPhoneミラーリングを使わないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 Mac의 iPhone 미러링을 감지할 수 없습니다. 단어를 입력할 때 iPhone 미러링을 사용하지 마세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'teki iPhone Yansıtma uygulamalara görünmez. Kelimeleri yazmak için iPhone Yansıtma'yı kullanma."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các ứng dụng không thấy được Phản chiếu iPhone trên máy Mac. Đừng dùng Phản chiếu iPhone để nhập các từ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 无法检测到 Mac 上的 iPhone 镜像。请勿通过 iPhone 镜像输入单词。"
          }
        }
      }
    },
    "O PIN atual não confere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN الحالي غير صحيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle PIN stimmt nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current PIN doesn't match."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PIN actual no coincide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PIN actuel ne correspond pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा PIN मेल नहीं खाता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN saat ini tidak cocok."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の PIN が一致しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 PIN이 일치하지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut PIN eşleşmiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN hiện tại không khớp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 PIN 码不正确。"
          }
        }
      }
    },
    "O PIN e o %@ juntos para abrir o app, enviar, trocar e ver as palavras. Nenhum dos dois sozinho abre nada: é a própria cifra das carteiras que pede os dois." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your PIN and %@ together to open the app, send, swap and see the words. Neither one opens anything alone: the wallets' own encryption asks for both."
          }
        }
      }
    },
    "O PIN mora só neste iPhone, e ninguém tem cópia dele, nem a Escalibur. Para voltar a usar o app, comece de novo:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجد PIN على هذا iPhone فقط، ولا يملك أحد نسخة منه، ولا حتى Escalibur. لاستخدام التطبيق مجددًا، ابدأ من جديد:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die PIN existiert nur auf diesem iPhone, und niemand hat eine Kopie davon, auch Escalibur nicht. Um die App wieder zu nutzen, fang neu an:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PIN lives only on this iPhone, and no one has a copy of it, not even Escalibur. To use the app again, start over:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PIN vive solo en este iPhone, y nadie tiene una copia, ni siquiera Escalibur. Para volver a usar la app, empieza de nuevo:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PIN existe uniquement sur cet iPhone, et personne n’en a de copie, pas même Escalibur. Pour utiliser à nouveau l’app, recommencez :"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN सिर्फ़ इसी iPhone पर रहता है, और इसकी कॉपी किसी के पास नहीं है, Escalibur के पास भी नहीं. ऐप फिर से इस्तेमाल करने के लिए, नए सिरे से शुरू करें:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN hanya ada di iPhone ini, dan tidak ada yang memiliki salinannya, bahkan Escalibur. Untuk memakai aplikasi lagi, mulai dari awal:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN はこの iPhone にのみ保存され、誰もコピーを持っていません。Escalibur も同様です。アプリを再び使うには、最初からやり直してください："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN은 이 iPhone에만 있으며, Escalibur를 포함해 누구도 사본을 갖고 있지 않습니다. 앱을 다시 사용하려면 처음부터 시작하세요:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN yalnızca bu iPhone'da bulunur ve kimsede kopyası yoktur, Escalibur'da bile. Uygulamayı yeniden kullanmak için baştan başla:"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN chỉ nằm trên iPhone này, và không ai có bản sao, kể cả Escalibur. Để dùng lại ứng dụng, hãy bắt đầu lại:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN 码只存在于这台 iPhone 上，任何人都没有副本，Escalibur 也没有。要继续使用 App，请重新开始："
          }
        }
      }
    },
    "O PIN não recupera a carteira. Se você esquecer o PIN, a senha da carteira traz tudo de volta." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN لا يستعيد المحفظة. إذا نسيت PIN، تعيد عبارة الاسترداد كل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die PIN stellt das Wallet nicht wieder her. Wenn du die PIN vergisst, bringt die Wiederherstellungsphrase alles zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PIN doesn't recover the wallet. If you forget the PIN, the recovery phrase brings everything back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PIN no recupera la billetera. Si olvidas el PIN, la frase de recuperación lo recupera todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PIN ne permet pas de récupérer le portefeuille. Si vous oubliez le PIN, la phrase de récupération permet de tout récupérer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN से वॉलेट रिकवर नहीं होता. अगर आप PIN भूल जाएं, तो रिकवरी फ़्रेज़ सब कुछ वापस ले आता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN tidak memulihkan dompet. Jika Anda lupa PIN, frasa pemulihan akan mengembalikan semuanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN ではウォレットを復元できません。PIN を忘れても、リカバリーフレーズがあればすべて元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN으로는 지갑을 복구할 수 없습니다. PIN을 잊어도 복구 구문이 있으면 모두 되찾을 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN cüzdanı kurtarmaz. PIN'i unutursan kurtarma ifadesi her şeyi geri getirir."
