    "Existe iOS mais novo, com correções de segurança. Atualize quando puder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوفر إصدار أحدث من iOS مع إصلاحات أمنية. حدّث عندما تستطيع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt ein neueres iOS mit Sicherheitskorrekturen. Aktualisiere, wenn du kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A newer iOS with security fixes is available. Update when you can."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un iOS más nuevo, con correcciones de seguridad. Actualiza cuando puedas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une version plus récente d’iOS, avec des correctifs de sécurité, est disponible. Mettez à jour dès que possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरक्षा सुधारों वाला नया iOS उपलब्ध है. जब हो सके, अपडेट करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersedia iOS yang lebih baru dengan perbaikan keamanan. Perbarui jika sempat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュリティ修正を含む新しい iOS があります。できるときにアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 수정이 포함된 최신 iOS가 있습니다. 가능할 때 업데이트하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenlik düzeltmeleri içeren daha yeni bir iOS var. Fırsat bulunca güncelle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã có phiên bản iOS mới hơn với các bản sửa lỗi bảo mật. Hãy cập nhật khi có thể."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有更新的 iOS 版本可用，包含安全修复。方便时请更新。"
          }
        }
      }
    },
