    "Bitcoin, Ethereum, Solana e mais %lld redes. Envie, receba, troque e leve entre redes, com a taxa à vista antes de assinar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin, Ethereum, Solana and %lld more networks. Send, receive, swap and bridge between networks, with the fee shown before you sign."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin, Ethereum, Solana y %lld redes más. Envía, recibe, intercambia y mueve entre redes, con la comisión a la vista antes de firmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitcoin, Ethereum, Solana et %lld autres réseaux. Envoyez, recevez, échangez et passez d’un réseau à l’autre, avec les frais affichés avant de signer."
          }
        }
      }
    },
