    "Para enviar %@, cancele a ordem antes. O que ela não vendeu volta a ficar livre na carteira assim que a rede confirmar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإرسال %@، ألغِ الأمر أولًا. ما لم يبعه الأمر يصبح متاحًا مجددًا في المحفظة بمجرد أن تؤكد الشبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ zu senden, storniere zuerst die Order. Was sie nicht verkauft hat, wird im Wallet wieder frei, sobald das Netzwerk bestätigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
