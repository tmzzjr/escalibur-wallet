      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Price from the %@ pool on %@, with %@ in liquidity, via GeckoTerminal. It's a DEX price: anyone can create a pool, so it isn't included in the total balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
