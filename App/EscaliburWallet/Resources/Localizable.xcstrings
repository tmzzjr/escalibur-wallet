    "Esta carteira não tem cópia confirmada. Removida, o saldo fica inacessível para sempre." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المحفظة بلا نسخة احتياطية مؤكدة. إذا أزلتها، يصبح الرصيد غير قابل للوصول إلى الأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wallet hat kein bestätigtes Backup. Wenn du es entfernst, ist das Guthaben für immer unzugänglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet has no confirmed backup. If you remove it, the funds become inaccessible forever."
