    "Custo da rede neste envio: %@ queimados da conta%@. O máximo já desconta." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكلفة الشبكة لهذا التحويل: %@ محروقة من الحساب%@. الحد الأقصى يأخذها في الحسبان بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netzwerkkosten für diesen Transfer: %@ vom Konto verbrannt%@. Das Maximum berücksichtigt das bereits."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network cost for this transfer: %@ burned from the account%@. The maximum already accounts for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costo de red en este envío: %@ quemados de la cuenta%@. El máximo ya lo descuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coût réseau de cet envoi : %@ brûlés sur le compte%@. Le maximum en tient déjà compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ट्रांसफ़र की नेटवर्क लागत: खाते से %@ बर्न%@. अधिकतम में यह पहले से घटा दिया गया है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya jaringan untuk pengiriman ini: %@ dibakar dari akun%@. Jumlah maksimum sudah memperhitungkannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この送金のネットワーク費用：アカウントから %@ をバーン%@。最大額から差し引き済みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 전송의 네트워크 비용: 계정에서 %@ 소각%@. 최대 금액에 이미 반영되었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Custo da rede neste envio: %1$@ queimados da conta%2$@. O máximo já desconta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu transferin ağ maliyeti: hesaptan %@ yakılır%@. Maksimum bunu zaten hesaba katar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi phí mạng cho lần gửi này: %@ bị đốt từ tài khoản%@. Mức tối đa đã tính khoản này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此笔转账的网络费用：从账户燃烧 %@%@。最大金额已扣除此费用。"
