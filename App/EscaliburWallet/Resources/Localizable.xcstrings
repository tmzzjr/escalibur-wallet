        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún relayer entregó a tiempo, y Across devolvió el depósito a tu cuenta."
          }
        }
      }
    },
    "Nenhum: %@ que sobraria fica abaixo do mínimo que vale guardar e vai para a taxa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
