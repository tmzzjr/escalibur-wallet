        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस लिफ़ाफ़े में एक SLIP-39 शेयर है. अकेला शेयर वॉलेट नहीं खोलता, और यह वर्ज़न अभी शेयर जोड़ नहीं सकता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amplop ini menyimpan satu bagian SLIP-39. Satu bagian saja tidak bisa membuka dompet, dan versi ini belum bisa menggabungkan bagian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンベロープには SLIP-39 のシェアが入っています。シェア 1 つだけではウォレットを開けず、このバージョンではまだシェアを組み合わせられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 봉투에는 SLIP-39 조각이 들어 있습니다. 조각 하나로는 지갑을 열 수 없으며, 이 버전은 아직 조각을 합칠 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu zarf bir SLIP-39 parçası içeriyor. Tek bir parça cüzdan açmaz ve bu sürüm henüz parçaları birleştiremiyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phong bì này chứa một phần SLIP-39. Một phần riêng lẻ không mở được ví, và phiên bản này chưa ghép được các phần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
