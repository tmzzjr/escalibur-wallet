    "%@, o prazo mais longo que a CoW aceita. Até lá, fica aberta até executar ou você cancelar" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@، أطول مدة تقبلها CoW. حتى ذلك الحين، يبقى الأمر مفتوحًا حتى يُنفَّذ أو تلغيه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, die längste Frist, die CoW erlaubt. Bis dahin bleibt sie offen, bis sie ausgeführt wird oder du sie stornierst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, the longest CoW allows. Until then, it stays open until it executes or you cancel it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, el plazo más largo que acepta CoW. Hasta entonces, sigue abierta hasta que se ejecute o la canceles"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, l’échéance la plus longue acceptée par CoW. D’ici là, l’ordre reste ouvert jusqu’à ce qu’il s’exécute ou que vous l’annuliez"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, CoW की सबसे लंबी अवधि. तब तक यह एक्ज़ीक्यूट होने या आपके रद्द करने तक खुला रहता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, batas terlama yang diizinkan CoW. Sampai saat itu, order tetap terbuka hingga tereksekusi atau Anda batalkan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、CoW で設定できる最長の期限です。それまでは、約定するかキャンセルするまで注文が有効です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, CoW가 허용하는 최장 기한. 그때까지 체결되거나 직접 취소할 때까지 열려 있음"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, CoW'un izin verdiği en uzun süre. O zamana kadar gerçekleşene veya sen iptal edene kadar açık kalır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, thời hạn dài nhất CoW cho phép. Trước thời điểm đó, lệnh vẫn mở cho đến khi khớp hoặc bạn hủy"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@，这是 CoW 允许的最长期限。在此之前，订单会一直开放，直到成交或你取消"
          }
        }
      }
    },
    "%@, o que não for usado não é cobrado" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@، وما لا يُستخدم لا يُدفع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Ungenutztes wird nicht berechnet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, you aren't charged for what isn't used"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, lo que no se use no se cobra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ce qui n’est pas utilisé n’est pas facturé"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, जो इस्तेमाल नहीं होता उसका शुल्क नहीं लगता"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, yang tidak terpakai tidak dikenakan biaya"
          }
