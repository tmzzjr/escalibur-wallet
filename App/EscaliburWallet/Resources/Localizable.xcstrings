        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बर्न किया गया USDC सिर्फ़ आपके खाते में मिंट हो सकता है. अगर Circle की डिलीवरी विफल होती है, तो वॉलेट आपके सिग्नेचर से इसे रिडीम कर लेता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USDC yang dibakar hanya bisa di-mint ke akun Anda. Jika pengantaran Circle gagal, dompet menebusnya dengan tanda tangan Anda"
