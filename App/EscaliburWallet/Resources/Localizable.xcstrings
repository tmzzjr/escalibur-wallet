        }
      }
    },
    "A taxa máxima calculada (%@) passa do teto de segurança da carteira. Nada foi assinado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأقصى المحسوب للرسوم (%@) يتجاوز سقف الأمان في المحفظة. لم يتم توقيع أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die berechnete Höchstgebühr (%@) überschreitet die Sicherheitsgrenze des Wallets. Nichts wurde signiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The calculated maximum fee (%@) exceeds the wallet's safety cap. Nothing was signed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comisión máxima calculada (%@) supera el tope de seguridad de la billetera. No se firmó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les frais maximaux calculés (%@) dépassent le plafond de sécurité du portefeuille. Rien n’a été signé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलकुलेट किया गया अधिकतम शुल्क (%@) वॉलेट की सुरक्षा सीमा से ज़्यादा है. कुछ भी साइन नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya maksimum yang dihitung (%@) melebihi batas keamanan dompet. Tidak ada yang ditandatangani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算された最大手数料（%@）がウォレットの安全上限を超えています。何も署名されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계산된 최대 수수료(%@)가 지갑의 안전 한도를 넘습니다. 서명된 것이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesaplanan maksimum ücret (%@) cüzdanın güvenlik üst sınırını aşıyor. Hiçbir şey imzalanmadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phí tối đa đã tính (%@) vượt mức trần an toàn của ví. Chưa có gì được ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计算出的最高手续费 (%@) 超出钱包的安全上限。未签署任何内容。"
          }
        }
      }
    },
