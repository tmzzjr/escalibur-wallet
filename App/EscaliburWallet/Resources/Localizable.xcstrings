    "Envios, recebimentos, trocas e ordens, cada um com o seu status." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمليات الإرسال والاستلام والمبادلات والأوامر، كلٌّ بحالته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden, Empfangen, Tausch und Orders, jeweils mit Status."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends, receives, swaps and orders, each with its status."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envíos, recepciones, intercambios y órdenes, cada uno con su estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envois, réceptions, échanges et ordres, chacun avec son statut."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भेजे गए, प्राप्त, स्वैप और ऑर्डर, हर एक अपने स्टेटस के साथ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengiriman, penerimaan, penukaran, dan order, masing-masing dengan statusnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送金、受け取り、スワップ、注文を、それぞれのステータスとともに表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송, 입금, 스왑, 주문을 각각의 상태와 함께 표시합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderimler, gelen transferler, takaslar ve emirler, her biri kendi durumuyla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi, nhận, hoán đổi và lệnh, mỗi mục kèm trạng thái."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转账、收款、兑换和订单，各自显示状态。"
          }
        }
      }
    },
    "Envios, trocas e pontes desta carteira pedem a passphrase antes do %@ ou do PIN." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends, swaps and bridges from this wallet ask for the passphrase before %@ or the PIN."
          }
        }
      }
    },
    "Equilíbrio: passa na maioria das trocas sem deixar espaço grande para robôs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوازن: ينجح في معظم المبادلات دون ترك مجال كبير للروبوتات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgewogen: reicht für die meisten Tauschvorgänge, ohne Bots viel Spielraum zu lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balanced: works for most swaps without leaving much room for bots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibrado: funciona en la mayoría de los intercambios sin dejar mucho margen a los bots."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Équilibré : passe pour la plupart des échanges sans laisser beaucoup de marge aux robots."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संतुलित: ज़्यादातर स्वैप में काम करता है, बॉट के लिए ज़्यादा गुंजाइश छोड़े बिना."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seimbang: berhasil untuk sebagian besar penukaran tanpa memberi banyak ruang bagi bot."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バランス：ほとんどのスワップで成立し、ボットにつけ入る余地をあまり与えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "균형: 대부분의 스왑이 체결되면서 봇이 끼어들 여지는 크지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengeli: botlara fazla alan bırakmadan çoğu takasta yeterli olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân bằng: thành công với hầu hết các lần hoán đổi mà không để nhiều khoảng trống cho bot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "均衡：适用于大多数兑换，不给机器人留太多空间。"
          }
        }
      }
    },
