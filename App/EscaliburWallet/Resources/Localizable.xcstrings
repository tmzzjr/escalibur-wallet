          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर इस वॉलेट में पहले कभी राशि आई है, तो ये वही पते हैं जिन्हें आप जानते हैं. अगर ये मेल नहीं खाते, तो कोई शब्द अलग है, और यहां जो खुलेगा वह कोई दूसरा, खाली वॉलेट होगा."
          }
        },
        "id" : {
          "stringUnit" : {
