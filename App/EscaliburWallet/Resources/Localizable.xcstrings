        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 无法识别这种链接。请只粘贴地址。"
          }
        }
      }
    },
    "O app sorteou esta entre as %lld que fecham a conta com as suas %lld. Anote no papel, como a %lldª." : {
      "localizations" : {
