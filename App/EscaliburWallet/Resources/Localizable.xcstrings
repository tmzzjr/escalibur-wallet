    "O emissor pode mover ou queimar este token em qualquer conta, inclusive na sua." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستطيع المُصدِر نقل هذا الرمز المميز أو حرقه في أي حساب، بما في ذلك حسابك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Emittent kann diesen Token in jedem Konto bewegen oder verbrennen, auch in deinem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The issuer can move or burn this token in any account, including yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El emisor puede mover o quemar este token en cualquier cuenta, incluida la tuya."
