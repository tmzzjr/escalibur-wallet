        }
      }
    },
    "Este envelope guarda uma parte SLIP-39. Uma parte sozinha não abre carteira, e esta versão ainda não junta partes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي هذا المغلف على جزء SLIP-39. جزء واحد لا يفتح محفظة، وهذا الإصدار لا يجمع الأجزاء بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Umschlag enthält einen SLIP-39-Anteil. Ein einzelner Anteil öffnet kein Wallet, und diese Version kann Anteile noch nicht zusammenführen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This envelope holds a SLIP-39 share. A single share doesn't open a wallet, and this version can't combine shares yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sobre guarda una parte SLIP-39. Una parte sola no abre una billetera, y esta versión aún no junta partes."
