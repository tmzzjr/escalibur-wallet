    },
    "Sem conexão com a internet. Nada foi montado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No internet connection. Nothing was prepared."
          }
        },
        "es" : {
          "stringUnit" : {
