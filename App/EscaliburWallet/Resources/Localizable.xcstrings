    "O %@ deste iPhone mudou desde que foi ligado aqui. Confirme com o PIN; depois você pode religar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ on this iPhone has changed since it was turned on here. Confirm with your PIN; then you can turn it back on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de este iPhone cambió desde que se activó aquí. Confirma con el PIN; después puedes volver a activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a changé sur cet iPhone depuis son activation ici. Confirmez avec votre PIN ; vous pourrez ensuite le réactiver."
          }
        }
      }
    },
    "O %@ deste iPhone mudou desde que foi ligado aqui. Entre com o PIN; depois você pode religar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
