    "Valor acima do que esta rota do Across aceita agora. Tente um valor menor ou divida em partes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المبلغ أعلى مما يقبله مسار Across هذا الآن. جرّب مبلغًا أصغر أو قسّمه إلى أجزاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betrag über dem, was diese Across-Route gerade akzeptiert. Versuche einen kleineren Betrag oder teile ihn auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
