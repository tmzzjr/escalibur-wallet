    "Fora da lista verificada. Os suspeitos não aparecem aqui: ficam sempre escondidos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خارج القائمة الموثّقة. لا تظهر المشبوهة هنا: فهي مخفية دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht auf der verifizierten Liste. Verdächtige erscheinen hier nicht: Sie bleiben immer ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not on the verified list. Suspicious ones don't appear here: they're always hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de la lista verificada. Los sospechosos no aparecen aquí: siempre quedan ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors de la liste vérifiée. Les suspects n’apparaissent pas ici : ils restent toujours masqués."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेरिफ़ाइड सूची में नहीं. संदिग्ध टोकन यहां नहीं दिखते: वे हमेशा छिपे रहते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di luar daftar terverifikasi. Token mencurigakan tidak muncul di sini: selalu disembunyikan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証済みリスト外です。不審なものはここに表示されず、常に非表示です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검증된 목록 밖의 토큰입니다. 의심 토큰은 여기에 표시되지 않고 항상 숨겨집니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doğrulanmış listede değil. Şüpheliler burada görünmez: her zaman gizli kalırlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài danh sách đã xác minh. Các token đáng ngờ không hiển thị ở đây: chúng luôn được ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不在验证列表中。可疑代币不会显示在这里：它们始终处于隐藏状态。"
          }
        }
      }
    },
    "Fora da lista verificada. Sem preço confiável, ficam fora do saldo total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خارج القائمة الموثّقة. بدون سعر موثوق، لا تُحتسب في الرصيد الإجمالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht auf der verifizierten Liste. Ohne verlässlichen Preis zählen sie nicht zum Gesamtguthaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not on the verified list. Without a reliable price, they're left out of the total balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera de la lista verificada. Sin un precio fiable, quedan fuera del saldo total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors de la liste vérifiée. Sans prix fiable, ils sont exclus du solde total."
