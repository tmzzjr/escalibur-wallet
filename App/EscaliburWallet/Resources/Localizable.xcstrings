        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN không khôi phục được ví. Nếu bạn quên PIN, cụm từ khôi phục sẽ lấy lại mọi thứ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN 码无法恢复钱包。如果忘记 PIN 码，助记词可以恢复一切。"
          }
        }
      }
    },
