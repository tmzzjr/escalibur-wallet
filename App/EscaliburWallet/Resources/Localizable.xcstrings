    "A Circle atesta e entrega em menos de 1 minuto." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصادق Circle وتسلّم في أقل من دقيقة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle beglaubigt und liefert in unter 1 Minute."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle attests and delivers in under 1 minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle certifica y entrega en menos de 1 minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle atteste et livre en moins d’une minute."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle 1 मिनट से कम में अटेस्ट करके डिलीवर करता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle memberi atestasi dan mengirimkan dalam waktu kurang dari 1 menit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle が 1 分以内に証明して届けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle이 1분 이내에 증명하고 전달합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle 1 dakikadan kısa sürede doğrular ve teslim eder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle xác thực và chuyển đến trong chưa đầy 1 phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle 会在 1 分钟内完成证明并到账。"
          }
        }
      }
    },
    "A Circle entrega na %@ e cobra o gás de lá dentro da taxa acima. Você não precisa ter %@ na %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسلّم Circle على %@ وتدفع رسوم الغاز هناك من الرسوم أعلاه. لا تحتاج إلى امتلاك %@ على %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle liefert auf %@ und zahlt das Gas dort aus der Gebühr oben. Du brauchst kein %@ auf %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle delivers on %@ and pays the gas there out of the fee above. You don't need to hold %@ on %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle entrega en %@ y cobra el gas de allí dentro de la comisión de arriba. No necesitas tener %@ en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle livre sur %@ et paie le gaz sur place avec les frais ci-dessus. Vous n’avez pas besoin d’avoir de %@ sur %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle %1$@ पर डिलीवर करता है और वहां का गैस ऊपर दिए शुल्क में से चुकाता है. आपको %3$@ पर %2$@ रखने की ज़रूरत नहीं है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle mengirimkan ke %@ dan membayar gas di sana dari biaya di atas. Anda tidak perlu memiliki %@ di %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle は %1$@ で届け、そこでのガス代は上記の手数料から支払います。%3$@ に %2$@ を保有している必要はありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle이 %1$@ 네트워크에서 전달하며 그곳의 가스비는 위 수수료에서 냅니다. %3$@ 네트워크에 %2$@ 토큰이 없어도 됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A Circle entrega na %1$@ e cobra o gás de lá dentro da taxa acima. Você não precisa ter %2$@ na %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle %1$@ ağında teslim eder ve oradaki gas ücretini yukarıdaki ücretten karşılar. %3$@ ağında %2$@ bulundurman gerekmez"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circle chuyển đến trên %@ và trả phí gas ở đó từ khoản phí ở trên. Bạn không cần có %@ trên %@"
