    "Esta oferta não está mais aberta: já executou ou foi cancelada." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا العرض لم يعد مفتوحًا: نُفّذ بالفعل أو أُلغي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Angebot ist nicht mehr offen: Es wurde schon ausgeführt oder storniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This offer is no longer open: it has already executed or was canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta oferta ya no está abierta: ya se ejecutó o se canceló."
