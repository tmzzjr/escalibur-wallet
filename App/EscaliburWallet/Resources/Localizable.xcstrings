    "Primeiro envio para este endereço? Mandar um valor pequeno antes é a forma mais barata de conferir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أول تحويل إلى هذا العنوان؟ إرسال مبلغ صغير أولًا هو أرخص طريقة للتحقق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erster Transfer an diese Adresse? Erst einen kleinen Betrag zu senden ist der günstigste Weg zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First transfer to this address? Sending a small amount first is the cheapest way to check."
          }
