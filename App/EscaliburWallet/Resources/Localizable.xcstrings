            "value" : "Zirvenin %%%@ altında"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thấp hơn %@%% so với đỉnh"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比历史最高低 %@%%"
          }
        }
      }
    },
    "%@%% abaixo do preço de mercado. A ordem pode sair na hora, vendendo abaixo do mercado até este preço." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من سعر السوق بنسبة %@%%. قد يُنفَّذ الأمر فورًا، فيبيع بأقل من سعر السوق حتى هذا السعر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %% unter dem Marktpreis. Die Order kann sofort ausgeführt werden und dabei bis zu diesem Preis unter Markt verkaufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% below the market price. The order may execute right away, selling below market down to this price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% por debajo del precio de mercado. La orden puede ejecutarse al instante, vendiendo por debajo del mercado hasta este precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %% sous le prix du marché. L’ordre peut s’exécuter immédiatement, en vendant sous le marché jusqu’à ce prix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मार्केट कीमत से %@%% कम. ऑर्डर तुरंत एक्ज़ीक्यूट हो सकता है और इस कीमत तक मार्केट से कम पर बेच सकता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% di bawah harga pasar. Order bisa langsung tereksekusi, menjual di bawah harga pasar hingga harga ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場価格より %@%% 低い価格です。注文はすぐに約定し、この価格まで市場より安く売却される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장 가격보다 %@%% 낮습니다. 주문이 즉시 체결되어 이 가격까지 시장가보다 낮게 매도될 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piyasa fiyatının %%%@ altında. Emir hemen gerçekleşebilir ve bu fiyata kadar piyasanın altında satış yapar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thấp hơn giá thị trường %@%%. Lệnh có thể khớp ngay, bán dưới giá thị trường xuống đến mức giá này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低于市场价 %@%%。订单可能立即成交，以低于市场的价格卖出，最低至此价格。"
          }
        }
      }
    },
    "%@%% abaixo do preço de mercado. Confira o número: a ordem sairia na hora, com prejuízo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من سعر السوق بنسبة %@%%. تحقق من الرقم: سيُنفَّذ الأمر فورًا، بخسارة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %% unter dem Marktpreis. Prüfe die Zahl: Die Order würde sofort mit Verlust ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% below the market price. Check the number: the order would execute right away, at a loss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% por debajo del precio de mercado. Revisa el número: la orden se ejecutaría al instante, con pérdida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %% sous le prix du marché. Vérifiez le chiffre : l’ordre s’exécuterait immédiatement, à perte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मार्केट कीमत से %@%% कम. संख्या जांचें: ऑर्डर तुरंत, घाटे में एक्ज़ीक्यूट होगा."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% di bawah harga pasar. Periksa angkanya: order akan langsung tereksekusi, dengan kerugian."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場価格より %@%% 低い価格です。数値を確認してください。注文はすぐに約定し、損失が出ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장 가격보다 %@%% 낮습니다. 숫자를 확인하세요. 이대로면 주문이 즉시 체결되어 손실이 발생합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piyasa fiyatının %%%@ altında. Sayıyı kontrol et: emir hemen ve zararına gerçekleşir."
