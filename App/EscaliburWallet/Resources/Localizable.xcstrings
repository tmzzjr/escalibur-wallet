    "Ouço em %@. A língua se troca em Ajustes, Confirmação por voz." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أستمع باللغة %@. يمكنك تغيير اللغة في الإعدادات، التأكيد الصوتي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich höre auf %@. Die Sprache änderst du in den Einstellungen unter „Sprachbestätigung“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I listen in %@. You can change the language in Settings, Voice confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucho en %@. El idioma se cambia en Ajustes, Confirmación por voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’écoute en %@. Vous pouvez changer la langue dans Réglages, Confirmation vocale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ में सुना जाता है. भाषा आप सेटिंग्स, वॉइस पुष्टि में बदल सकते हैं."
