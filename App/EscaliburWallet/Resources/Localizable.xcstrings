        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sem conexão com as fontes agora. Dados de %1$@, do %2$@."
          }
        }
      }
    },
    "Sem conexão com os dados de mercado agora." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No connection to market data right now."
