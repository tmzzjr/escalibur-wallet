          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지갑은 보기 전용입니다. 취소하려면 서명할 수 있는 지갑을 여세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
