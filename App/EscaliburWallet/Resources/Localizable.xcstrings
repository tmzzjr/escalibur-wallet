          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扣除网络费和账户最低储备金后，SOL 不足以完成此笔转账。"
          }
        }
      }
    },
    "Não ouvi nada. Toque em falar e diga a frase perto do iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أسمع شيئًا. اضغط على تحدّث الآن وقل العبارة قريبًا من iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe nichts gehört. Tippe auf „Jetzt sprechen“ und sag die Phrase nah am iPhone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I didn't hear anything. Tap Speak now and say the phrase close to the iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
