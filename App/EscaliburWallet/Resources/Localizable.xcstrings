        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक्ज़ीक्यूट होने या रद्द होने तक ऑर्डर बुक में रहता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
