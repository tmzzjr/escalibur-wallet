                  "value" : "%lld تحويلان واردان مشبوهان مخفيان. هي تحويلات بقيمة صفر أو لرموز مميزة خارج القائمة، غالبًا من عناوين تشبه عناوينك."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld تحويل وارد مشبوه مخفي. هي تحويلات بقيمة صفر أو لرموز مميزة خارج القائمة، غالبًا من عناوين تشبه عناوينك."
                }
              }
            }
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld verdächtige Eingänge ausgeblendet. Das sind Transfers ohne Wert oder Token außerhalb der Liste, oft von Adressen, die deinen ähneln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld suspicious incoming transfers hidden. They're zero-value transfers or tokens not on the list, often from addresses that look like yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld transferencias recibidas sospechosas ocultas. Son envíos de valor cero o de tokens fuera de la lista, muchas veces desde direcciones parecidas a las tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld réceptions suspectes masquées. Ce sont des envois de valeur nulle ou de jetons hors liste, souvent depuis des adresses qui ressemblent aux vôtres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld संदिग्ध आने वाले ट्रांसफ़र छिपाए गए. ये ज़ीरो-वैल्यू ट्रांसफ़र या सूची से बाहर के टोकन हैं, अक्सर आपके पतों जैसे दिखने वाले पतों से."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld penerimaan mencurigakan disembunyikan. Ini adalah transfer bernilai nol atau token di luar daftar, sering kali dari alamat yang mirip dengan alamat Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不審な受け取り %lld 件を非表示にしました。金額ゼロの送金やリスト外のトークンで、多くはお使いのアドレスに似たアドレスから送られています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의심스러운 입금 %lld건을 숨겼습니다. 금액이 0인 전송이나 목록에 없는 토큰으로, 내 주소와 비슷한 주소에서 오는 경우가 많습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld şüpheli gelen transfer gizlendi. Bunlar sıfır değerli transferler veya liste dışı token'lardır ve çoğu zaman seninkilere benzeyen adreslerden gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã ẩn %lld khoản nhận đáng ngờ. Đây là các giao dịch giá trị bằng 0 hoặc token ngoài danh sách, thường đến từ các địa chỉ trông giống địa chỉ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已隐藏 %lld 笔可疑转入。这类转入是零金额转账或列表外的代币，通常来自与你的地址相似的地址。"
          }
        }
      }
    },
