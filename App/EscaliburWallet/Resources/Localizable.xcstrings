    "Guarde a passphrase num lugar diferente das palavras. Esquecer a passphrase é perder a carteira com passphrase: ninguém recupera, nem a Escalibur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the passphrase somewhere other than the words. Forgetting the passphrase means losing the wallet with passphrase: nobody can recover it, not even Escalibur."
          }
        }
      }
    },
    "Guarde o arquivo onde quiser. Ele só abre no app, com a senha do envelope." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre die Datei auf, wo du willst. Sie öffnet sich nur in der App, mit dem Umschlag-Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the file wherever you like. It only opens in the app, with the envelope password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el archivo donde quieras. Solo se abre en la app, con la contraseña del sobre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez le fichier où vous voulez. Il ne s’ouvre que dans l’app, avec le mot de passe de l’enveloppe."
          }
        }
      }
    },
    "Guarde onde quiser. Descriptografe no app ou no decifrador aberto." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظه أينما تريد. فك تشفيره في التطبيق أو في أداة فك التشفير مفتوحة المصدر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre sie auf, wo du willst. Entschlüsseln in der App oder mit dem offenen Entschlüsseler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it anywhere. Decrypt it in the app or the open-source decryptor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdalo donde quieras. Descífralo en la app o en el descifrador abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez-le où vous voulez. Déchiffrez-le dans l’app ou le déchiffreur libre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे कहीं भी रखें. इसे ऐप में या ओपन-सोर्स डिक्रिप्टर में डिक्रिप्ट करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan di mana saja. Dekripsi di aplikasi atau dengan alat dekripsi open source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きな場所に保管できます。アプリかオープンソースの復号ツールで復号できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 곳에 보관하세요. 앱이나 오픈 소스 복호화 도구로 복호화할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğin yerde sakla. Uygulamada veya açık kaynak şifre çözücüde çöz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cất ở bất cứ đâu bạn muốn. Giải mã trong ứng dụng hoặc bằng công cụ giải mã mã nguồn mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存放在任何地方都可以。可在 App 中或用开源解密工具解密。"
          }
        }
      }
    },
