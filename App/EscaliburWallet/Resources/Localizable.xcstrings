        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क से मिला USDT वॉलेट इस खाते का नहीं है. कुछ भी तैयार नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet USDT yang dilaporkan jaringan bukan milik akun ini. Tidak ada yang disiapkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークから返された USDT ウォレットはこのアカウントのものではありません。何も作成されていません。"
