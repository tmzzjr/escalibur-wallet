    },
    "Um depurador está preso ao app e pode ler a memória dele." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A debugger is attached to the app and can read its memory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un depurador conectado a la app y puede leer su memoria."
