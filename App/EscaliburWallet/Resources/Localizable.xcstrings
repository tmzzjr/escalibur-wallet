    "A conta é o código de 64 caracteres, não um nome .near." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account is the 64-character code, not a .near name."
          }
        }
      }
    },
    "A cotação da %@ falharia na rede agora. Escolhemos a próxima melhor, a da %@, que passou na simulação." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The %@ quote would fail on the network right now. We picked the next best, from %@, which passed the simulation."
          }
        }
      }
    },
    "A cotação está %@ pior que o preço de referência do mercado. Troca bloqueada." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض السعر أسوأ بنسبة %@ من سعر السوق المرجعي. تم حظر المبادلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Angebot ist %@ schlechter als der Referenzpreis am Markt. Tausch blockiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quote is %@ worse than the market reference price. Swap blocked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cotización es %@ peor que el precio de referencia del mercado. Intercambio bloqueado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cotation est %@ moins favorable que le prix de référence du marché. Échange bloqué."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोट मार्केट की रेफ़रेंस कीमत से %@ खराब है. स्वैप ब्लॉक किया गया."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuotasi %@ lebih buruk dari harga referensi pasar. Penukaran diblokir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見積もりが市場の参考価格より %@ 不利です。スワップはブロックされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "견적이 시장 기준 가격보다 %@ 불리합니다. 스왑이 차단되었습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teklif, piyasa referans fiyatından %@ daha kötü. Takas engellendi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo giá kém hơn giá tham chiếu thị trường %@. Đã chặn hoán đổi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "报价比市场参考价差 %@。兑换已阻止。"
          }
        }
      }
    },
