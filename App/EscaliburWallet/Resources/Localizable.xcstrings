    "Média. Um grupo com placas de vídeo levaria %@, e um governo, %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسطة. تحتاج مجموعة تملك بطاقات رسوميات إلى %@، وحكومة إلى %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittel. Eine Gruppe mit Grafikkarten bräuchte %@, eine Regierung %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medium. A group with graphics cards would take %@, and a government, %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media. Un grupo con tarjetas gráficas tardaría %@, y un gobierno, %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyenne. Un groupe équipé de cartes graphiques mettrait %@, et un gouvernement, %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मध्यम. ग्राफ़िक्स कार्ड वाले किसी ग्रुप को %@ लगेंगे, और किसी सरकार को %@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sedang. Sekelompok orang dengan kartu grafis butuh %@, dan pemerintah, %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "普通。グラフィックカードを持つグループなら %@、政府なら %@ かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보통. 그래픽 카드를 가진 그룹은 %@, 정부는 %@ 걸립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Média. Um grupo com placas de vídeo levaria %1$@, e um governo, %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orta. Ekran kartlı bir grubun süresi %@, bir hükümetinki %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trung bình. Một nhóm có card đồ họa cần %@, và một chính phủ cần %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中等。拥有显卡集群的团伙需要 %@，政府需要 %@。"
