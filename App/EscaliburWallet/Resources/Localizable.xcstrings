        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette offre n’est plus ouverte : elle a déjà été exécutée ou annulée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऑफ़र अब खुला नहीं है: यह पहले ही एक्ज़ीक्यूट हो गया या रद्द कर दिया गया."
