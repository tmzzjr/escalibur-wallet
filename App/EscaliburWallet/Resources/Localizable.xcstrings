        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío preparado no coincide con el destino o el comentario solicitados. No se firmó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi préparé ne correspond pas à la destination ou au commentaire demandés. Rien n’a été signé."
          }
        }
      }
    },
    "O envio montado não confere com o destino ou o memo pedidos. Nada foi assinado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
