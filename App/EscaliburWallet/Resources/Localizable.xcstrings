    "Toque duas vezes para virar a carta." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مرتين لقلب البطاقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um die Karte umzudrehen."
          }
        },
