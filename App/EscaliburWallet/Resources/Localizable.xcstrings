    "Na Stellar todo ativo tem 7 casas decimais, pela própria rede." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على Stellar، لكل أصل 7 خانات عشرية، تحددها الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Stellar hat jedes Asset 7 Dezimalstellen, vom Netzwerk festgelegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Stellar, every asset has 7 decimals, set by the network itself."
          }
