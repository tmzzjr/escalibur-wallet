    "Esta carteira só acompanha um endereço. A passphrase precisa da senha de 12 ou 24 palavras." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المحفظة تتابع عنوانًا فقط. تحتاج passphrase إلى عبارة استرداد من 12 أو 24 كلمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wallet verfolgt nur eine Adresse. Eine Passphrase braucht eine Wiederherstellungsphrase mit 12 oder 24 Wörtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet only tracks an address. A passphrase needs a 12 or 24-word recovery phrase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta billetera solo sigue una dirección. La passphrase necesita una frase de recuperación de 12 o 24 palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce portefeuille ne fait que suivre une adresse. Une passphrase nécessite une phrase de récupération de 12 ou 24 mots."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वॉलेट सिर्फ़ एक पता ट्रैक करता है. पासफ़्रेज़ के लिए 12 या 24 शब्दों का रिकवरी फ़्रेज़ चाहिए."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet ini hanya memantau sebuah alamat. Passphrase memerlukan frasa pemulihan 12 atau 24 kata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウォレットはアドレスの閲覧のみです。パスフレーズには 12 または 24 単語のリカバリーフレーズが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지갑은 주소만 확인합니다. 패스프레이즈는 12개 또는 24개 단어의 복구 구문이 있어야 합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cüzdan yalnızca bir adresi takip ediyor. Passphrase için 12 veya 24 kelimelik bir kurtarma ifadesi gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví này chỉ theo dõi một địa chỉ. Passphrase cần cụm từ khôi phục 12 hoặc 24 từ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此钱包只跟踪一个地址。passphrase 需要 12 或 24 个单词的助记词。"
          }
        }
      }
    },
    "Esta carteira só acompanha: para cancelar, abra a carteira que assina." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المحفظة للمراقبة فقط: للإلغاء، افتح المحفظة التي توقّع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wallet ist nur zum Ansehen: Um zu stornieren, öffne das Wallet, das signiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet is watch-only: to cancel, open the wallet that signs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta billetera es de solo lectura: para cancelar, abre la billetera que firma."
