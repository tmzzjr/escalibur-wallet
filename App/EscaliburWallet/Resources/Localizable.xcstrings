    "Diferença de maiúscula, acento ou espaço já abre outra carteira. Segure o dedo num campo para conferir as duas." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي اختلاف في حرف كبير أو علامة أو مسافة يفتح محفظة أخرى. المس مطولًا أحد الحقلين للمقارنة بينهما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schon ein anderer Groß- oder Kleinbuchstabe, Akzent oder Leerzeichen öffnet ein anderes Wallet. Halte ein Feld gedrückt, um beide zu vergleichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A different capital letter, accent or space opens a different wallet. Touch and hold a field to compare the two."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mayúscula, una tilde o un espacio distinto ya abre otra billetera. Mantén pulsado un campo para comparar las dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une majuscule, un accent ou un espace différent ouvre un autre portefeuille. Maintenez le doigt sur un champ pour comparer les deux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े अक्षर, एक्सेंट या स्पेस का ज़रा सा भी फ़र्क एक अलग वॉलेट खोलता है. दोनों की तुलना करने के लिए किसी फ़ील्ड को दबाकर रखें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbedaan huruf kapital, aksen, atau spasi saja sudah membuka dompet lain. Sentuh dan tahan sebuah kolom untuk membandingkan keduanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大文字・小文字、アクセント、スペースが 1 つ違うだけで、別のウォレットが開きます。フィールドを長押しすると、2 つを比較できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대소문자, 악센트, 띄어쓰기 하나만 달라도 다른 지갑이 열립니다. 필드를 길게 눌러 두 입력을 비교하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı bir büyük harf, aksan veya boşluk başka bir cüzdan açar. İkisini karşılaştırmak için bir alana basılı tut."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần khác một chữ hoa, dấu hay khoảng trắng là đã mở ra một ví khác. Chạm và giữ một ô để so sánh hai lần nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小写、重音符号或空格的差异都会打开另一个钱包。按住输入框可对比两次输入。"
          }
        }
      }
    },
