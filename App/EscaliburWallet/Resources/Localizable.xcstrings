        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mạng đã từ chối giao dịch. Hãy kiểm tra mục Hoạt động và số dư trước khi gửi lại."
          }
        },
        "zh-Hans" : {
