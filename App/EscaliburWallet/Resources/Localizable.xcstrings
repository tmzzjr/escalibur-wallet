        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko no respondió ahora. Solo aparecen las monedas verificadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko n’a pas répondu pour le moment. Seules les monnaies vérifiées sont affichées."
          }
        }
      }
    },
    "O CoinGecko pediu uma pausa. Esperando liberar para ler as redes de %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko asked for a pause. Waiting to be allowed to read the networks for %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko pidió una pausa. Esperando que se libere para leer las redes de %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko a demandé une pause. En attente de l’autorisation de lire les réseaux de %@."
          }
        }
      }
    },
    "O CoinGecko pediu uma pausa. Tentando de novo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko asked for a pause. Trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
