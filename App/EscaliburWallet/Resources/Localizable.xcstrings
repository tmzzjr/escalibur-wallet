          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜잭션이 네트워크에 들어갔지만 전송은 이루어지지 않았습니다. 금액은 계정으로 돌아오며, 네트워크 수수료만 청구되었습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
