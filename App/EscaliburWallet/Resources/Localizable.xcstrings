                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "على XRP Ledger، ليس للرموز المميزة خانات عشرية ثابتة. تعرض المحفظة حتى %lld خانة عشرية."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "على XRP Ledger، ليس للرموز المميزة خانات عشرية ثابتة. تعرض المحفظة حتى %lld خانة عشرية."
                }
              },
              "other" : {
                "stringUnit" : {
