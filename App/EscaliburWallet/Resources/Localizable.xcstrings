    "O %@ não confirmou. Ele continua desligado; você pode ligar depois nos Ajustes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ didn't confirm. It stays off; you can turn it on later in Settings."
