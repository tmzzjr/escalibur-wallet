    "Este pedido de pagamento é de uma rede que a Escalibur não envia. Confira com quem pediu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب الدفع هذا لشبكة لا يرسل عليها Escalibur. تحقق مع من طلبه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zahlungsanforderung ist für ein Netzwerk, auf dem Escalibur nicht sendet. Frag beim Absender der Anforderung nach."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This payment request is for a network Escalibur doesn't send on. Check with whoever requested it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta solicitud de pago es de una red en la que Escalibur no envía. Confírmalo con quien te lo pidió."
