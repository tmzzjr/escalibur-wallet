    "Configure um código em Ajustes do iPhone. Sem ele, o iOS não protege as chaves da carteira." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عيّن رمز دخول في إعدادات iPhone. بدونه، لا يحمي iOS مفاتيح المحفظة."
          }
        },
        "de" : {
          "stringUnit" : {
