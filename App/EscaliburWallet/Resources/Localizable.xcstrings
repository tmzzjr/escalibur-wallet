    "Chegou uma quantia mínima sem você pedir. Serve para o endereço de quem mandou aparecer no seu histórico." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل مبلغ زهيد دون أن تطلبه. الغرض منه أن يظهر عنوان المُرسِل في سجلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kleinstbetrag kam ungefragt an. Er soll die Adresse des Absenders in deinem Verlauf erscheinen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tiny amount arrived without you asking. It's meant to make the sender's address show up in your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegó una cantidad mínima sin que la pidieras. Sirve para que la dirección de quien la envió aparezca en tu historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un montant infime est arrivé sans que vous le demandiez. Il sert à faire apparaître l’adresse de l’expéditeur dans votre historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके मांगे बिना बहुत छोटी राशि आई है. इसका मकसद भेजने वाले का पता आपकी हिस्ट्री में दिखाना है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah sangat kecil masuk tanpa Anda minta. Tujuannya agar alamat pengirim muncul di riwayat Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依頼していない少額が届きました。送り主のアドレスを履歴に表示させるためのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하지 않은 아주 적은 금액이 들어왔습니다. 보낸 사람의 주소가 내 거래 내역에 나타나게 하려는 것입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstemediğin halde çok küçük bir miktar geldi. Amacı, gönderenin adresinin geçmişinde görünmesi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một khoản rất nhỏ đã đến mà bạn không yêu cầu. Mục đích là để địa chỉ người gửi xuất hiện trong lịch sử của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一笔极小金额在你没有请求的情况下转入。目的是让发送方的地址出现在你的历史记录中。"
          }
        }
      }
    },
