            "value" : "ट्रांज़ैक्शन %@ पर विफल रहा. सिर्फ़ नेटवर्क शुल्क लिया गया."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaksi gagal di %@. Hanya biaya jaringan yang dikenakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ でトランザクションが失敗しました。ネットワーク手数料のみ請求されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 네트워크에서 트랜잭션이 실패했습니다. 네트워크 수수료만 청구되었습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem %@ ağında başarısız oldu. Yalnızca ağ ücreti alındı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch thất bại trên %@. Chỉ phí mạng bị tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易在 %@ 上失败。仅收取了网络费。"
          }
        }
      }
    },
