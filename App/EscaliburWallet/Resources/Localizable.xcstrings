          }
        }
      }
    },
    "O preço desta cotação está longe demais do preço médio de mercado. Troca bloqueada." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This quote's price is too far from the average market price. Swap blocked."
