        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trình lập chỉ mục công khai của %@ hiện đang từ chối yêu cầu từ ứng dụng. Lịch sử của mạng này có trong trình khám phá khối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
