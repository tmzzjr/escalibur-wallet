    "%@ existe na %@, que está desligada nesta carteira. Ligue a rede em Ajustes para receber." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ موجود على %@، وهي شبكة معطّلة في هذه المحفظة. فعّل الشبكة في الإعدادات للاستلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gibt es auf %@, das in diesem Wallet ausgeschaltet ist. Schalte das Netzwerk in den Einstellungen ein, um zu empfangen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exists on %@, which is turned off in this wallet. Turn on the network in Settings to receive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existe en %@, que está desactivada en esta billetera. Activa la red en Ajustes para recibir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existe sur %@, qui est désactivé dans ce portefeuille. Activez le réseau dans Réglages pour recevoir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@ पर है, जो इस वॉलेट में बंद है. प्राप्त करने के लिए सेटिंग्स में नेटवर्क चालू करें."
