    "Endereço copiado. Depois de colar, confira o endereço inteiro, inclusive o meio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نسخ العنوان. بعد اللصق، تحقق من العنوان كاملًا، بما في ذلك وسطه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse kopiert. Prüfe nach dem Einfügen die ganze Adresse, auch die Mitte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Address copied. After pasting, check the whole address, including the middle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dirección copiada. Después de pegarla, comprueba la dirección completa, incluido el medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse copiée. Après l’avoir collée, vérifiez l’adresse en entier, y compris le milieu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पता कॉपी हुआ. पेस्ट करने के बाद पूरा पता जांचें, बीच का हिस्सा भी."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat disalin. Setelah menempel, periksa seluruh alamat, termasuk bagian tengahnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスをコピーしました。貼り付けた後、中央部分も含めてアドレス全体を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소를 복사했습니다. 붙여 넣은 후 가운데를 포함해 주소 전체를 확인하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres kopyalandı. Yapıştırdıktan sonra adresin tamamını, ortası dahil kontrol et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã sao chép địa chỉ. Sau khi dán, hãy kiểm tra toàn bộ địa chỉ, kể cả phần giữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地址已复制。粘贴后，请核对完整地址，包括中间部分。"
          }
        }
      }
    },
