    "A transação foi montada para outra rede. Nada foi transmitido." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تجهيز المعاملة لشبكة أخرى. لم يتم بث أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Transaktion wurde für ein anderes Netzwerk vorbereitet. Nichts wurde übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transaction was prepared for another network. Nothing was broadcast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transacción se preparó para otra red. No se transmitió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transaction a été préparée pour un autre réseau. Rien n’a été diffusé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांज़ैक्शन किसी दूसरे नेटवर्क के लिए तैयार किया गया था. कुछ भी ब्रॉडकास्ट नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaksi disiapkan untuk jaringan lain. Tidak ada yang disiarkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランザクションは別のネットワーク向けに作成されました。何もネットワークに送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜잭션이 다른 네트워크용으로 준비되었습니다. 네트워크로 전송된 것이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem başka bir ağ için hazırlanmış. Hiçbir şey yayınlanmadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch được tạo cho một mạng khác. Chưa có gì được phát lên mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该交易是为另一个网络创建的。未广播任何内容。"
          }
        }
      }
    },
    "A transação montada não passou na conferência da carteira. Nada foi assinado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعاملة المجهّزة لم تجتز تحقق المحفظة. لم يتم توقيع أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vorbereitete Transaktion hat die Prüfung des Wallets nicht bestanden. Nichts wurde signiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prepared transaction failed the wallet's check. Nothing was signed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transacción preparada no pasó la comprobación de la billetera. No se firmó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transaction préparée n’a pas passé le contrôle du portefeuille. Rien n’a été signé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तैयार किया गया ट्रांज़ैक्शन वॉलेट की जांच में पास नहीं हुआ. कुछ भी साइन नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaksi yang disiapkan tidak lolos pemeriksaan dompet. Tidak ada yang ditandatangani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作成したトランザクションがウォレットのチェックを通過しませんでした。何も署名されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "준비된 트랜잭션이 지갑의 확인을 통과하지 못했습니다. 서명된 것이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazırlanan işlem cüzdanın kontrolünden geçmedi. Hiçbir şey imzalanmadı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch đã tạo không vượt qua bước kiểm tra của ví. Chưa có gì được ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建的交易未通过钱包的核对。未签署任何内容。"
          }
        }
      }
    },
