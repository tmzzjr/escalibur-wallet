        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、使われなかった分は請求されません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, 사용하지 않은 만큼은 청구되지 않음"
