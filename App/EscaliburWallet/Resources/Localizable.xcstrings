        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक प्रोवाइडर ने किसी दूसरे नेटवर्क से जवाब दिया. सुरक्षा के लिए, कुछ भी तैयार नहीं हुआ. थोड़ी देर में फिर से कोशिश करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebuah penyedia merespons dari jaringan lain. Demi keamanan, tidak ada yang disiapkan. Coba lagi sebentar lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーが別のネットワークから応答しました。安全のため、何も作成されていません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공업체가 다른 네트워크에서 응답했습니다. 안전을 위해 아무것도 준비하지 않았습니다. 잠시 후 다시 시도하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
