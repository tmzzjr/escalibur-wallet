    "%@ A conta tem %@, menos que isso. Envie TON para esta conta antes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ رصيد الحساب %@، وهو أقل من ذلك. أرسل TON إلى هذا الحساب أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Das Konto hat %@, also weniger. Sende zuerst TON an dieses Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The account has %@, less than that. Send TON to this account first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La cuenta tiene %@, menos que eso. Envía TON a esta cuenta primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Le compte a %@, c’est moins que cela. Envoyez d’abord des TON sur ce compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ खाते में %@ है, जो इससे कम है. पहले इस खाते में TON भेजें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Akun ini memiliki %@, kurang dari itu. Kirim TON ke akun ini terlebih dahulu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ このアカウントの残高は %@ で、不足しています。先にこのアカウントに TON を送金してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 계정의 잔액(%@)이 부족합니다. 먼저 이 계정으로 TON을 보내세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ A conta tem %2$@, menos que isso. Envie TON para esta conta antes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hesapta %@ var, bu tutardan az. Önce bu hesaba TON gönder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tài khoản có %@, ít hơn mức đó. Hãy gửi TON vào tài khoản này trước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@账户只有 %@，少于所需。请先向此账户转入 TON。"
          }
        }
      }
    },
    "%@ A conta tem %@, menos que isso. Envie TRX para esta conta antes: a Escalibur não paga essa taxa por você." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ رصيد الحساب %@، وهو أقل من ذلك. أرسل TRX إلى هذا الحساب أولًا: Escalibur لا تدفع هذه الرسوم عنك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Das Konto hat %@, also weniger. Sende zuerst TRX an dieses Konto: Escalibur zahlt diese Gebühr nicht für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The account has %@, less than that. Send TRX to this account first: Escalibur doesn't pay this fee for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La cuenta tiene %@, menos que eso. Envía TRX a esta cuenta primero: Escalibur no paga esta comisión por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Le compte a %@, c’est moins que cela. Envoyez d’abord des TRX sur ce compte : Escalibur ne paie pas ces frais à votre place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ खाते में %@ है, जो इससे कम है. पहले इस खाते में TRX भेजें: Escalibur आपके लिए यह शुल्क नहीं चुकाता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Akun ini memiliki %@, kurang dari itu. Kirim TRX ke akun ini terlebih dahulu: Escalibur tidak membayar biaya ini untuk Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ このアカウントの残高は %@ で、不足しています。先にこのアカウントに TRX を送金してください。この手数料を Escalibur が代わりに支払うことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이 계정의 잔액(%@)이 부족합니다. 먼저 이 계정으로 TRX를 보내세요. Escalibur는 이 수수료를 대신 내 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ A conta tem %2$@, menos que isso. Envie TRX para esta conta antes: a Escalibur não paga essa taxa por você."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Hesapta %@ var, bu tutardan az. Önce bu hesaba TRX gönder: Escalibur bu ücreti senin yerine ödemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Tài khoản có %@, ít hơn mức đó. Hãy gửi TRX vào tài khoản này trước: Escalibur không trả khoản phí này thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@账户只有 %@，少于所需。请先向此账户转入 TRX：Escalibur 不会替你支付这笔费用。"
          }
        }
      }
    },
