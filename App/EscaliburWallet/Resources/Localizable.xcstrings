    "Na %@ a oferta não tem prazo: fica até executar ou você cancelar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على %@، ليس للعرض موعد انتهاء: يبقى حتى يُنفَّذ أو تلغيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf %@ hat das Angebot keine Frist: Es bleibt, bis es ausgeführt wird oder du es stornierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On %@, the offer has no deadline: it stays until it executes or you cancel it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En %@ la oferta no tiene plazo: queda hasta que se ejecute o la canceles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur %@, l’offre n’a pas d’échéance : elle reste active jusqu’à ce qu’elle s’exécute ou que vous l’annuliez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर ऑफ़र की कोई समय-सीमा नहीं होती: यह एक्ज़ीक्यूट होने या आपके रद्द करने तक रहता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di %@, penawaran tidak memiliki batas waktu: tetap ada hingga tereksekusi atau Anda batalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ではオファーに期限がなく、約定するかキャンセルするまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 네트워크에서는 오퍼에 기한이 없습니다. 체결되거나 직접 취소할 때까지 남아 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ağında teklifin süre sınırı yok: gerçekleşene veya sen iptal edene kadar kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên %@, lệnh không có thời hạn: lệnh vẫn còn cho đến khi khớp hoặc bạn hủy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ 上，挂单没有期限：会一直保留，直到成交或你取消。"
          }
        }
      }
    },
