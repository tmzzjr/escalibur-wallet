        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas confirmé. Il reste désactivé ; vous pourrez l’activer plus tard dans Réglages."
          }
        }
      }
    },
    "O %@ sem internet não está disponível neste iPhone agora. Costuma ficar disponível quando você adiciona um teclado em %@ nos Ajustes do iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
