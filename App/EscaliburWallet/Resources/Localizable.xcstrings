        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Primer envío a esta dirección? Enviar una cantidad pequeña antes es la forma más barata de comprobarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premier envoi vers cette adresse ? Envoyer d’abord un petit montant est le moyen le moins cher de vérifier."
