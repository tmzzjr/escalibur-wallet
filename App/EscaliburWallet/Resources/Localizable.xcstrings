    },
    "%@ ficam presos enquanto a oferta estiver aberta" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stays locked while the offer is open"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quedan bloqueados mientras la oferta esté abierta"
