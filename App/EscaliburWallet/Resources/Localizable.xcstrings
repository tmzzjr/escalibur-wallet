    "Esta senha cai em %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن كسر كلمة المرور هذه خلال %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
