    },
    "Seis palavras sorteadas neste iPhone. Anote em outro lugar, longe do papel da senha da carteira." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six words randomly picked on this iPhone. Write them down somewhere else, away from the paper with the recovery phrase."
          }
