    "Super Security: abrir o app e todo envio, troca e ordem pedem o PIN e o %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوضع المعزَّز: فتح التطبيق وكل تحويل ومبادلة وأمر يتطلب PIN و%@."
          }
        },
        "de" : {
          "stringUnit" : {
