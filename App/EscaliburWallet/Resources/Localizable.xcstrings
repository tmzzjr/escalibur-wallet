          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोट के बाद से प्राइस इम्पैक्ट बढ़ गया है. कोट रीफ़्रेश करें और फिर से पुष्टि करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dampak harga naik sejak kuotasi. Perbarui kuotasi dan konfirmasi lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
