        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称中包含不可见字符或会反转文本的字符。"
          }
        }
      }
    },
    "O nome usa isca: resgate, prêmio, bônus, airdrop, visite." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم الاسم طُعمًا: مطالبة، مكافأة، بونص، airdrop، زيارة."
          }
        },
        "de" : {
