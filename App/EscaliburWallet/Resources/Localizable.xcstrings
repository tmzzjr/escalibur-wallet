    "Suporte, gerente de exchange, recuperação de conta: quem pede a senha da carteira está tentando roubar o saldo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدعم، مدير منصة التداول، استرداد الحساب: كل من يطلب عبارة الاسترداد يحاول سرقة أموالك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support, Börsenmanager, Kontowiederherstellung: Wer nach der Wiederherstellungsphrase fragt, will dein Guthaben stehlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support, exchange managers, account recovery: anyone who asks for the recovery phrase is trying to steal your funds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soporte, gerente de exchange, recuperación de cuenta: quien pide la frase de recuperación está intentando robar tu saldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support, gestionnaire de plateforme d’échange, récupération de compte : quiconque demande la phrase de récupération essaie de voler vos fonds."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सपोर्ट, एक्सचेंज मैनेजर, अकाउंट रिकवरी: जो भी रिकवरी फ़्रेज़ मांगता है, वह आपका बैलेंस चुराने की कोशिश कर रहा है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukungan, manajer exchange, pemulihan akun: siapa pun yang meminta frasa pemulihan sedang mencoba mencuri saldo Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポート、取引所の担当者、アカウント復旧：リカバリーフレーズを求める人は、資産を盗もうとしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고객 지원, 거래소 매니저, 계정 복구: 복구 구문을 요구하는 사람은 자금을 훔치려는 것입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destek ekibi, borsa yöneticisi, hesap kurtarma: kurtarma ifadeni isteyen herkes bakiyeni çalmaya çalışıyordur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ phận hỗ trợ, quản lý sàn giao dịch, khôi phục tài khoản: ai hỏi xin cụm từ khôi phục là đang tìm cách đánh cắp tiền của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "客服、交易所经理、账户恢复：任何索要助记词的人都在试图盗取你的资产。"
          }
        }
      }
    },
    "Suporte: %@ · Escalibur %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
