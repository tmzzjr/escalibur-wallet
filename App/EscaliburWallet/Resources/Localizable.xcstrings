      }
    },
    "O arquivo .esclbr e a senha do envelope." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف .esclbr وكلمة مرور المغلف."
          }
        },
        "de" : {
