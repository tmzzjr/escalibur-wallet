    "Chegaram sem você pedir e têm cara de golpe. Não abra os sites dos nomes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت دون أن تطلبها وتبدو احتيالًا. لا تفتح المواقع الواردة في أسمائها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese kamen ungefragt und sehen nach Betrug aus. Öffne nicht die Websites aus ihren Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These arrived without you asking and look like a scam. Don't open the websites in their names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegaron sin que los pidieras y parecen una estafa. No abras los sitios web de sus nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils sont arrivés sans que vous les demandiez et ressemblent à une arnaque. N’ouvrez pas les sites mentionnés dans leurs noms."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये आपके मांगे बिना आए हैं और स्कैम जैसे दिखते हैं. इनके नामों में दी गई वेबसाइट न खोलें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token ini masuk tanpa Anda minta dan terlihat seperti penipuan. Jangan buka situs yang ada di namanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依頼していないのに届いたもので、詐欺の疑いがあります。名前に含まれるサイトは開かないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청하지 않았는데 들어온 것으로 사기로 보입니다. 이름에 있는 사이트를 열지 마세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstemeden geldiler ve dolandırıcılık gibi görünüyorlar. Adlarındaki siteleri açma."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các token này đến mà bạn không yêu cầu và có dấu hiệu lừa đảo. Đừng mở các trang web có trong tên của chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些代币是在你没有请求的情况下转入的，看起来像诈骗。请勿打开名称中的网站。"
          }
        }
      }
    },
