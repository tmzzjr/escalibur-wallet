    "Falta SOL para a taxa da rede e para criar a conta de %@ do destino. Deposite SOL nesta carteira para enviar %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد SOL كافٍ لرسوم الشبكة ولإنشاء حساب %@ للمستلم. أودِع SOL في هذه المحفظة لإرسال %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug SOL für die Netzwerkgebühr und das Erstellen des %@-Kontos beim Empfänger. Zahle SOL in dieses Wallet ein, um %@ zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough SOL for the network fee and to create the recipient's %@ account. Deposit SOL into this wallet to send %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta SOL para la comisión de red y para crear la cuenta de %@ del destinatario. Deposita SOL en esta billetera para enviar %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de SOL pour les frais de réseau et la création du compte %@ du destinataire. Déposez des SOL sur ce portefeuille pour envoyer %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क और प्राप्तकर्ता का %@ खाता बनाने के लिए SOL काफ़ी नहीं है. %@ भेजने के लिए इस वॉलेट में SOL डिपॉज़िट करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SOL tidak cukup untuk biaya jaringan dan untuk membuat akun %@ penerima. Setorkan SOL ke dompet ini untuk mengirim %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク手数料と宛先の %@ アカウントの作成に必要な SOL が足りません。%@ を送信するには、このウォレットに SOL を入金してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 수수료와 받는 사람의 %@ 계정 생성에 필요한 SOL이 부족합니다. %@ 토큰을 보내려면 이 지갑에 SOL을 입금하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Falta SOL para a taxa da rede e para criar a conta de %1$@ do destino. Deposite SOL nesta carteira para enviar %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ ücreti ve alıcının %@ hesabını oluşturmak için SOL yetersiz. %@ göndermek için bu cüzdana SOL yatır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ SOL để trả phí mạng và tạo tài khoản %@ cho người nhận. Hãy nạp SOL vào ví này để gửi %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SOL 不足以支付网络费和为收款方创建 %@ 账户的费用。请向此钱包存入 SOL 后再发送 %@。"
          }
        }
      }
    },
    "Falta SOL para a taxa da rede. Deposite SOL nesta carteira para enviar %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد SOL كافٍ لرسوم الشبكة. أودِع SOL في هذه المحفظة لإرسال %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug SOL für die Netzwerkgebühr. Zahle SOL in dieses Wallet ein, um %@ zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough SOL for the network fee. Deposit SOL into this wallet to send %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta SOL para la comisión de red. Deposita SOL en esta billetera para enviar %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de SOL pour les frais de réseau. Déposez des SOL sur ce portefeuille pour envoyer %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
