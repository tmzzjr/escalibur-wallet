        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans elle, les mots ci-dessus ouvrent un portefeuille différent et vide."
          }
        }
      }
    },
    "Sem entrega em %u horas, o depósito volta para esta conta na %@, algumas horas depois do prazo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If not delivered within %u hours, the deposit returns to this account on %@, a few hours after the deadline"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no se entrega en %u horas, el depósito vuelve a esta cuenta en %@, algunas horas después del plazo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans livraison sous %u heures, le dépôt revient sur ce compte sur %@, quelques heures après l’échéance"
