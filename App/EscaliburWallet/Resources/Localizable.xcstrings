          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This password could be cracked in %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta contraseña se podría descifrar en %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe peut être cassé en %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पासवर्ड %@ में क्रैक हो सकता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi ini bisa dibobol dalam %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスワードは %@ で破られる可能性があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비밀번호는 %@ 만에 뚫릴 수 있습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu şifrenin kırılma süresi: %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu này có thể bị bẻ khóa trong %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密码可在 %@ 内被破解"
          }
        }
      }
    },
    "Esta senha usa palavras da própria carteira. Quem achar o papel abre o envelope. Escolha outra." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمة المرور هذه تستخدم كلمات من المحفظة نفسها. من يجد الورقة يستطيع فتح المغلف. اختر كلمة مرور أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort nutzt Wörter aus dem Wallet selbst. Wer das Papier findet, öffnet den Umschlag. Wähle ein anderes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This password uses words from the wallet itself. Anyone who finds the paper can open the envelope. Choose another."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta contraseña usa palabras de la propia billetera. Quien encuentre el papel abre el sobre. Elige otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe utilise des mots du portefeuille lui-même. Quiconque trouve le papier peut ouvrir l’enveloppe. Choisissez-en un autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पासवर्ड वॉलेट के अपने शब्द इस्तेमाल करता है. जिसे भी कागज़ मिलेगा, वह लिफ़ाफ़ा खोल सकता है. कोई दूसरा चुनें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi ini memakai kata-kata dari dompet itu sendiri. Siapa pun yang menemukan kertasnya bisa membuka amplop. Pilih yang lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスワードにはウォレット自体の単語が含まれています。紙を見つけた人がエンベロープを開けてしまいます。別のパスワードを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비밀번호에는 지갑 자체의 단어가 들어 있습니다. 종이를 찾은 사람이 봉투를 열 수 있습니다. 다른 비밀번호를 고르세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu şifre cüzdanın kendi kelimelerini kullanıyor. Kâğıdı bulan zarfı açar. Başka bir şifre seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu này dùng các từ của chính ví. Ai tìm thấy tờ giấy cũng mở được phong bì. Hãy chọn mật khẩu khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密码使用了钱包本身的单词。任何找到那张纸的人都能打开信封。请换一个。"
          }
        }
      }
    },
    "Esta troca abre a linha de %@: %@ presos enquanto a conta aceitar %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه المبادلة تفتح خط الثقة لـ %@: يُحجز %@ ما دام الحساب يقبل %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tausch öffnet die %@-Trustline: %@ gesperrt, solange das Konto %@ akzeptiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This swap opens the %@ trustline: %@ locked while the account accepts %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este intercambio abre la línea de confianza de %@: %@ bloqueados mientras la cuenta acepte %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet échange ouvre la ligne de confiance %@ : il bloque %@ tant que le compte accepte %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्वैप %1$@ की ट्रस्टलाइन खोलता है: जब तक खाता %3$@ स्वीकार करता है, %2$@ लॉक रहता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penukaran ini membuka trustline %@: %@ terkunci selama akun bisa menerima %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスワップで %1$@ のトラストラインが開設されます：アカウントが %3$@ を受け入れている間、%2$@ がロックされます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스왑으로 %1$@ 트러스트라인이 열림: 계정이 %3$@ 토큰을 허용하는 동안 %2$@ 묶임"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Esta troca abre a linha de %1$@: %2$@ presos enquanto a conta aceitar %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu takas %1$@ güven hattını açar: hesap %3$@ kabul ettiği sürece %2$@ kilitli kalır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần hoán đổi này mở trustline %@: %@ bị khóa chừng nào tài khoản còn chấp nhận %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此兑换会开通 %1$@ 信任线：账户接受 %3$@ 期间，将锁定 %2$@"
          }
        }
      }
    },
    "Esta troca perderia %@%% para o impacto no preço. Divida em ordens menores ou use uma ordem limite." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستخسر هذه المبادلة %@%% بسبب تأثير السعر. قسّمها إلى أوامر أصغر أو استخدم أمرًا محدد السعر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tausch würde %@ %% durch Preiswirkung verlieren. Teile ihn in kleinere Orders auf oder nutze eine Limit-Order."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This swap would lose %@%% to price impact. Split it into smaller orders or use a limit order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este intercambio perdería un %@%% por el impacto en el precio. Divídelo en órdenes más pequeñas o usa una orden límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet échange perdrait %@ %% à cause de l’impact sur le prix. Divisez-le en ordres plus petits ou utilisez un ordre limite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्वैप प्राइस इम्पैक्ट में %@%% खो देगा. इसे छोटे ऑर्डर में बांटें या लिमिट ऑर्डर इस्तेमाल करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penukaran ini akan kehilangan %@%% karena dampak harga. Bagi menjadi order yang lebih kecil atau gunakan order limit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスワップでは価格への影響で %@%% を失います。小さな注文に分けるか、指値注文を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스왑은 가격 영향으로 %@%%를 잃게 됩니다. 더 작은 주문으로 나누거나 지정가 주문을 사용하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu takas fiyat etkisi nedeniyle %%%@ kaybeder. Daha küçük emirlere böl veya limit emri kullan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần hoán đổi này sẽ mất %@%% do tác động giá. Hãy chia thành các lệnh nhỏ hơn hoặc dùng lệnh giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此兑换会因价格影响损失 %@%%。请拆分为更小的订单或使用限价单。"
          }
        }
      }
    },
    "Esta troca perderia demais para o impacto no preço. Diminua o valor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستخسر هذه المبادلة الكثير بسبب تأثير السعر. قلّل المبلغ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tausch würde durch Preiswirkung zu viel verlieren. Verringere den Betrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This swap would lose too much to price impact. Lower the amount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este intercambio perdería demasiado por el impacto en el precio. Reduce la cantidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet échange perdrait trop à cause de l’impact sur le prix. Réduisez le montant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्वैप प्राइस इम्पैक्ट में बहुत ज़्यादा खो देगा. राशि कम करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penukaran ini akan kehilangan terlalu banyak karena dampak harga. Kurangi jumlahnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスワップでは価格への影響による損失が大きすぎます。金額を減らしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스왑은 가격 영향으로 잃는 금액이 너무 큽니다. 금액을 줄이세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu takas fiyat etkisi nedeniyle çok fazla kaybeder. Tutarı azalt."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần hoán đổi này sẽ mất quá nhiều do tác động giá. Hãy giảm số tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此兑换因价格影响损失过多。请降低金额。"
          }
        }
      }
    },
    "Esta troca perderia demais para o impacto no preço. Tente um valor menor ou uma ordem limite." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستخسر هذه المبادلة الكثير بسبب تأثير السعر. جرّب مبلغًا أصغر أو أمرًا محدد السعر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tausch würde durch Preiswirkung zu viel verlieren. Versuche einen kleineren Betrag oder eine Limit-Order."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This swap would lose too much to price impact. Try a smaller amount or a limit order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este intercambio perdería demasiado por el impacto en el precio. Prueba con una cantidad menor o una orden límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet échange perdrait trop à cause de l’impact sur le prix. Essayez un montant plus faible ou un ordre limite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह स्वैप प्राइस इम्पैक्ट में बहुत ज़्यादा खो देगा. छोटी राशि या लिमिट ऑर्डर आज़माएं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penukaran ini akan kehilangan terlalu banyak karena dampak harga. Coba jumlah yang lebih kecil atau order limit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスワップでは価格への影響による損失が大きすぎます。より少ない金額か、指値注文をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스왑은 가격 영향으로 잃는 금액이 너무 큽니다. 더 적은 금액이나 지정가 주문을 시도하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu takas fiyat etkisi nedeniyle çok fazla kaybeder. Daha küçük bir tutar veya limit emri dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần hoán đổi này sẽ mất quá nhiều do tác động giá. Hãy thử số tiền nhỏ hơn hoặc lệnh giới hạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此兑换因价格影响损失过多。请尝试更小的金额或使用限价单。"
          }
        }
      }
    },
