          }
        }
      }
    },
    "O CoinGecko lista %@ também nestas redes, com o contrato de cada uma. A Escalibur ainda não conferiu esses contratos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
