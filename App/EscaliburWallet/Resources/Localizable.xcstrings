    "%@ da Binance (Binance-Peg): vale enquanto a Binance mantiver o lastro e o resgate" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ from Binance (Binance-Peg): holds its value as long as Binance maintains the backing and redemption"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de Binance (Binance-Peg): conserva su valor mientras Binance mantenga el respaldo y el canje"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de Binance (Binance-Peg) : garde sa valeur tant que Binance maintient la couverture et le rachat"
          }
        }
      }
    },
    "%@ da ordem chegou a sair antes de vencer. Refazer vende o que falta, no mesmo preço." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ of the order filled before it expired. Renewing sells what's left at the same price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecutó %@ de la orden antes de vencer. Renovarla vende lo que falta, al mismo precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de l’ordre a été exécuté avant l’expiration. Le renouveler vend le reste, au même prix."
          }
        }
      }
    },
