        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkürzen gilt sofort. Verlängern verlangt die PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortening takes effect right away. Lengthening requires your PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acortar se aplica al instante. Alargar pide el PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcir prend effet immédiatement. Allonger demande votre PIN."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटा करना तुरंत लागू होता है. लंबा करने के लिए PIN चाहिए."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mempersingkat langsung berlaku. Memperpanjang memerlukan PIN."
