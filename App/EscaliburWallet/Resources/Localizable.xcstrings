            "state" : "translated",
            "value" : "Una alerta solo se envía cuando CoinGecko y CoinPaprika coinciden en el precio."
          }
        }
      }
    },
    "Um caractere deste endereço não confere. Copie de novo, inteiro." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A character in this address doesn't check out. Copy it again, in full."
          }
