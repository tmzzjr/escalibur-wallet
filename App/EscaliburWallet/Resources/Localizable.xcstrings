        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque %@ tant que le compte accepte %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ ficam presos enquanto a conta aceitar %2$@"
