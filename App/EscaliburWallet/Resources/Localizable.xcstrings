          "stringUnit" : {
            "state" : "translated",
            "value" : "Comisión de red: unos %@. El máximo deja un margen para que la comisión varíe hasta que el envío entre en un bloque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
