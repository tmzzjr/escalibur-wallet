        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वेरिफ़ाइड सूची में नहीं. भरोसेमंद कीमत के बिना, ये कुल बैलेंस में शामिल नहीं होते."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di luar daftar terverifikasi. Tanpa harga yang tepercaya, token ini tidak dihitung dalam total saldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検証済みリスト外です。信頼できる価格がないため、合計残高には含まれません。"
