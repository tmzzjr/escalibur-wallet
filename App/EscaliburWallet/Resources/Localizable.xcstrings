    "Protege mais o preço, mas a troca pode falhar se o mercado se mexer, e a taxa da rede é cobrada mesmo assim." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمي السعر أكثر، لكن قد تفشل المبادلة إذا تحرّك السوق، وتُخصم رسوم الشبكة رغم ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schützt den Preis stärker, aber der Tausch kann fehlschlagen, wenn sich der Markt bewegt, und die Netzwerkgebühr wird trotzdem berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protects the price more, but the swap may fail if the market moves, and the network fee is charged anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege más el precio, pero el intercambio puede fallar si el mercado se mueve, y la comisión de red se cobra igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protège mieux le prix, mais l’échange peut échouer si le marché bouge, et les frais de réseau sont prélevés quand même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीमत को ज़्यादा सुरक्षित रखता है, लेकिन मार्केट हिलने पर स्वैप विफल हो सकता है, और नेटवर्क शुल्क फिर भी लगता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih melindungi harga, tetapi penukaran bisa gagal jika pasar bergerak, dan biaya jaringan tetap dikenakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格をより守れますが、相場が動くとスワップが失敗する可能性があり、その場合もネットワーク手数料はかかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격을 더 보호하지만, 시장이 움직이면 스왑이 실패할 수 있으며 그래도 네트워크 수수료는 청구됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatı daha çok korur ama piyasa hareket ederse takas başarısız olabilir ve ağ ücreti yine de alınır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảo vệ giá tốt hơn, nhưng hoán đổi có thể thất bại nếu thị trường biến động, và phí mạng vẫn bị tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对价格保护更强，但如果行情变动，兑换可能失败，且仍会收取网络费。"
          }
        }
      }
    },
