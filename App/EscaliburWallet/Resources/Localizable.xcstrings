        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ट्रांसफ़र का शुल्क वॉलेट की पूर्ण सीमा से ज़्यादा होगा. कुछ भी तैयार नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
