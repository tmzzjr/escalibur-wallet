        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a changé sur cet iPhone depuis son activation ici. Saisissez votre PIN ; vous pourrez ensuite le réactiver."
          }
        }
      }
    },
    "O %@ não confirmou. Ele continua desligado." : {
