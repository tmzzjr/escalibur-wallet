        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह वॉलेट केवल देखने के लिए है: रद्द करने के लिए साइन करने वाला वॉलेट खोलें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
