    "O envio venceu antes de chegar à rede. Nada saiu da conta. Revise e envie de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية التحويل قبل وصوله إلى الشبكة. لم يخرج أي شيء من الحساب. راجع وأرسل مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Transfer ist abgelaufen, bevor er das Netzwerk erreicht hat. Nichts hat das Konto verlassen. Prüfe und sende erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
