          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone with only the words can't open the vault"
          }
        }
      }
    },
    "Quem tem as palavras tem o saldo" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من يملك الكلمات يملك الرصيد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer die Wörter hat, hat das Guthaben"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoever has the words has the funds"
          }
        },
        "es" : {
          "stringUnit" : {
