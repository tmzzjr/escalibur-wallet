    },
    "Pelo menos %@ fica, o mínimo que a rede exige para a conta existir" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى %@ على الأقل، وهو الحد الأدنى الذي تشترطه الشبكة لوجود الحساب"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens %@ bleibt, das Minimum, das das Netzwerk für das Bestehen des Kontos verlangt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least %@ stays, the minimum the network requires for the account to exist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos %@ se queda, el mínimo que la red exige para que la cuenta exista"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte garde au moins %@, le minimum que le réseau exige pour qu’il existe"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम %@ रहता है, जो खाता बने रहने के लिए नेटवर्क का मांगा न्यूनतम है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimal %@ tetap di akun, jumlah minimum yang diwajibkan jaringan agar akun tetap ada"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少なくとも %@ が残ります（アカウントの存在にネットワークが求める最低額）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 %@ 금액은 남음. 계정이 존재하기 위해 네트워크가 요구하는 최소 금액"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En az %@ kalır; bu, hesabın var olması için ağın istediği minimumdur"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ít nhất %@ được giữ lại, mức tối thiểu mạng yêu cầu để tài khoản tồn tại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少保留 %@，这是网络要求账户存在的最低金额"
          }
        }
      }
    },
