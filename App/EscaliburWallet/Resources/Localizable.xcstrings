        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार में तीन शब्द. कार्ड को स्वाइप करें या अगले पर टैप करें."
          }
        },
        "id" : {
          "stringUnit" : {
