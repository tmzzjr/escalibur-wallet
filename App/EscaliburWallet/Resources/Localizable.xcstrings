          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activité"
          }
        }
      }
    },
    "Ativo emitido" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
