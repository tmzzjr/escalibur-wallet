    "Um provedor da rede respondeu fora do esperado. Nada foi assinado. Tente de novo em instantes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A network provider gave an unexpected response. Nothing was signed. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proveedor de la red respondió algo inesperado. No se firmó nada. Inténtalo de nuevo en unos instantes."
          }
        },
        "fr" : {
          "stringUnit" : {
