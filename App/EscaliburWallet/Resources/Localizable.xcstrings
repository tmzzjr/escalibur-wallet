          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शब्द %lld सूची में नहीं है. अपना कागज़ जांचें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
