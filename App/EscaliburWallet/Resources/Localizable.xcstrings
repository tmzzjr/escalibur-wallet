        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrat à autoriser n’existe pas sur ce réseau. Rien n’a été signé."
          }
        }
      }
    },
    "O contrato da CoW não respondeu nesta rede. Nada foi assinado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The CoW contract didn't respond on this network. Nothing was signed."
          }
