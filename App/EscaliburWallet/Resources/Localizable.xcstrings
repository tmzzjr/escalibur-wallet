        }
      }
    },
    "O preço mudou desde a cotação e o mínimo garantido ficou abaixo do mostrado. Confira o novo preço e tente de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر السعر منذ عرض السعر وأصبح الحد الأدنى المستلم أقل مما عُرض. تحقق من السعر الجديد وحاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis hat sich seit dem Angebot geändert, und der Mindestbetrag liegt jetzt unter dem angezeigten. Prüfe den neuen Preis und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
