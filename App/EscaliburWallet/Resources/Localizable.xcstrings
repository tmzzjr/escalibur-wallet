      }
    },
    "Sem cópia" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No backup"
          }
        }
      }
    },
    "Sem ela, as palavras acima abrem uma carteira diferente e vazia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it, the words above open a different, empty wallet."
          }
        }
      }
    },
    "Sem entrega em %u horas, o depósito volta para esta conta na %@, algumas horas depois do prazo" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If not delivered within %u hours, the deposit returns to this account on %@, a few hours after the deadline"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sem entrega em %1$u horas, o depósito volta para esta conta na %2$@, algumas horas depois do prazo"
          }
        }
      }
    },
    "Sem gráfico: o CoinGecko não lista este contrato e o GeckoTerminal não tem pool com liquidez para ele." : {
