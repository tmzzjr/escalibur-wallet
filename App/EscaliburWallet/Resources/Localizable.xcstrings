      }
    },
    "Mesmo abaixo do valor, a frase volta depois de alguns envios." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى دون هذا المبلغ، تُطلب العبارة مجددًا بعد بضعة تحويلات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch unter dem Betrag wird die Phrase nach einigen Transfers wieder verlangt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even below the amount, the phrase is required again after a few transfers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluso por debajo del valor, la frase se vuelve a pedir después de algunos envíos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même en dessous du montant, la phrase est à nouveau demandée après quelques envois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "राशि कम होने पर भी, कुछ ट्रांसफ़र के बाद फ़्रेज़ फिर से मांगा जाता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bahkan di bawah jumlah itu, frasa akan diminta lagi setelah beberapa pengiriman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "金額が基準以下でも、何回か送金するとフレーズが再び求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기준 금액 이하라도 몇 번 전송하면 문구를 다시 요청합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutarın altında bile ifade birkaç transferden sonra yeniden istenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngay cả dưới mức số tiền đó, cụm từ vẫn được yêu cầu lại sau vài lần gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使低于该金额，转账几笔之后仍会再次要求说出短语。"
          }
        }
      }
    },
