        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản đích chưa tồn tại. Lần gửi đầu tiên phải ít nhất bằng mức tối thiểu để kích hoạt tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标账户尚不存在。首笔转账金额必须达到激活账户的最低金额。"
