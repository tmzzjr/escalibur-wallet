          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur Stellar, chaque actif a 7 décimales, fixées par le réseau lui-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar पर हर एसेट के 7 डेसिमल होते हैं, जो खुद नेटवर्क तय करता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Stellar, setiap aset memiliki 7 desimal, ditetapkan oleh jaringan itu sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar では、ネットワーク自体の仕様ですべての資産が小数点以下 7 桁です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar에서는 네트워크 규칙에 따라 모든 자산의 소수 자릿수가 7자리입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellar'da her varlığın, ağın kendisi tarafından belirlenen 7 ondalık basamağı vardır."
