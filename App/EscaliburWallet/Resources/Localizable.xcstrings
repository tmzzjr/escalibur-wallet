    },
    "A resposta da rede não confere com a mensagem assinada. Confira a Atividade antes de enviar de novo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network's response doesn't match the signed message. Check Activity before sending again."
