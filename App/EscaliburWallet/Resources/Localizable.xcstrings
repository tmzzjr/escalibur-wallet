    "Só ela abre o envelope, em qualquer aparelho. Não é o PIN e não pode ser a senha da carteira. Não existe redefinir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only this password opens the envelope, on any device. It isn't the PIN and can't be the recovery phrase. There's no reset."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ella abre el sobre, en cualquier dispositivo. No es el PIN y no puede ser la frase de recuperación. No se puede restablecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lui seul ouvre l’enveloppe, sur n’importe quel appareil. Ce n’est pas le PIN et ce ne peut pas être la phrase de récupération. Aucune réinitialisation n’est possible."
          }
        }
      }
    },
