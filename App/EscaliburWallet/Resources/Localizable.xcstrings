          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क के कन्फ़र्म करने पर नया बैलेंस दिखेगा."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saldo baru muncul setelah jaringan mengonfirmasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークが確認すると、新しい残高が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크가 확정하면 새 잔액이 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bakiye ağ onayladığında görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số dư mới sẽ hiển thị khi mạng xác nhận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
