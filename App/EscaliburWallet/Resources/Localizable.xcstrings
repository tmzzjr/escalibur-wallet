          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此笔转账的手续费将超出钱包的绝对上限。未创建任何交易。"
          }
        }
      }
    },
    "A taxa escolhida fica abaixo do mínimo da rede." : {
