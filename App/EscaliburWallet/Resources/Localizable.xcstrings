    },
    "O CoinGecko pediu uma pausa. Esperando liberar para ler as redes de %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبت CoinGecko التوقف مؤقتًا. بانتظار السماح بقراءة شبكات %@."
