    "A senha escolhida quando o envelope foi lacrado. No app Escalibur, é a senha do cofre." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمة المرور التي اخترتها عند ختم المغلف. في تطبيق Escalibur، هي كلمة مرور الخزنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort, das beim Versiegeln des Umschlags gewählt wurde. In der Escalibur-App ist es das Tresor-Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
