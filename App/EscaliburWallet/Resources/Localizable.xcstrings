          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escalibur는 절대 단어를 요청하지 않음"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escalibur kelimeleri asla istemez"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escalibur không bao giờ hỏi xin các từ"
          }
