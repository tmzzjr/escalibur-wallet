        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nenhuma rota troca %1$@ por %2$@ na Stellar agora. Tente um valor menor."
          }
        }
      }
    },
    "Nenhuma: juntar as moedas devolve mais armazenamento do que o envio custa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
