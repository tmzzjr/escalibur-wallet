        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 비밀번호가 일치하지 않습니다. 봉투 비밀번호를 다시 입력하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
