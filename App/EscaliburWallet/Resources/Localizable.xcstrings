    "%lld tokens chegaram numa rede em que a carteira ainda só conta quantos são, sem ler nome e contrato. Eles ficam escondidos." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld رموز مميزة وصلت إلى شبكة لا تستطيع المحفظة فيها بعد سوى عدّ الرموز، دون قراءة اسمها أو عقدها. تبقى مخفية."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld رمزًا مميزًا وصلت إلى شبكة لا تستطيع المحفظة فيها بعد سوى عدّ الرموز، دون قراءة اسمها أو عقدها. تبقى مخفية."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld رمز مميز وصل إلى شبكة لا تستطيع المحفظة فيها بعد سوى عدّ الرموز، دون قراءة اسمه أو عقده. يبقى مخفيًا."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld رمز مميز وصلت إلى شبكة لا تستطيع المحفظة فيها بعد سوى عدّ الرموز، دون قراءة اسمها أو عقدها. تبقى مخفية."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld رمزان مميزان وصلا إلى شبكة لا تستطيع المحفظة فيها بعد سوى عدّ الرموز، دون قراءة اسميهما أو عقديهما. يبقيان مخفيين."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld رمز مميز وصلت إلى شبكة لا تستطيع المحفظة فيها بعد سوى عدّ الرموز، دون قراءة اسمها أو عقدها. تبقى مخفية."
                }
              }
            }
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Token sind in einem Netzwerk angekommen, in dem das Wallet bisher nur zählen kann, wie viele es sind, ohne Name und Vertrag zu lesen. Sie bleiben ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld tokens arrived on a network where the wallet can only count tokens so far, without reading their name or contract. They stay hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld tokens llegaron a una red en la que la billetera por ahora solo cuenta cuántos son, sin leer nombre ni contrato. Quedan ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld jetons sont arrivés sur un réseau où le portefeuille sait seulement les compter, sans lire leur nom ni leur contrat. Ils restent masqués."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld टोकन ऐसे नेटवर्क पर आए जहां वॉलेट अभी सिर्फ़ टोकन गिन सकता है, उनका नाम या कॉन्ट्रैक्ट पढ़े बिना. ये छिपे रहते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld token masuk di jaringan yang sejauh ini hanya bisa dihitung jumlahnya oleh dompet, tanpa membaca nama dan kontraknya. Token ini disembunyikan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個のトークンが、ウォレットがまだ数しか数えられず、名前やコントラクトを読み取れないネットワークに届きました。これらは非表示のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
