    "Frase gravada. As operações marcadas abaixo pedem a frase antes do %@ ou do PIN." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل العبارة. العمليات المحددة أدناه تطلب العبارة قبل %@ أو PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phrase aufgenommen. Die unten markierten Aktionen verlangen die Phrase vor %@ oder der PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phrase recorded. The actions checked below ask for the phrase before %@ or your PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frase grabada. Las operaciones marcadas abajo piden la frase antes de %@ o del PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phrase enregistrée. Les opérations cochées ci-dessous demandent la phrase avant %@ ou votre PIN."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्रेज़ रिकॉर्ड हो गया. नीचे चुनी गई कार्रवाइयों के लिए %@ या PIN से पहले फ़्रेज़ मांगा जाता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frasa direkam. Tindakan yang dicentang di bawah meminta frasa sebelum %@ atau PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレーズを録音しました。下でチェックした操作では、%@ または PIN の前にフレーズが求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문구를 녹음했습니다. 아래에서 선택한 작업은 %@ 또는 PIN 전에 문구를 요청합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
