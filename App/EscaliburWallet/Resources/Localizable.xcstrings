    "Ao continuar, você aceita os [Termos de uso](escalibur-doc:termos) e a [Política de privacidade](escalibur-doc:privacidade)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بالمتابعة، أنت توافق على [شروط الاستخدام](escalibur-doc:termos) و[سياسة الخصوصية](escalibur-doc:privacidade)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, akzeptierst du die [Nutzungsbedingungen](escalibur-doc:termos) und die [Datenschutzrichtlinie](escalibur-doc:privacidade)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By continuing, you accept the [Terms of use](escalibur-doc:termos) and the [Privacy policy](escalibur-doc:privacidade)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
