        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bị khóa cho dung lượng lưu trữ của tài khoản trên mạng và không được tính vào mức tối đa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
