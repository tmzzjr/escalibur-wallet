          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "响应的服务商不足，无法核对数据。请稍后重试。"
          }
        }
      }
    },
    "Não há SOL suficiente para este envio depois da taxa da rede e da reserva mínima da conta." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد SOL كافٍ لهذا التحويل بعد رسوم الشبكة والاحتياطي الأدنى للحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der Netzwerkgebühr und der Mindestreserve des Kontos reicht das SOL nicht für diesen Transfer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn't enough SOL for this transfer after the network fee and the account's minimum reserve."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay SOL suficiente para este envío después de la comisión de red y la reserva mínima de la cuenta."
