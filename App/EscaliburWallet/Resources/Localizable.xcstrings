    "Não reconheci este endereço em nenhuma rede ligada. Confira se copiou inteiro." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أتعرف على هذا العنوان على أي شبكة مفعّلة. تأكد من أنك نسخته كاملًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe diese Adresse in keinem eingeschalteten Netzwerk erkannt. Prüfe, ob du sie vollständig kopiert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I didn't recognize this address on any network that's turned on. Make sure you copied all of it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No reconocí esta dirección en ninguna red activada. Comprueba que la copiaste entera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai reconnu cette adresse sur aucun réseau activé. Vérifiez que vous l’avez copiée en entier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पता किसी भी चालू नेटवर्क पर पहचाना नहीं गया. पक्का करें कि आपने पूरा कॉपी किया है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya tidak mengenali alamat ini di jaringan aktif mana pun. Pastikan Anda menyalin seluruhnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンになっているどのネットワークでも、このアドレスを認識できませんでした。すべてコピーされているか確認してください。"
