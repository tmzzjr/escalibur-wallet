        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direcciones listas en %lld redes. Guarda el papel lejos del iPhone: si pierdes el iPhone, el papel recupera la billetera, aquí o en cualquier billetera BIP-39."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresses prêtes sur %lld réseaux. Gardez le papier loin de l’iPhone : si l’iPhone est perdu, le papier permet de récupérer le portefeuille, ici ou dans n’importe quel portefeuille BIP-39."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld नेटवर्क पर पते तैयार हैं. कागज़ को iPhone से दूर रखें: अगर iPhone खो जाए, तो कागज़ से वॉलेट वापस आ जाता है, यहां या किसी भी BIP-39 वॉलेट में."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat siap di %lld jaringan. Simpan kertas jauh dari iPhone: jika iPhone hilang, kertas itu memulihkan dompet, di sini atau di dompet BIP-39 mana pun."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 個のネットワークのアドレスを用意しました。紙は iPhone から離れた場所に保管してください。iPhone をなくしても、紙があれば、ここでもほかの BIP-39 ウォレットでもウォレットを復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 네트워크의 주소가 준비되었습니다. 종이는 iPhone과 떨어진 곳에 보관하세요. iPhone을 잃어버려도 종이만 있으면 여기서든 다른 BIP-39 지갑에서든 지갑을 복원할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ağda adresler hazır. Kâğıdı iPhone'dan uzak tut: iPhone kaybolursa kâğıt cüzdanı burada veya herhangi bir BIP-39 cüzdanında geri getirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ đã sẵn sàng trên %lld mạng. Hãy cất tờ giấy cách xa iPhone: nếu mất iPhone, tờ giấy sẽ khôi phục ví, tại đây hoặc trong bất kỳ ví BIP-39 nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 %lld 个网络上准备好地址。请将纸张存放在远离 iPhone 的地方：如果 iPhone 丢失，可凭这张纸在这里或任何 BIP-39 钱包中恢复钱包。"
          }
        }
      }
