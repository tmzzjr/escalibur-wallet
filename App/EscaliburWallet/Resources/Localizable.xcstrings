          "stringUnit" : {
            "state" : "translated",
            "value" : "No connection to market data right now."
          }
        }
      }
    },
    "Sem código, a proteção de dados do iOS não cifra os arquivos do app. Ative em Ajustes > Face ID e Código." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a passcode, iOS data protection doesn't encrypt the app's files. Turn it on in Settings > Face ID & Passcode."
          }
