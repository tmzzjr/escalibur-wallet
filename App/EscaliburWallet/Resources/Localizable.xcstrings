    "Digite a passphrase" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type the passphrase"
          }
        }
      }
    },
    "Digite a passphrase de %@ a partir de onde você anotou. Diferença de maiúscula, acento ou espaço já abre outra carteira, e o que chegar nesta se perde." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب passphrase لـ %@ نقلًا عن المكان الذي دوّنتها فيه. أي اختلاف في حرف كبير أو علامة أو مسافة يفتح محفظة أخرى، وما يصل إلى هذه المحفظة يضيع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib die Passphrase von %@ ein und lies sie dabei von deiner Notiz ab. Schon ein Unterschied bei Groß- und Kleinschreibung, Akzent oder Leerzeichen öffnet ein anderes Wallet, und was in diesem eingeht, ist verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type %@'s passphrase from where you wrote it down. Even a different capital letter, accent or space opens another wallet, and whatever arrives in this one is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe la passphrase de %@ desde donde la anotaste. Una diferencia de mayúscula, tilde o espacio ya abre otra billetera, y lo que llegue a esta se pierde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez la passphrase de %@ en recopiant l’endroit où vous l’avez notée. Une différence de majuscule, d’accent ou d’espace ouvre déjà un autre portefeuille, et ce qui arrive dans celui-ci est perdu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ का पासफ़्रेज़ वहीं से देखकर टाइप करें जहां आपने इसे लिखा था. बड़े-छोटे अक्षर, एक्सेंट या स्पेस का ज़रा-सा फ़र्क भी दूसरा वॉलेट खोल देता है, और इस वॉलेट में आने वाला सब कुछ खो जाता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik passphrase %@ sambil melihat catatan Anda. Perbedaan huruf besar, aksen, atau spasi saja sudah membuka dompet lain, dan apa pun yang masuk ke dompet ini akan hilang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のパスフレーズを、書き留めたものを見ながら入力してください。大文字・小文字、アクセント、スペースが少し違うだけで別のウォレットが開き、このウォレットに届いたものは失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 패스프레이즈를 적어 둔 곳을 보면서 입력하세요. 대소문자, 악센트, 공백이 조금만 달라도 다른 지갑이 열리며, 이 지갑으로 들어온 자금은 잃게 됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ passphrase'ini not ettiğin yere bakarak yaz. Büyük-küçük harf, aksan veya boşlukta tek bir fark bile başka bir cüzdan açar ve bu cüzdana gelen her şey kaybolur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy nhập passphrase của %@ theo đúng nơi bạn đã ghi lại. Chỉ cần khác chữ hoa, dấu hay khoảng trắng là sẽ mở ra một ví khác, và mọi thứ chuyển đến ví này sẽ bị mất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请照着你记录的内容输入 %@ 的 passphrase。大小写、重音符号或空格稍有不同，就会打开另一个钱包，转入这个钱包的资产将会丢失。"
          }
        }
      }
    },
