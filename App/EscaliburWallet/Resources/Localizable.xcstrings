          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngoài danh sách đã xác minh. Không có giá đáng tin cậy, các token này không được tính vào tổng số dư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不在验证列表中。由于没有可靠价格，它们不计入总余额。"
          }
        }
      }
    },
