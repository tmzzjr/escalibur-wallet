    "TRX insuficiente para as taxas da rede: este envio queima cerca de %@, e a conta tem %@. A Escalibur não paga essa taxa por você." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد TRX كافٍ لرسوم الشبكة: يحرق هذا التحويل نحو %@، ورصيد الحساب %@. Escalibur لا تدفع هذه الرسوم عنك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug TRX für die Netzwerkgebühren: Dieser Transfer verbrennt etwa %@, und das Konto hat %@. Escalibur zahlt diese Gebühr nicht für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough TRX for the network fees: this transfer burns about %@, and the account has %@. Escalibur doesn't pay this fee for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRX insuficiente para las comisiones de red: este envío quema unos %@, y la cuenta tiene %@. Escalibur no paga esta comisión por ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de TRX pour les frais de réseau : cet envoi brûle environ %@, et le compte a %@. Escalibur ne paie pas ces frais à votre place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क के लिए TRX काफ़ी नहीं है: यह ट्रांसफ़र लगभग %@ बर्न करता है, और खाते में %@ है. Escalibur आपके लिए यह शुल्क नहीं चुकाता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRX tidak cukup untuk biaya jaringan: pengiriman ini membakar sekitar %@, dan akun memiliki %@. Escalibur tidak membayar biaya ini untuk Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク手数料に必要な TRX が足りません。この送金では約 %@ がバーンされますが、アカウントの残高は %@ です。この手数料を Escalibur が代わりに支払うことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 수수료에 필요한 TRX가 부족합니다. 이 전송은 약 %@ 금액을 소각하지만 계정 잔액은 %@입니다. Escalibur는 이 수수료를 대신 내 주지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "TRX insuficiente para as taxas da rede: este envio queima cerca de %1$@, e a conta tem %2$@. A Escalibur não paga essa taxa por você."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ ücretleri için TRX yetersiz: bu transfer yaklaşık %@ yakar ve hesapta %@ var. Escalibur bu ücreti senin yerine ödemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ TRX để trả phí mạng: lần gửi này đốt khoảng %@, và tài khoản có %@. Escalibur không trả khoản phí này thay bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TRX 不足以支付网络费：此笔转账约燃烧 %@，而账户只有 %@。Escalibur 不会替你支付这笔费用。"
          }
        }
      }
    },
