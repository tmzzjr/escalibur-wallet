        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adressen auf %lld Netzwerken bereit. Bewahre das Papier getrennt vom iPhone auf: Wenn das iPhone verloren geht, bringt das Papier das Wallet zurück, hier oder in jedem BIP-39-Wallet."
          }
        },
        "en" : {
          "stringUnit" : {
