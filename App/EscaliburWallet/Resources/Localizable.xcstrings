          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去最高値より %@%% 低い"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "역대 최고가 대비 %@%% 낮음"
          }
        },
