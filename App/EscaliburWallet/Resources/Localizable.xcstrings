    "Enviar tokens pelo XRP Ledger chega numa atualização em breve. XRP já funciona." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال الرموز المميزة على XRP Ledger قادم في تحديث قريب. XRP يعمل بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token-Transfers auf dem XRP Ledger kommen bald mit einem Update. XRP funktioniert schon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending tokens on the XRP Ledger is coming in an update soon. XRP already works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar tokens por XRP Ledger llegará pronto en una actualización. XRP ya funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi de jetons sur le XRP Ledger arrive bientôt dans une mise à jour. XRP fonctionne déjà."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XRP Ledger पर टोकन भेजना जल्द ही एक अपडेट में आएगा. XRP पहले से काम करता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengirim token di XRP Ledger akan hadir dalam pembaruan segera. XRP sudah berfungsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XRP Ledger でのトークン送信は、近日中のアップデートで対応します。XRP はすでに送信できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XRP Ledger 토큰 전송은 곧 업데이트로 지원됩니다. XRP는 이미 보낼 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XRP Ledger üzerinden token gönderimi yakında bir güncellemeyle geliyor. XRP zaten çalışıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tính năng gửi token trên XRP Ledger sẽ có trong bản cập nhật sắp tới. XRP đã hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 XRP Ledger 发送代币的功能即将在更新中推出。XRP 已可使用。"
          }
        }
      }
    },
    "Envie até %@ ou use enviar tudo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل حتى %@ أو أرسل الرصيد كاملًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende bis zu %@ oder das gesamte Guthaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send up to %@ or send the full balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía hasta %@ o usa enviar todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez jusqu’à %@ ou utilisez Tout envoyer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तक भेजें या पूरा बैलेंस भेजें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim hingga %@ atau kirim seluruh saldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ まで送信するか、全額送信を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 보내거나 전액 보내기를 사용하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fazla %@ gönder veya tümünü gönder seçeneğini kullan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy gửi tối đa %@ hoặc dùng gửi toàn bộ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多发送 %@，或发送全部余额。"
          }
        }
      }
    },
    "Envie só %@, pela rede %@. Outra moeda enviada para este endereço se perde." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
