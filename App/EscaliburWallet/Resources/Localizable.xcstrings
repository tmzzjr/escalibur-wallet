          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrat CoW n’a pas répondu sur ce réseau. Rien n’a été signé."
          }
        }
      }
    },
    "O contrato da ponte não respondeu como esperado. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bridge contract didn't respond as expected. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contrato del puente no respondió como se esperaba. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrat du pont n’a pas répondu comme prévu. %@"
          }
        }
      }
    },
    "O contrato desta carteira na rede não é da versão esperada. Nada foi montado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
