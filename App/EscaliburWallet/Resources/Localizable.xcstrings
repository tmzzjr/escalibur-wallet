    "Destrava o app e confirma envios em 1 segundo. Se o %@ falhar, o PIN vale." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح قفل التطبيق ويؤكد التحويلات في ثانية واحدة. إذا تعذّر %@، يعمل PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperrt die App und bestätigt Transfers in 1 Sekunde. Wenn %@ nicht klappt, geht es mit der PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlocks the app and confirms transfers in 1 second. If %@ fails, the PIN works."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea la app y confirma envíos en 1 segundo. Si %@ falla, el PIN funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouille l’app et confirme les envois en 1 seconde. Si %@ échoue, le PIN fonctionne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप अनलॉक करता है और 1 सेकंड में ट्रांसफ़र की पुष्टि करता है. अगर %@ काम न करे, तो PIN चलेगा."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka aplikasi dan mengonfirmasi pengiriman dalam 1 detik. Jika %@ gagal, PIN tetap bisa dipakai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのロック解除と送金の確認が 1 秒で完了します。%@ に失敗した場合は PIN を使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1초 만에 앱 잠금을 해제하고 전송을 확인합니다. %@가 실패하면 PIN을 사용할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın kilidini açar ve transferleri 1 saniyede onaylar. %@ başarısız olursa PIN geçerlidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở khóa ứng dụng và xác nhận lần gửi trong 1 giây. Nếu %@ không thành công, bạn vẫn dùng được PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁 App，1 秒内确认转账。如果 %@ 失败，可以使用 PIN 码。"
          }
        }
      }
    },
