        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Taxa da rede: cerca de %1$@. O máximo deixa %2$@ reservados para a taxa, e o que não for usado volta para a conta."
          }
        }
      }
    },
    "Taxa da rede: cerca de %@. O máximo deixa uma folga para a taxa variar até o envio entrar num bloco." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network fee: about %@. The maximum leaves a buffer for the fee to vary until the transfer makes it into a block."
