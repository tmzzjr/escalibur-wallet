    "Não houve provedores suficientes respondendo para conferir os dados. Tente de novo em instantes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب عدد كافٍ من المزوّدين للتحقق من البيانات. حاول مجددًا بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug Anbieter haben geantwortet, um die Daten zu prüfen. Versuche es gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough providers responded to check the data. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No respondieron suficientes proveedores para comprobar los datos. Inténtalo de nuevo en unos instantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
