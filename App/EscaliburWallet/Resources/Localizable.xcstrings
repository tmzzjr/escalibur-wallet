        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khớp phần có thể khớp ngay và hủy phần còn lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即成交能成交的部分，取消其余部分"
          }
        }
      }
    },
