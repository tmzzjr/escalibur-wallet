        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo de la billetera está cifrado y se guarda aquí, en ningún otro lugar."
          }
        }
      }
    },
    "Tudo foi checado aqui, sem internet. Nada desta checagem sai do aparelho." : {
