    "Não foi possível ler o arquivo inteiro. Se ele está no iCloud, espere o download terminar e tente de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة الملف كاملًا. إذا كان في iCloud، فانتظر حتى يكتمل التنزيل وحاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
