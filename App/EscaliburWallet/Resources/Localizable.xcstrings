    "O destino mostrou algo diferente do que você assinou. Confira a Atividade das duas redes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أظهرت الوجهة شيئًا مختلفًا عما وقّعته. تحقق من النشاط على الشبكتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel zeigte etwas anderes, als du signiert hast. Prüfe die Aktivität in beiden Netzwerken."
          }
