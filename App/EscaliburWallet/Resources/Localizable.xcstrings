          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver ist an und liest die Wörter laut vor. Nutze Kopfhörer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver is on and reads the words aloud. Use headphones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver está activado y lee las palabras en voz alta. Usa auriculares."
          }
        },
        "fr" : {
