        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜져 있는 네트워크에서 이 주소를 인식하지 못했습니다. 전체를 복사했는지 확인하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
