        }
      }
    },
    "O seu rosto e o PIN abrem as carteiras." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your face and the PIN open the wallets."
          }
        }
      }
    },
    "O símbolo imita o de uma moeda conhecida, com outro contrato." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرمز يقلّد رمز عملة معروفة، بعقد مختلف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Symbol imitiert das eines bekannten Coins, mit anderem Vertrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The symbol imitates a well-known coin's, with a different contract."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El símbolo imita el de una moneda conocida, con otro contrato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le symbole imite celui d’une monnaie connue, avec un autre contrat."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंबल किसी जाने-माने कॉइन की नकल करता है, पर कॉन्ट्रैक्ट अलग है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
