    "Ordem limite na Solana ainda não está disponível nesta versão." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوامر محددة السعر على Solana غير متاحة في هذا الإصدار بعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit-Orders auf Solana sind in dieser Version noch nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit orders on Solana aren't available in this version yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La orden límite en Solana aún no está disponible en esta versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ordres limites sur Solana ne sont pas encore disponibles dans cette version."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana पर लिमिट ऑर्डर इस वर्ज़न में अभी उपलब्ध नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Order limit di Solana belum tersedia di versi ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana の指値注文は、このバージョンではまだ利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana 지정가 주문은 이 버전에서 아직 지원하지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana'da limit emri bu sürümde henüz kullanılamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lệnh giới hạn trên Solana chưa có trong phiên bản này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此版本暂不支持 Solana 上的限价单。"
          }
        }
      }
    },
    "Ordem limite na Solana ainda não está disponível nesta versão. Nada sai da sua carteira para esperar uma ordem." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوامر محددة السعر على Solana غير متاحة في هذا الإصدار بعد. لا يخرج أي شيء من محفظتك لانتظار أمر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit-Orders auf Solana sind in dieser Version noch nicht verfügbar. Nichts verlässt dein Wallet, um auf eine Order zu warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit orders on Solana aren't available in this version yet. Nothing leaves your wallet to wait for an order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La orden límite en Solana aún no está disponible en esta versión. Nada sale de tu billetera para esperar una orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ordres limites sur Solana ne sont pas encore disponibles dans cette version. Rien ne quitte votre portefeuille pour attendre un ordre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana पर लिमिट ऑर्डर इस वर्ज़न में अभी उपलब्ध नहीं है. ऑर्डर के इंतज़ार में आपके वॉलेट से कुछ भी नहीं निकलता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Order limit di Solana belum tersedia di versi ini. Tidak ada yang keluar dari dompet Anda untuk menunggu order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana の指値注文は、このバージョンではまだ利用できません。注文を待つためにウォレットから何かが出ていくことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana 지정가 주문은 이 버전에서 아직 지원하지 않습니다. 주문을 기다리기 위해 지갑에서 나가는 것은 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solana'da limit emri bu sürümde henüz kullanılamıyor. Bir emri beklemek için cüzdanından hiçbir şey çıkmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lệnh giới hạn trên Solana chưa có trong phiên bản này. Không có gì rời khỏi ví của bạn để chờ một lệnh."
          }
        },
        "zh-Hans" : {
