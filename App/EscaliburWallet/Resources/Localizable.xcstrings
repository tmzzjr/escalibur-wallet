    "Pouca memória livre agora. Feche outros apps e tente de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذاكرة المتاحة منخفضة الآن. أغلق التطبيقات الأخرى وحاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade wenig freier Speicher. Schließ andere Apps und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Low on free memory right now. Close other apps and try again."
          }
        },
