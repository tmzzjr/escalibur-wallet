        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम में लालच देने वाले शब्द हैं: क्लेम, इनाम, बोनस, एयरड्रॉप, विज़िट."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama memakai umpan: klaim, hadiah, bonus, airdrop, kunjungi."
