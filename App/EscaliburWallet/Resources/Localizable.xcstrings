        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस कॉन्ट्रैक्ट को अनुमति देनी है, वह इस नेटवर्क पर मौजूद नहीं है. कुछ भी साइन नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrak yang akan disetujui tidak ada di jaringan ini. Tidak ada yang ditandatangani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認するコントラクトがこのネットワークに存在しません。何も署名されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인할 컨트랙트가 이 네트워크에 없습니다. 서명된 것이 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onaylanacak kontrat bu ağda yok. Hiçbir şey imzalanmadı."
