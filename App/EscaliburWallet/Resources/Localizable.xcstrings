    "Preço da pool %@ na %@, com %@ de liquidez, pelo GeckoTerminal. É preço de DEX: qualquer um cria uma pool, e por isso ele não entra no saldo total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السعر من مجمّع %@ على %@، بسيولة %@، عبر GeckoTerminal. إنه سعر DEX: يمكن لأي شخص إنشاء مجمّع، لذلك لا يُحتسب في الرصيد الإجمالي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preis aus dem Pool %@ auf %@, mit %@ Liquidität, über GeckoTerminal. Das ist ein DEX-Preis: Jeder kann einen Pool erstellen, daher zählt er nicht zum Gesamtguthaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Price from the %@ pool on %@, with %@ in liquidity, via GeckoTerminal. It's a DEX price: anyone can create a pool, so it isn't included in the total balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precio del pool %@ en %@, con %@ de liquidez, según GeckoTerminal. Es un precio de DEX: cualquiera crea un pool, y por eso no entra en el saldo total."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix du pool %@ sur %@, avec %@ de liquidité, via GeckoTerminal. C’est un prix de DEX : n’importe qui peut créer un pool, c’est pourquoi il n’entre pas dans le solde total."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ पर %1$@ पूल की कीमत, %3$@ लिक्विडिटी के साथ, GeckoTerminal के ज़रिए. यह DEX कीमत है: कोई भी पूल बना सकता है, इसलिए यह कुल बैलेंस में शामिल नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga dari pool %@ di %@, dengan likuiditas %@, lewat GeckoTerminal. Ini harga DEX: siapa pun bisa membuat pool, karena itu harga ini tidak dihitung dalam total saldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeckoTerminal による、%2$@ の %1$@ プール（流動性 %3$@）の価格です。DEX の価格で、誰でもプールを作成できるため、合計残高には含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GeckoTerminal 기준 %2$@ 네트워크의 %1$@ 풀 가격(유동성 %3$@)입니다. DEX 가격이므로 누구나 풀을 만들 수 있어 총 잔액에는 포함되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Preço da pool %1$@ na %2$@, com %3$@ de liquidez, pelo GeckoTerminal. É preço de DEX: qualquer um cria uma pool, e por isso ele não entra no saldo total."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ üzerindeki %1$@ havuzunun fiyatı, %3$@ likiditeyle, GeckoTerminal üzerinden. Bu bir DEX fiyatıdır: herkes havuz oluşturabilir, bu yüzden toplam bakiyeye dahil edilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá từ pool %@ trên %@, với thanh khoản %@, qua GeckoTerminal. Đây là giá DEX: ai cũng có thể tạo pool, vì vậy giá này không được tính vào tổng số dư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格来自 GeckoTerminal 上 %2$@ 的 %1$@ 池，流动性 %3$@。这是 DEX 价格：任何人都可以创建池子，因此不计入总余额。"
          }
        }
      }
    },
