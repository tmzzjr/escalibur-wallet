        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escanear el QR, la app necesita la cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour scanner le QR code, l’app a besoin de l’appareil photo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR स्कैन करने के लिए ऐप को कैमरा चाहिए."
          }
        }
      }
    },
    "Para ler saldos, cotações e enviar, o app fala direto com nós públicos de cada rede, de empresas diferentes. Não existe servidor da Escalibur no meio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لقراءة الأرصدة وعروض الأسعار وللإرسال، يتواصل التطبيق مباشرة مع العُقد العامة لكل شبكة، التي تديرها شركات مختلفة. لا يوجد خادم لـ Escalibur في الوسط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Guthaben und Angebote zu lesen und zu senden, spricht die App direkt mit öffentlichen Nodes jedes Netzwerks, betrieben von verschiedenen Firmen. Dazwischen gibt es keinen Escalibur-Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To read balances and quotes and to send, the app talks directly to each network's public nodes, run by different companies. There's no Escalibur server in between."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para leer saldos y cotizaciones y para enviar, la app habla directamente con nodos públicos de cada red, de empresas distintas. No hay ningún servidor de Escalibur de por medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire les soldes et les cotations et pour envoyer, l’app communique directement avec les nœuds publics de chaque réseau, gérés par différentes entreprises. Il n’y a aucun serveur Escalibur entre les deux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैलेंस और कोट पढ़ने और भेजने के लिए, ऐप सीधे हर नेटवर्क के पब्लिक नोड से बात करता है, जिन्हें अलग-अलग कंपनियां चलाती हैं. बीच में Escalibur का कोई सर्वर नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk membaca saldo dan kuotasi serta mengirim, aplikasi terhubung langsung ke node publik setiap jaringan, yang dijalankan oleh perusahaan berbeda. Tidak ada server Escalibur di tengahnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残高や見積もりの読み込み、送信のために、アプリは各ネットワークの公開ノード（運営はそれぞれ別の企業）と直接通信します。Escalibur のサーバーは経由しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잔액과 견적을 읽고 전송하기 위해, 앱은 여러 회사가 운영하는 각 네트워크의 공개 노드와 직접 통신합니다. 중간에 Escalibur 서버는 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakiyeleri ve teklifleri okumak ve göndermek için uygulama, farklı şirketlerin işlettiği her ağın herkese açık düğümleriyle doğrudan konuşur. Arada Escalibur sunucusu yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để đọc số dư, báo giá và gửi, ứng dụng kết nối trực tiếp với các node công khai của từng mạng, do nhiều công ty khác nhau vận hành. Không có máy chủ Escalibur nào ở giữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取余额、报价以及发送时，App 会直接连接各网络由不同公司运营的公共节点。中间没有 Escalibur 服务器。"
          }
        }
      }
    },
