    "Não foi possível registrar a tentativa neste iPhone. Libere espaço e tente de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تسجيل المحاولة على هذا iPhone. حرّر بعض المساحة وحاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Versuch konnte auf diesem iPhone nicht gespeichert werden. Gib Speicher frei und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't record the attempt on this iPhone. Free up space and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo registrar el intento en este iPhone. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer la tentative sur cet iPhone. Libérez de l’espace et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर कोशिश दर्ज नहीं हो सकी. जगह खाली करें और फिर से कोशिश करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa mencatat percobaan di iPhone ini. Kosongkan ruang penyimpanan dan coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone に試行を記録できませんでした。空き容量を確保して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에 시도 기록을 저장할 수 없습니다. 저장 공간을 확보하고 다시 시도하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deneme bu iPhone'a kaydedilemedi. Yer aç ve tekrar dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể ghi nhận lần thử trên iPhone này. Hãy giải phóng dung lượng và thử lại."
          }
        },
        "zh-Hans" : {
