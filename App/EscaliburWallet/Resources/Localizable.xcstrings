          }
        }
      }
    },
    "Um alerta só sai quando o CoinGecko e o CoinPaprika concordam no preço." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An alert only goes out when CoinGecko and CoinPaprika agree on the price."
