    "Não expira: fica no livro até executar ou você cancelar" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنتهي صلاحيته: يبقى في دفتر الأوامر حتى يُنفَّذ أو تلغيه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft nicht ab: bleibt im Orderbuch, bis sie ausgeführt wird oder du sie stornierst"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doesn't expire: stays on the order book until it executes or you cancel it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vence: queda en el libro hasta que se ejecute o la canceles"
