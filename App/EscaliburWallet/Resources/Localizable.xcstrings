        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 수수료와 계정 최소 준비금을 빼면 이 전송에 필요한 SOL이 부족합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
