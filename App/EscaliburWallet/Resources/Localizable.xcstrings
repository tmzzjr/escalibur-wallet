          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông điệp đã ký không khớp với thông điệp đã tạo. Chưa có gì được phát lên mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已签署的消息与创建的消息不符。未广播任何内容。"
          }
        }
      }
    },
    "A mesma que carteiras de hardware mostram para esta frase." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البصمة نفسها التي تعرضها محافظ الأجهزة لعبارة الاسترداد هذه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derselbe Fingerabdruck, den Hardware-Wallets für diese Wiederherstellungsphrase anzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same fingerprint hardware wallets show for this recovery phrase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma huella que muestran las billeteras de hardware para esta frase de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La même empreinte que celle affichée par les portefeuilles matériels pour cette phrase de récupération."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वही फ़िंगरप्रिंट जो हार्डवेयर वॉलेट इस रिकवरी फ़्रेज़ के लिए दिखाते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidik jari yang sama dengan yang ditampilkan dompet hardware untuk frasa pemulihan ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハードウェアウォレットがこのリカバリーフレーズに対して表示するものと同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하드웨어 지갑이 이 복구 구문에 대해 표시하는 것과 같은 지문입니다."
          }
        },
        "tr" : {
