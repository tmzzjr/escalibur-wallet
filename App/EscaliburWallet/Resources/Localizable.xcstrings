          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ existe na %2$@, que está desligada nesta carteira. Ligue a rede em Ajustes para receber."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, bu cüzdanda kapalı olan %@ ağında bulunuyor. Almak için ağı Ayarlar'dan aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ có trên %@, mạng đang tắt trong ví này. Hãy bật mạng trong Cài đặt để nhận."
