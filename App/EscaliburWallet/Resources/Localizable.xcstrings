    "12 bastam. 24 dá a mesma proteção na prática e dobra o que anotar." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 كلمة تكفي. 24 كلمة تعطي الحماية نفسها عمليًا وتضاعف ما عليك تدوينه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 reichen. 24 bieten praktisch denselben Schutz und verdoppeln, was du aufschreiben musst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 is enough. 24 gives the same protection in practice and doubles what you have to write down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 bastan. 24 da la misma protección en la práctica y duplica lo que hay que anotar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 suffisent. 24 offrent la même protection en pratique et doublent ce qu’il faut noter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 काफ़ी हैं. 24 व्यवहार में वही सुरक्षा देते हैं और लिखने का काम दोगुना कर देते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 sudah cukup. 24 memberi perlindungan yang sama dalam praktiknya dan menggandakan yang harus Anda catat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 単語で十分です。24 単語でも実際の保護は同じで、書き留める量が倍になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12개면 충분합니다. 24개는 실제로 같은 수준의 보호를 제공하면서 적어야 할 양만 두 배가 됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 yeterli. 24 pratikte aynı korumayı sağlar ve yazman gerekeni ikiye katlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 từ là đủ. 24 từ cho mức bảo vệ tương đương trên thực tế và gấp đôi số từ phải ghi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 个就够了。24 个在实际中提供同样的保护，但要抄写的内容翻倍。"
          }
        }
      }
    },
