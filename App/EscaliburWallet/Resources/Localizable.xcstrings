    "A conta de destino está vazia na rede Polkadot, e a rede só a cria com pelo menos %@. Envie esse valor ou mais." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب الوجهة فارغ على Polkadot، ولا تنشئه الشبكة إلا بـ%@ على الأقل. أرسل هذا المبلغ أو أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zielkonto ist auf Polkadot leer, und das Netzwerk erstellt es erst ab %@. Sende diesen Betrag oder mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The destination account is empty on Polkadot, and the network only creates it with at least %@. Send that amount or more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de destino está vacía en la red Polkadot, y la red solo la crea con al menos %@. Envía esa cantidad o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte de destination est vide sur Polkadot, et le réseau ne le crée qu’avec au moins %@. Envoyez ce montant ou plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेस्टिनेशन खाता Polkadot पर खाली है, और नेटवर्क इसे कम से कम %@ के साथ ही बनाता है. इतनी या इससे ज़्यादा राशि भेजें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun tujuan kosong di jaringan Polkadot, dan jaringan hanya membuatnya dengan minimal %@. Kirim jumlah itu atau lebih."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宛先アカウントは Polkadot ネットワーク上で空で、ネットワークは %@ 以上でなければアカウントを作成しません。この金額以上を送金してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받는 계정이 Polkadot 네트워크에서 비어 있으며, 네트워크는 최소 %@ 이상이 있어야 계정을 생성합니다. 이 금액 이상을 보내세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef hesap Polkadot ağında boş ve ağ bu hesabı yalnızca en az %@ ile oluşturur. Bu tutarı veya daha fazlasını gönder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản đích đang trống trên Polkadot, và mạng chỉ tạo tài khoản khi có ít nhất %@. Hãy gửi số tiền đó hoặc nhiều hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标账户在 Polkadot 网络上为空，网络只会在至少收到 %@ 时创建该账户。请发送此金额或更多。"
          }
        }
      }
    },
