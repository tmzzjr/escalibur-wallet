    "ETH só entre redes em que ele é a moeda nativa, e na BNB, onde é o da Binance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH فقط بين الشبكات التي يكون فيها العملة الأصلية، وعلى BNB حيث يكون نسخة Binance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH nur zwischen Netzwerken, in denen es der native Coin ist, und auf BNB, wo es die Binance-Version ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH only between networks where it's the native coin, and on BNB, where it's the Binance version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH solo entre redes en las que es la moneda nativa, y en BNB, donde es el de Binance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH uniquement entre les réseaux où il est la monnaie native, et sur BNB, où c’est la version de Binance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH सिर्फ़ उन नेटवर्क के बीच जहां यह नेटिव कॉइन है, और BNB पर, जहां यह Binance का वर्ज़न है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH hanya antar jaringan yang menjadikannya koin native, dan di BNB, tempat ETH adalah versi Binance."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH は、ネイティブコインとして使われるネットワーク間と、Binance 版の ETH がある BNB でのみ移動できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH는 기본 코인으로 쓰이는 네트워크 사이와, Binance 버전 ETH가 있는 BNB에서만 이동할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH yalnızca yerel coin olduğu ağlar arasında ve Binance sürümünün bulunduğu BNB ağında."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH chỉ giữa các mạng mà ETH là coin gốc, và trên BNB, nơi ETH là phiên bản của Binance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ETH 只能在以其为原生币的网络之间跨链，以及在 BNB 上（那里是 Binance 版本）。"
          }
        }
      }
    },
