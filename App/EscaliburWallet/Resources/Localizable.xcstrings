          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai rien entendu. Touchez Parler maintenant et dites la phrase près de l’iPhone."
          }
        }
      }
    },
    "Não precisa de memo. Se a exchange pedir, marque que o endereço não tem memo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No memo needed. If the exchange asks, mark that the address has no memo."
