        }
      }
    },
    "A CoW recebeu o pedido. Se um solver já estava executando a ordem, ela ainda pode sair." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقت CoW الطلب. إذا كان أحد المنفّذين (solver) ينفّذ الأمر بالفعل، فقد يُنفَّذ رغم ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
