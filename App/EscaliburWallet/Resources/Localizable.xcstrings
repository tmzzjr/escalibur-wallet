        }
      }
    },
    "Aparecem 3 palavras por vez. Arraste o cartão para ver as próximas." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر 3 كلمات في كل مرة. اسحب البطاقة لرؤية الكلمات التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
