        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क शुल्क और खाते के न्यूनतम रिज़र्व के बाद इस ट्रांसफ़र के लिए काफ़ी SOL नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
