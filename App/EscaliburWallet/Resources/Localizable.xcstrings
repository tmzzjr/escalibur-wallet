    "A tolerância de preço passa do máximo que a carteira aceita na Solana. Escolha uma menor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانزلاق السعري يتجاوز الحد الأقصى الذي تقبله المحفظة على Solana. اختر قيمة أقل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Slippage überschreitet das Maximum, das das Wallet auf Solana erlaubt. Wähle eine kleinere."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The slippage exceeds the maximum the wallet allows on Solana. Choose a lower one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El deslizamiento supera el máximo que la billetera acepta en Solana. Elige uno menor."
          }
        },
        "fr" : {
