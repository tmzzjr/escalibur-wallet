    "Uma das moedas lidas não confere com a transação que a criou. Por segurança, nada foi montado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إحدى العملات المقروءة لا تتطابق مع المعاملة التي أنشأتها. حفاظًا على الأمان، لم يتم تجهيز أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer der gelesenen Coins stimmt nicht mit der Transaktion überein, die ihn erstellt hat. Zur Sicherheit wurde nichts vorbereitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One of the coins read doesn't match the transaction that created it. For safety, nothing was prepared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de las monedas leídas no coincide con la transacción que la creó. Por seguridad, no se preparó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’une des monnaies lues ne correspond pas à la transaction qui l’a créée. Par sécurité, rien n’a été préparé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पढ़े गए कॉइन में से एक, उसे बनाने वाले ट्रांज़ैक्शन से मेल नहीं खाता. सुरक्षा के लिए, कुछ भी तैयार नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu koin yang dibaca tidak cocok dengan transaksi yang membuatnya. Demi keamanan, tidak ada yang disiapkan."
