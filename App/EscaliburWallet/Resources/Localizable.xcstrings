        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta en la red de destino tiene código instalado (una delegación o un contrato). Podría ser un barredor automático puesto por alguien que conoce tu frase de recuperación. Puente bloqueado. %@"
          }
