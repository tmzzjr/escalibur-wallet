    "%@ desta conta estão congelados na rede (stake, voto ou vesting) e ficam fora do máximo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in this account is frozen on the network (stake, vote or vesting) and is left out of the maximum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de esta cuenta están congelados en la red (stake, voto o vesting) y quedan fuera del máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau gèle %@ de ce compte (staking, vote ou vesting), qui n’entre pas dans le maximum."
          }
        }
      }
    },
    "%@ desta conta estão junto de tokens nativos, que a Escalibur ainda não movimenta. O máximo conta só o ADA livre." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in this account sits alongside native tokens, which Escalibur can't move yet. The maximum counts only free ADA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de esta cuenta están junto a tokens nativos, que Escalibur aún no puede mover. El máximo cuenta solo el ADA libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte garde %@ avec des jetons natifs, qu’Escalibur ne peut pas encore déplacer. Le maximum ne compte que l’ADA libre."
          }
        }
      }
    },
    "%@ desta conta estão no saldo de endereço da Sui, que a Escalibur ainda não movimenta. O máximo conta só as moedas de SUI." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in this account is in the Sui address balance, which Escalibur can't move yet. The maximum counts only SUI coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de esta cuenta están en el saldo de dirección de Sui, que Escalibur aún no puede mover. El máximo cuenta solo las monedas de SUI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte a %@ dans le solde d’adresse de Sui, qu’Escalibur ne peut pas encore déplacer. Le maximum ne compte que les monnaies SUI."
          }
        }
      }
    },
