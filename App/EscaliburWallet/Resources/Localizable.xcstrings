          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de connexion aux données de marché pour le moment."
          }
        }
      }
    },
    "Sem código, a proteção de dados do iOS não cifra os arquivos do app. Ative em Ajustes > Face ID e Código." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without a passcode, iOS data protection doesn't encrypt the app's files. Turn it on in Settings > Face ID & Passcode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin código, la protección de datos de iOS no cifra los archivos de la app. Actívalo en Ajustes > Face ID y código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans code, la protection des données d’iOS ne chiffre pas les fichiers de l’app. Activez-le dans Réglages > Face ID et code."
          }
        }
      }
    },
    "Sem cópia" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No backup"
          }
        },
        "es" : {
