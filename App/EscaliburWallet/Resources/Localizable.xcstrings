    "XLM livre insuficiente para este valor mais a taxa da rede. Parte do saldo fica reservada pela rede." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد XLM حر كافٍ لهذا المبلغ مع رسوم الشبكة. تحتجز الشبكة جزءًا من الرصيد كاحتياطي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug freies XLM für diesen Betrag plus Netzwerkgebühr. Ein Teil des Guthabens wird vom Netzwerk als Reserve gehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough free XLM for this amount plus the network fee. Part of the balance is held in reserve by the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XLM libre insuficiente para esta cantidad más la comisión de red. Parte del saldo queda reservada por la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de XLM disponibles pour ce montant plus les frais de réseau. Une partie du solde est mise en réserve par le réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस राशि और नेटवर्क शुल्क के लिए उपलब्ध XLM काफ़ी नहीं है. बैलेंस का कुछ हिस्सा नेटवर्क रिज़र्व में रखता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XLM bebas tidak cukup untuk jumlah ini ditambah biaya jaringan. Sebagian saldo ditahan sebagai cadangan oleh jaringan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この金額とネットワーク手数料に対して、利用可能な XLM が不足しています。残高の一部はネットワークのリザーブとして確保されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 수수료를 포함한 이 금액에 쓸 수 있는 XLM이 부족합니다. 잔액 일부는 네트워크 준비금으로 묶여 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tutar ve ağ ücreti için serbest XLM yetersiz. Bakiyenin bir kısmı ağ tarafından rezerv olarak tutulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ XLM khả dụng cho số tiền này cộng phí mạng. Một phần số dư được mạng giữ làm khoản dự trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用 XLM 不足以支付此金额和网络费。部分余额由网络作为储备金保留。"
          }
        }
      }
    },
    "XLM não precisa de linha de confiança." : {
      "localizations" : {
        "ar" : {
