    "Acompanhe o saldo de um endereço sem guardar chave nenhuma neste iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع رصيد عنوان دون حفظ أي مفتاح على هذا iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge das Guthaben einer Adresse, ohne einen Schlüssel auf diesem iPhone zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track an address's balance without storing any key on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue el saldo de una dirección sin guardar ninguna clave en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez le solde d’une adresse sans stocker aucune clé sur cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर कोई कुंजी सेव किए बिना किसी पते का बैलेंस ट्रैक करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantau saldo sebuah alamat tanpa menyimpan kunci apa pun di iPhone ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone にキーを保存せずに、アドレスの残高を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에 키를 저장하지 않고 주소의 잔액을 확인할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da hiçbir anahtar saklamadan bir adresin bakiyesini takip et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi số dư của một địa chỉ mà không lưu khóa nào trên iPhone này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟踪某个地址的余额，无需在这台 iPhone 上存储任何密钥。"
          }
        }
      }
    },
