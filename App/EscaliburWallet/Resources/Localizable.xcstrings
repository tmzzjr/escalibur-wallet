      }
    },
    "O primeiro passo entrou na rede e falhou, e só a taxa foi cobrada. O resto não foi enviado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت الخطوة الأولى إلى الشبكة وفشلت، ولم تُخصم سوى الرسوم. لم يُرسَل الباقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der erste Schritt hat das Netzwerk erreicht und ist fehlgeschlagen, nur die Gebühr wurde berechnet. Der Rest wurde nicht gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first step reached the network and failed, and only the fee was charged. The rest wasn't sent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer paso llegó a la red y falló, y solo se cobró la comisión. El resto no se envió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première étape a atteint le réseau et a échoué, et seuls les frais ont été prélevés. Le reste n’a pas été envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहला चरण नेटवर्क तक पहुंचा और विफल रहा, और सिर्फ़ शुल्क लिया गया. बाकी नहीं भेजा गया."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah pertama masuk ke jaringan dan gagal, dan hanya biayanya yang dikenakan. Sisanya tidak dikirim."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のステップはネットワークに届きましたが失敗し、手数料のみ請求されました。残りは送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 단계가 네트워크에 들어갔지만 실패했으며 수수료만 청구되었습니다. 나머지는 전송되지 않았습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk adım ağa ulaştı ve başarısız oldu; yalnızca ücret alındı. Kalanı gönderilmedi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bước đầu tiên đã lên mạng và thất bại, và chỉ phí bị tính. Phần còn lại chưa được gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第一步已上链但失败，仅收取了手续费。其余步骤未发送。"
          }
        }
      }
    },
