      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُدرج CoinGecko %@ أيضًا على هذه الشبكات، مع عقد كل منها. لم تتحقق Escalibur من هذه العقود بعد."
          }
        },
