    "O provedor escolhido não respondeu a tempo. Atualize a cotação e tente de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يستجب المزوّد المختار في الوقت المناسب. حدّث عرض السعر وحاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
