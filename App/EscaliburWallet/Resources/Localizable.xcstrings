    "%@ existe na %@, que está desligada nesta carteira. Ligue a rede em Ajustes para receber." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ exists on %@, which is turned off in this wallet. Turn on the network in Settings to receive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ existe en %@, que está desactivada en esta billetera. Activa la red en Ajustes para recibir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ existe na %2$@, que está desligada nesta carteira. Ligue a rede em Ajustes para receber."
          }
        }
      }
    },
    "%@ fica na conta: é o mínimo que a rede exige para ela existir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stays in the account: it's the minimum the network requires for the account to exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se queda en la cuenta: es el mínimo que la red exige para que exista."
          }
        }
      }
    },
    "%@ ficam na conta: é a reserva mínima que a rede exige para ela continuar existindo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stays in the account: it's the minimum reserve the network requires to keep the account open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se quedan en la cuenta: es la reserva mínima que la red exige para que siga existiendo."
          }
        }
      }
    },
    "%@ ficam presos enquanto a conta aceitar %@" : {
