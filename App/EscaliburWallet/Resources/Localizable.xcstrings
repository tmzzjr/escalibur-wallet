          }
        }
      }
    },
    "Seis dígitos para destravar o app e confirmar envios quando o %@ falhar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six digits to unlock the app and confirm transfers when %@ fails."
