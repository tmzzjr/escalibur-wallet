    "Nas ordens abertas da carteira: pedido à CoW, grátis mas sem garantia, ou na cadeia, garantido, pagando taxa de rede" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من الأوامر المفتوحة في المحفظة: طلب إلى CoW، مجاني لكن غير مضمون، أو على السلسلة، مضمون، مع دفع رسوم الشبكة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den offenen Orders des Wallets: eine Anfrage an CoW, kostenlos, aber ohne Garantie, oder on-chain, garantiert, gegen Netzwerkgebühr"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the wallet's open orders: a request to CoW, free but not guaranteed, or on-chain, guaranteed, paying a network fee"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En las órdenes abiertas de la billetera: solicitud a CoW, gratis pero sin garantía, o en la cadena, garantizado, pagando comisión de red"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
