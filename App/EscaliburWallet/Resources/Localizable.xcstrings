        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu du portefeuille est chiffré et stocké ici, nulle part ailleurs."
          }
        }
      }
    },
    "Tudo foi checado aqui, sem internet. Nada desta checagem sai do aparelho." : {
