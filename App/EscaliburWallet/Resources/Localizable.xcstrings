    "%@ desta conta estão congelados na rede (stake, voto ou vesting) e ficam fora do máximo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ في هذا الحساب مجمّد على الشبكة (تخزين أو تصويت أو استحقاق تدريجي) ولا يُحتسب في الحد الأقصى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf diesem Konto sind im Netzwerk eingefroren (Stake, Abstimmung oder Vesting) und zählen nicht zum Maximum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in this account is frozen on the network (stake, vote or vesting) and is left out of the maximum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de esta cuenta están congelados en la red (stake, voto o vesting) y quedan fuera del máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau gèle %@ de ce compte (staking, vote ou vesting), qui n’entre pas dans le maximum."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खाते के %@ नेटवर्क पर फ़्रीज़ हैं (स्टेक, वोट या वेस्टिंग) और अधिकतम में शामिल नहीं हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di akun ini dibekukan di jaringan (stake, vote, atau vesting) dan tidak dihitung dalam jumlah maksimum."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントの %@ はネットワーク上で凍結されている（ステーク、投票、ベスティング）ため、最大額に含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 %@ 금액은 네트워크에 동결되어 있어(스테이킹, 투표 또는 베스팅) 최대 금액에서 제외됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesaptaki %@ ağda dondurulmuş durumda (stake, oy veya vesting) ve maksimuma dahil edilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trong tài khoản này đang bị đóng băng trên mạng (stake, bỏ phiếu hoặc vesting) và không được tính vào mức tối đa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户中有 %@ 在网络上被冻结（质押、投票或归属锁定），不计入最大金额。"
          }
        }
      }
    },
    "%@ desta conta estão junto de tokens nativos, que a Escalibur ainda não movimenta. O máximo conta só o ADA livre." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ في هذا الحساب موجود مع رموز أصلية لا تستطيع Escalibur نقلها بعد. الحد الأقصى يحتسب ADA الحر فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf diesem Konto liegen bei nativen Token, die Escalibur noch nicht bewegen kann. Das Maximum zählt nur freies ADA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in this account sits alongside native tokens, which Escalibur can't move yet. The maximum counts only free ADA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ de esta cuenta están junto a tokens nativos, que Escalibur aún no puede mover. El máximo cuenta solo el ADA libre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte garde %@ avec des jetons natifs, qu’Escalibur ne peut pas encore déplacer. Le maximum ne compte que l’ADA libre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खाते के %@ नेटिव टोकन के साथ हैं, जिन्हें Escalibur अभी मूव नहीं कर सकता. अधिकतम में सिर्फ़ उपलब्ध ADA गिना जाता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ di akun ini tersimpan bersama token native, yang belum bisa dipindahkan Escalibur. Jumlah maksimum hanya menghitung ADA yang bebas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントの %@ はネイティブトークンと一緒に保管されていて、Escalibur はまだ移動できません。最大額には利用可能な ADA のみが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 %@ 금액은 네이티브 토큰과 함께 묶여 있으며, Escalibur는 아직 이를 옮길 수 없습니다. 최대 금액에는 자유롭게 쓸 수 있는 ADA만 포함됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hesaptaki %@, Escalibur'un henüz taşıyamadığı yerel token'larla birlikte duruyor. Maksimum yalnızca serbest ADA'yı hesaba katar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trong tài khoản này nằm cùng các token gốc mà Escalibur chưa thể chuyển. Mức tối đa chỉ tính ADA khả dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户中有 %@ 与原生代币放在一起，Escalibur 暂不支持转移这些代币。最大金额只计算可用的 ADA。"
          }
        }
      }
    },
    "%@ desta conta estão no saldo de endereço da Sui, que a Escalibur ainda não movimenta. O máximo conta só as moedas de SUI." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ في هذا الحساب موجود في رصيد عنوان Sui، الذي لا تستطيع Escalibur نقله بعد. الحد الأقصى يحتسب عملات SUI فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf diesem Konto liegen im Adressguthaben von Sui, das Escalibur noch nicht bewegen kann. Das Maximum zählt nur SUI-Coins."
