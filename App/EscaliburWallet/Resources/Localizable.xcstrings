    "Este envelope está danificado e não abre. Se você tem outra cópia do arquivo, use a outra." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المغلف تالف ولا يُفتح. إذا كانت لديك نسخة أخرى من الملف، فاستخدمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Umschlag ist beschädigt und lässt sich nicht öffnen. Wenn du eine andere Kopie der Datei hast, nutze diese."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This envelope is damaged and won't open. If you have another copy of the file, use that one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sobre está dañado y no se abre. Si tienes otra copia del archivo, usa esa."
