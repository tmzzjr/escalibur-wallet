    "Nenhuma rota troca %@ por %@ na Stellar agora. Tente um valor menor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد مسار يبادل %@ مقابل %@ على Stellar الآن. جرّب مبلغًا أصغر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Route tauscht gerade %@ gegen %@ auf Stellar. Versuche einen kleineren Betrag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No route swaps %@ for %@ on Stellar right now. Try a smaller amount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna ruta intercambia %@ por %@ en Stellar ahora. Prueba con una cantidad menor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun itinéraire n’échange %@ contre %@ sur Stellar pour le moment. Essayez un montant plus faible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी Stellar पर कोई रूट %@ को %@ में स्वैप नहीं करता. छोटी राशि आज़माएं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada rute yang menukar %@ ke %@ di Stellar saat ini. Coba jumlah yang lebih kecil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在 Stellar で %1$@ を %2$@ にスワップできるルートがありません。より少ない金額をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 Stellar에서 %@ → %@ 스왑 경로가 없습니다. 더 적은 금액을 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nenhuma rota troca %1$@ por %2$@ na Stellar agora. Tente um valor menor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu an Stellar'da %@ → %@ takası yapan rota yok. Daha küçük bir tutar dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiện không có lộ trình nào hoán đổi %@ sang %@ trên Stellar. Hãy thử số tiền nhỏ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前 Stellar 上没有可将 %@ 兑换为 %@ 的路线。请尝试更小的金额。"
          }
        }
