    "O prazo da transação venceu antes de ela entrar na rede. Nada foi debitado. Revise de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقضى الموعد النهائي للمعاملة قبل وصولها إلى الشبكة. لم يُخصم أي شيء. راجع من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Frist der Transaktion ist abgelaufen, bevor sie das Netzwerk erreicht hat. Nichts wurde abgebucht. Prüfe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transaction's deadline passed before it reached the network. Nothing was debited. Review again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plazo de la transacción venció antes de que llegara a la red. No se debitó nada. Vuelve a revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La date limite de la transaction est passée avant qu’elle n’atteigne le réseau. Rien n’a été débité. Vérifiez à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांज़ैक्शन की डेडलाइन नेटवर्क तक पहुंचने से पहले निकल गई. कुछ भी डेबिट नहीं हुआ. फिर से रिव्यू करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas waktu transaksi habis sebelum masuk ke jaringan. Tidak ada saldo yang terpotong. Tinjau lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランザクションの期限が、ネットワークに届く前に過ぎました。何も引き落とされていません。もう一度確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜잭션이 네트워크에 들어가기 전에 기한이 지났습니다. 차감된 금액이 없습니다. 다시 검토하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlemin son süresi ağa ulaşmadan doldu. Bakiyenden hiçbir şey düşülmedi. Yeniden incele."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời hạn của giao dịch đã qua trước khi giao dịch lên mạng. Chưa có gì bị trừ. Hãy xem lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "交易在进入网络前已过截止时间。未扣除任何资金。请重新确认。"
          }
        }
      }
    },
