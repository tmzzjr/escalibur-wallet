    "Não foi possível ligar agora. Nada mudou: o modo de antes continua valendo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر التفعيل الآن. لم يتغيّر شيء: لا يزال الوضع السابق ساريًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschalten gerade nicht möglich. Nichts hat sich geändert: Der bisherige Modus gilt weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't turn it on right now. Nothing changed: the previous mode still applies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo activar ahora. Nada cambió: el modo anterior sigue vigente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’activer pour le moment. Rien n’a changé : le mode précédent reste en vigueur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी चालू नहीं हो सका. कुछ नहीं बदला: पहले वाला मोड लागू है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak bisa mengaktifkan saat ini. Tidak ada yang berubah: mode sebelumnya tetap berlaku."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在オンにできませんでした。何も変わっていません。以前のモードが引き続き有効です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 켤 수 없습니다. 바뀐 것은 없으며, 이전 모드가 그대로 적용됩니다."
          }
        },
