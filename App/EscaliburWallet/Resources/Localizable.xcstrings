          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name uses bait: claim, reward, bonus, airdrop, visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
