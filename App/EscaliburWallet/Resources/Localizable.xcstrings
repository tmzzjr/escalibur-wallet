    "Segundo o indexador. A rede ainda não mostra esta transação" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفقًا للمفهرس. لا تُظهر الشبكة هذه المعاملة بعد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut Indexer. Das Netzwerk zeigt diese Transaktion noch nicht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "According to the indexer. The network doesn't show this transaction yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el indexador. La red aún no muestra esta transacción"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon l’indexeur. Le réseau n’affiche pas encore cette transaction"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंडेक्सर के अनुसार. नेटवर्क अभी यह ट्रांज़ैक्शन नहीं दिखाता"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menurut pengindeks. Jaringan belum menampilkan transaksi ini"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インデクサーの情報です。ネットワークにはまだこのトランザクションが表示されていません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인덱서 기준. 네트워크에는 아직 이 트랜잭션이 표시되지 않음"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndeksleyiciye göre. Ağ bu işlemi henüz göstermiyor"
