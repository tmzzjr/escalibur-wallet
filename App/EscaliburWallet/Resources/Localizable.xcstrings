        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko signale ce jeton par un avertissement"
          }
        }
      }
    },
    "O CoinGecko não respondeu agora, e sem ele a carteira não sabe em que rede esta moeda existe." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko didn't respond right now, and without it the wallet doesn't know which network this coin exists on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko no respondió ahora, y sin él la billetera no sabe en qué red existe esta moneda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko n’a pas répondu pour le moment, et sans lui le portefeuille ne sait pas sur quel réseau cette monnaie existe."
          }
        }
      }
    },
    "O CoinGecko não respondeu agora. Aparecem só as moedas verificadas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko didn't respond right now. Only verified coins are shown."
