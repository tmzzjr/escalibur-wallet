    "Parte das transações foi transmitida e parte não. Confira a Atividade antes de tentar de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم بث بعض المعاملات ولم يتم بث بعضها. تحقق من النشاط قبل المحاولة مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil der Transaktionen wurde übertragen, ein Teil nicht. Prüfe die Aktivität, bevor du es erneut versuchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the transactions were broadcast and some weren't. Check Activity before trying again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte de las transacciones se transmitió y otra no. Revisa la Actividad antes de intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie des transactions a été diffusée et une autre non. Consultez l’Activité avant de réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ ट्रांज़ैक्शन ब्रॉडकास्ट हुए और कुछ नहीं. फिर से कोशिश करने से पहले गतिविधि जांचें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebagian transaksi sudah disiarkan dan sebagian belum. Periksa Aktivitas sebelum mencoba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランザクションの一部はネットワークに送信され、一部は送信されませんでした。もう一度試す前に「アクティビティ」を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "트랜잭션 중 일부만 네트워크로 전송되었습니다. 다시 시도하기 전에 활동을 확인하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlemlerin bir kısmı yayınlandı, bir kısmı yayınlanmadı. Tekrar denemeden önce Etkinlik'i kontrol et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một số giao dịch đã được phát lên mạng, một số thì chưa. Hãy kiểm tra mục Hoạt động trước khi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分交易已广播，部分未广播。重试前请先查看“活动”。"
          }
        }
      }
    },
