        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Token-Konto wurde vom Emittenten eingefroren. Der Tausch würde nicht durchgehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The token account is frozen by the issuer. The swap wouldn't go through."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta de token está congelada por el emisor. El intercambio no pasaría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte de jeton est gelé par l’émetteur. L’échange ne passerait pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोकन खाते को जारीकर्ता ने फ़्रीज़ किया है. स्वैप नहीं हो पाएगा."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun token dibekukan oleh penerbit. Penukaran tidak akan berhasil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンアカウントは発行者によって凍結されています。スワップは成立しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰 계정이 발행자에 의해 동결되었습니다. 스왑이 이루어지지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token hesabı ihraççı tarafından dondurulmuş. Takas gerçekleşmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản token đang bị bên phát hành đóng băng. Hoán đổi sẽ không thành công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代币账户已被发行方冻结。兑换无法完成。"
          }
        }
      }
    },
    "A conta de token lida da rede não confere. Nada foi montado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساب الرمز المميز المقروء من الشبكة لا يتطابق. لم يتم تجهيز أي شيء."
