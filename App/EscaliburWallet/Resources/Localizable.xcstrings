    "Esta ordem abre a linha de %@: mais %@ presos enquanto a conta aceitar %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الأمر يفتح خط الثقة لـ %@: يُحجز %@ إضافي ما دام الحساب يقبل %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Order öffnet die %@-Trustline: weitere %@ gesperrt, solange das Konto %@ akzeptiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This order opens the %@ trustline: %@ more locked while the account accepts %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta orden abre la línea de confianza de %@: %@ más bloqueados mientras la cuenta acepte %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet ordre ouvre la ligne de confiance %@ : il bloque %@ de plus tant que le compte accepte %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ऑर्डर %1$@ की ट्रस्टलाइन खोलता है: जब तक खाता %3$@ स्वीकार करता है, %2$@ और लॉक रहता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Order ini membuka trustline %@: tambahan %@ terkunci selama akun bisa menerima %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この注文で %1$@ のトラストラインが開設されます：アカウントが %3$@ を受け入れている間、さらに %2$@ がロックされます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주문으로 %1$@ 트러스트라인이 열림: 계정이 %3$@ 토큰을 허용하는 동안 %2$@ 추가로 묶임"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Esta ordem abre a linha de %1$@: mais %2$@ presos enquanto a conta aceitar %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu emir %1$@ güven hattını açar: hesap %3$@ kabul ettiği sürece %2$@ daha kilitli kalır"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lệnh này mở trustline %@: thêm %@ bị khóa chừng nào tài khoản còn chấp nhận %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此订单会开通 %1$@ 信任线：账户接受 %3$@ 期间，将额外锁定 %2$@"
          }
        }
      }
    },
    "Esta ordem move o preço em %@%%. Dividir em ordens menores ajuda." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الأمر يحرّك السعر بنسبة %@%%. تقسيمه إلى أوامر أصغر يساعد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Order bewegt den Preis um %@ %%. Eine Aufteilung in kleinere Orders hilft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This order moves the price by %@%%. Splitting it into smaller orders helps."
          }
        },
        "es" : {
          "stringUnit" : {
