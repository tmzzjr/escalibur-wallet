          }
        }
      }
    },
    "O contrato a autorizar não existe nesta rede. Nada foi assinado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العقد المطلوب الموافقة له غير موجود على هذه الشبكة. لم يتم توقيع أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zu genehmigende Vertrag existiert in diesem Netzwerk nicht. Nichts wurde signiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The contract to approve doesn't exist on this network. Nothing was signed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contrato a autorizar no existe en esta red. No se firmó nada."
          }
