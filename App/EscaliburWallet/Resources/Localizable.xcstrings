        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người nhận chấp nhận %@ trên %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "收款方接受通过 %2$@ 发送的 %1$@"
          }
        }
      }
    },
    "Quem viu o seu PIN não abre o app nem envia nada sem o seu rosto." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من رأى PIN الخاص بك لا يستطيع فتح التطبيق ولا إرسال أي شيء بدون وجهك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer deine PIN gesehen hat, kann ohne dein Gesicht weder die App öffnen noch etwas senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone who saw your PIN can't open the app or send anything without your face."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien vio tu PIN no abre la app ni envía nada sin tu cara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un qui a vu votre PIN ne peut ni ouvrir l’app ni rien envoyer sans votre visage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिसने आपका PIN देखा है, वह आपके चेहरे के बिना न ऐप खोल सकता है, न कुछ भेज सकता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orang yang melihat PIN Anda tidak bisa membuka aplikasi atau mengirim apa pun tanpa wajah Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN を見られても、本人の顔がなければアプリを開くことも、何かを送ることもできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN을 본 사람도 내 얼굴 없이는 앱을 열거나 무엇도 보낼 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN'ini gören biri, yüzün olmadan uygulamayı açamaz ve hiçbir şey gönderemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người đã thấy PIN của bạn không thể mở ứng dụng hay gửi gì nếu không có khuôn mặt của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看过你 PIN 码的人，没有你的面容就无法打开 App，也无法发送任何东西。"
          }
        }
      }
    },
    "Quem viu só o seu PIN não abre o app nem envia nada sem o seu rosto." : {
      "localizations" : {
