          }
        }
      }
    },
    "A lista de moedas da conta veio repetida da rede. Por segurança, nada foi montado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network returned the account's coin list with duplicates. For safety, nothing was prepared."
