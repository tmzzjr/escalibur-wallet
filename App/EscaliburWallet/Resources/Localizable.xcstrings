          "stringUnit" : {
            "state" : "translated",
            "value" : "यहां Touch ID इस्तेमाल करने के लिए, iPhone सेटिंग्स में Touch ID और पासकोड के अंदर एक फ़िंगरप्रिंट जोड़ें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk memakai Touch ID di sini, tambahkan sidik jari di Pengaturan iPhone, di Touch ID & Kode Sandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで Touch ID を使うには、iPhone の設定の「Touch ID とパスコード」で指紋を登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 Touch ID를 사용하려면 iPhone 설정 > Touch ID 및 암호에서 지문을 추가하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada Touch ID kullanmak için iPhone Ayarları > Touch ID ve Parola bölümünden bir parmak izi ekle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để dùng Touch ID tại đây, hãy thêm vân tay trong Cài đặt iPhone, mục Touch ID & Mật mã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在这里使用 Touch ID，请在 iPhone“设置”>“Touch ID 与密码”中添加指纹。"
          }
        }
      }
    },
