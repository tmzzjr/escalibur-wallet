        }
      }
    },
    "%@ fica na conta: é o mínimo que a rede exige para ela existir." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى %@ في الحساب: إنه الحد الأدنى الذي تشترطه الشبكة لوجود الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bleiben auf dem Konto: Das ist das Minimum, das das Netzwerk für das Bestehen des Kontos verlangt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stays in the account: it's the minimum the network requires for the account to exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se queda en la cuenta: es el mínimo que la red exige para que exista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte garde %@ : c’est le minimum que le réseau exige pour qu’il existe."
