        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발행자는 내 계정을 포함한 모든 계정에서 이 토큰을 옮기거나 소각할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
