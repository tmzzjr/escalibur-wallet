    "Cada etapa é recotada só depois que a anterior confirmar, com o seu próprio mínimo garantido" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعاد تسعير كل مرحلة فقط بعد تأكيد المرحلة السابقة، مع حدها الأدنى المستلم الخاص بها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
