        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío preparado no coincide con el destino escrito. No se firmó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi préparé ne correspond pas à la destination saisie. Rien n’a été signé."
          }
        }
      }
    },
    "O envio montado não confere com o destino ou o comentário pedidos. Nada foi assinado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prepared transfer doesn't match the requested destination or comment. Nothing was signed."
