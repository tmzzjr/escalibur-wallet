            "value" : "Eine andere Transaktion dieses Kontos kam vor dieser durch. Prüfe erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another transaction from this account went in before this one. Review again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra transacción de esta cuenta entró antes que esta. Vuelve a revisar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre transaction de ce compte est passée avant celle-ci. Vérifiez à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खाते का कोई दूसरा ट्रांज़ैक्शन इससे पहले शामिल हो गया. फिर से रिव्यू करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaksi lain dari akun ini masuk lebih dulu. Tinjau lagi."
