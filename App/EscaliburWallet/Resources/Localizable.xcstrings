    "Saiu inteira, pelo mínimo garantido de %@ ou mais. O saldo novo aparece em instantes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُفّذ بالكامل، بالحد الأدنى المستلم البالغ %@ أو أكثر. يظهر الرصيد الجديد بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollständig ausgeführt, zum Mindestbetrag von %@ oder mehr. Das neue Guthaben erscheint gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fully executed, at the minimum received of %@ or more. The new balance appears in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecutó completa, al mínimo a recibir de %@ o más. El nuevo saldo aparece en unos instantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement exécuté, au minimum reçu de %@ ou plus. Le nouveau solde apparaît dans un instant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा एक्ज़ीक्यूट हुआ, न्यूनतम प्राप्त %@ या ज़्यादा पर. नया बैलेंस थोड़ी देर में दिखेगा."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tereksekusi penuh, pada minimum diterima %@ atau lebih. Saldo baru akan muncul sebentar lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全量約定しました（最低受取額 %@ 以上）。新しい残高はまもなく表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전부 체결되었습니다. 최소 수령액 %@ 이상으로 체결되었습니다. 새 잔액이 곧 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamı gerçekleşti, %@ veya daha fazla minimum alınacak tutarla. Yeni bakiye birazdan görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã khớp toàn bộ, ở mức nhận tối thiểu %@ trở lên. Số dư mới sẽ hiển thị sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已全部成交，不低于最少收到 %@。新余额即将显示。"
          }
        }
      }
    },
