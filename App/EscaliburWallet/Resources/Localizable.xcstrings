    "Enviar e receber já funcionam em todas as redes. A troca entra rede por rede, cada uma depois de passar pela validação de segurança." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإرسال والاستلام يعملان بالفعل على كل الشبكات. تُضاف المبادلة شبكةً تلو الأخرى، كلٌّ منها بعد اجتياز التحقق الأمني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senden und Empfangen funktionieren schon in allen Netzwerken. Tausch kommt Netzwerk für Netzwerk dazu, jeweils nach bestandener Sicherheitsprüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending and receiving already work on every network. Swaps are added network by network, each after passing security validation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar y recibir ya funcionan en todas las redes. El intercambio llega red por red, cada una después de pasar la validación de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi et la réception fonctionnent déjà sur tous les réseaux. L’échange arrive réseau par réseau, chacun après avoir passé la validation de sécurité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भेजना और प्राप्त करना सभी नेटवर्क पर पहले से काम करता है. स्वैप एक-एक नेटवर्क पर जोड़ा जा रहा है, हर नेटवर्क सुरक्षा जांच पास करने के बाद."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim dan terima sudah berfungsi di semua jaringan. Penukaran ditambahkan per jaringan, masing-masing setelah lolos validasi keamanan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信と受け取りはすべてのネットワークで利用できます。スワップは、セキュリティ検証を通過したネットワークから順に追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내기와 받기는 이미 모든 네트워크에서 작동합니다. 스왑은 보안 검증을 통과한 네트워크부터 하나씩 추가됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gönderme ve alma tüm ağlarda zaten çalışıyor. Takas, her ağ güvenlik doğrulamasından geçtikçe ağ ağ ekleniyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi và nhận đã hoạt động trên mọi mạng. Hoán đổi được bổ sung theo từng mạng, mỗi mạng sau khi vượt qua bước thẩm định bảo mật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有网络都已支持发送和接收。兑换功能会逐个网络上线，每个网络都要先通过安全验证。"
          }
        }
      }
    },
    "Enviar só o livre, %@" : {
      "localizations" : {
        "ar" : {
