          "stringUnit" : {
            "state" : "translated",
            "value" : "Este sobre se selló vinculado al iPhone que lo creó y solo se abre en la app Escalibur de ese dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
