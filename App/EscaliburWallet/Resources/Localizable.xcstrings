    " Este envio também cria a conta de destino." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " هذا التحويل ينشئ حساب الوجهة أيضًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Dieser Transfer erstellt auch das Zielkonto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " This transfer also creates the destination account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Este envío también crea la cuenta de destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Cet envoi crée aussi le compte de destination."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " यह ट्रांसफ़र डेस्टिनेशन खाता भी बनाता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Pengiriman ini juga membuat akun tujuan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " この送金で宛先アカウントも作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 이 전송으로 받는 계정도 함께 생성됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Bu transfer hedef hesabı da oluşturur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Lần gửi này cũng tạo tài khoản đích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 此笔转账还会创建目标账户。"
          }
        }
      }
    },
