    "Preços e dados de mercado: CoinGecko, com CoinPaprika e OKX de reserva. Os saldos e as transações vêm direto das redes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسعار وبيانات السوق: CoinGecko، مع CoinPaprika وOKX كاحتياط. الأرصدة والمعاملات تأتي مباشرة من الشبكات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preise und Marktdaten: CoinGecko, mit CoinPaprika und OKX als Reserve. Guthaben und Transaktionen kommen direkt aus den Netzwerken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices and market data: CoinGecko, with CoinPaprika and OKX as backups. Balances and transactions come directly from the networks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precios y datos de mercado: CoinGecko, con CoinPaprika y OKX de respaldo. Los saldos y las transacciones vienen directo de las redes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix et données de marché : CoinGecko, avec CoinPaprika et OKX en secours. Les soldes et les transactions viennent directement des réseaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीमतें और मार्केट डेटा: CoinGecko, बैकअप के तौर पर CoinPaprika और OKX. बैलेंस और ट्रांज़ैक्शन सीधे नेटवर्क से आते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga dan data pasar: CoinGecko, dengan CoinPaprika dan OKX sebagai cadangan. Saldo dan transaksi berasal langsung dari jaringan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格とマーケットデータ：CoinGecko（予備として CoinPaprika と OKX）。残高とトランザクションは、ネットワークから直接取得します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격 및 시장 데이터: CoinGecko(예비로 CoinPaprika와 OKX). 잔액과 거래는 네트워크에서 직접 가져옵니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatlar ve piyasa verileri: CoinGecko; yedek olarak CoinPaprika ve OKX. Bakiyeler ve işlemler doğrudan ağlardan gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá và dữ liệu thị trường: CoinGecko, với CoinPaprika và OKX làm nguồn dự phòng. Số dư và giao dịch lấy trực tiếp từ các mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
