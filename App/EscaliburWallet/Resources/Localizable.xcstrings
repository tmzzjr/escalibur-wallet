        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sobre toma las palabras de tu billetera y lo cierra todo con una contraseña que tú eliges. El resultado es un archivo .esclbr."
          }
        }
      }
    },
    "O envio montado não confere com o destino digitado. Nada foi assinado." : {
