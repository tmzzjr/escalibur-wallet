            "value" : "CoinGecko hat um eine Pause gebeten. Warte auf Freigabe, um die Netzwerke für %@ zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoinGecko asked for a pause. Waiting to be allowed to read the networks for %@."
