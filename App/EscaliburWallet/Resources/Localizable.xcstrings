    "Depois de enviar, a resposta do suporte chega no seu e-mail." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you send it, the support reply arrives in your email."
          }
        }
      }
    },
    "Depois de reiniciar o iPhone ou de a bateria acabar, o %@ só volta a valer depois do PIN digitado uma vez." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إعادة تشغيل iPhone أو نفاد البطارية، لا يعمل %@ مجددًا إلا بعد إدخال PIN مرة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Neustart des iPhone oder bei leerem Akku funktioniert %@ erst wieder, wenn du einmal die PIN eingegeben hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the iPhone restarts or the battery runs out, %@ only works again once you've entered the PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de reiniciar el iPhone o de que se agote la batería, %@ solo vuelve a funcionar después de escribir el PIN una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un redémarrage de l’iPhone ou une batterie épuisée, %@ ne fonctionne à nouveau qu’une fois le PIN saisi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone रीस्टार्ट होने या बैटरी खत्म होने के बाद, %@ तभी फिर से काम करता है जब आप एक बार PIN डालें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah iPhone dinyalakan ulang atau baterainya habis, %@ baru berfungsi lagi setelah PIN dimasukkan sekali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone の再起動後やバッテリー切れの後は、PIN を一度入力するまで %@ は使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 재시동하거나 배터리가 방전된 후에는 PIN을 한 번 입력해야 %@를 다시 사용할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone yeniden başladıktan veya pili bittikten sonra %@, PIN bir kez girilene kadar çalışmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi iPhone khởi động lại hoặc hết pin, %@ chỉ hoạt động trở lại sau khi bạn nhập PIN một lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 重启或电池耗尽后，需要先输入一次 PIN 码，%@ 才能再次使用。"
          }
        }
      }
    },
    "Depois deste envio sobrariam %@ na conta, abaixo do mínimo de %@ que a rede aceita. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد هذا التحويل، سيبقى %@ في الحساب، وهو أقل من الحد الأدنى للشبكة البالغ %@. %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach diesem Transfer blieben %@ auf dem Konto, unter dem Minimum von %@, das das Netzwerk akzeptiert. %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After this transfer, %@ would be left in the account, below the network's minimum of %@. %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de este envío quedarían %@ en la cuenta, por debajo del mínimo de %@ que acepta la red. %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après cet envoi, il resterait %@ sur le compte, sous le minimum de %@ accepté par le réseau. %@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस ट्रांसफ़र के बाद खाते में %@ बचेगा, जो नेटवर्क के न्यूनतम %@ से कम है. %@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah pengiriman ini, akan tersisa %@ di akun, di bawah minimum %@ yang diterima jaringan. %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この送金後にアカウントに残るのは %@ で、ネットワークが認める最低額 %@ を下回ります。%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 전송 후 계정에 %@ 금액이 남아, 네트워크가 허용하는 최소 금액 %@보다 적어집니다. %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Depois deste envio sobrariam %1$@ na conta, abaixo do mínimo de %2$@ que a rede aceita. %3$@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu transferden sonra hesapta %@ kalır; bu, ağın kabul ettiği %@ minimumunun altında. %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau lần gửi này, tài khoản sẽ còn %@, thấp hơn mức tối thiểu %@ mà mạng chấp nhận. %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此笔转账后账户将剩余 %@，低于网络接受的最低值 %@。%@"
          }
        }
      }
    },
    "Depois do PIN, o %@ confirma que é você." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد PIN، يتأكد %@ من أنك أنت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach der PIN bestätigt %@, dass du es bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After the PIN, %@ confirms it's you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después del PIN, %@ confirma que eres tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le PIN, %@ confirme que c’est bien vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN के बाद, %@ पुष्टि करता है कि यह आप ही हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah PIN, %@ memastikan bahwa ini memang Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN の入力後、%@ で本人であることを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN 입력 후 %@ 인증으로 본인임을 확인합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PIN'den sonra %@ sen olduğunu doğrular."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau PIN, %@ xác nhận đó đúng là bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入 PIN 码后，%@ 会确认是你本人。"
          }
        }
      }
    },
    "Depois, o PIN e o %@ duas vezes: uma para abrir, outra para conferir o modo novo antes de valer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد ذلك، PIN و%@ مرتين: مرة للفتح، ومرة للتحقق من الوضع الجديد قبل أن يسري."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach zweimal PIN und %@: einmal zum Öffnen, einmal, um den neuen Modus zu prüfen, bevor er gilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next, your PIN and %@ twice: once to open, and once to check the new mode before it takes effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después, el PIN y %@ dos veces: una para abrir y otra para comprobar el modo nuevo antes de que entre en vigor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensuite, le PIN et %@ deux fois : une pour ouvrir, une autre pour vérifier le nouveau mode avant qu’il ne s’applique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बाद, PIN और %@ दो बार: एक बार खोलने के लिए, और एक बार नया मोड लागू होने से पहले उसे जांचने के लिए."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lalu, PIN dan %@ dua kali: sekali untuk membuka, sekali lagi untuk memeriksa mode baru sebelum berlaku."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その後、PIN と %@ が 2 回必要です。1 回目は開くため、2 回目は新しいモードが有効になる前に確認するためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그다음 PIN과 %@ 인증을 두 번 합니다. 한 번은 열기 위해, 한 번은 새 모드가 적용되기 전에 확인하기 위해서입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ardından PIN ve %@ iki kez: biri açmak, diğeri yeni modu geçerli olmadan önce kontrol etmek için."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau đó, PIN và %@ hai lần: một lần để mở, một lần để kiểm tra chế độ mới trước khi có hiệu lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后需要两次验证 PIN 码和 %@：一次用于打开，另一次用于在新模式生效前进行核对。"
          }
        }
      }
    },
