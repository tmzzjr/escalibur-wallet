    "Tenha em mãos a senha de cada carteira (as 12 ou 24 palavras) ou o envelope Escalibur, e a passphrase de cada carteira que usa passphrase." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهّز عبارة الاسترداد لكل محفظة (الكلمات الـ12 أو الـ24) أو مغلف Escalibur، وpassphrase لكل محفظة تستخدمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Wiederherstellungsphrase jedes Wallets (die 12 oder 24 Wörter) oder den Escalibur-Umschlag bereit, dazu die Passphrase jedes Wallets, das eine nutzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Have each wallet's recovery phrase (the 12 or 24 words) or the Escalibur Envelope at hand, plus the passphrase of each wallet that uses one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten a mano la frase de recuperación de cada billetera (las 12 o 24 palabras) o el sobre Escalibur, y la passphrase de cada billetera que la usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayez sous la main la phrase de récupération de chaque portefeuille (les 12 ou 24 mots) ou l’enveloppe Escalibur, et la passphrase de chaque portefeuille qui en utilise une."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर वॉलेट का रिकवरी फ़्रेज़ (12 या 24 शब्द) या Escalibur लिफ़ाफ़ा तैयार रखें, और पासफ़्रेज़ इस्तेमाल करने वाले हर वॉलेट का पासफ़्रेज़ भी."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siapkan frasa pemulihan setiap dompet (12 atau 24 kata) atau Amplop Escalibur, serta passphrase setiap dompet yang memakai passphrase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ウォレットのリカバリーフレーズ（12 または 24 個の単語）か Escalibur エンベロープと、パスフレーズを使う各ウォレットのパスフレーズを用意してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 지갑의 복구 구문(12개 또는 24개 단어)이나 Escalibur 봉투, 그리고 패스프레이즈를 사용하는 각 지갑의 패스프레이즈를 준비하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her cüzdanın kurtarma ifadesini (12 veya 24 kelime) ya da Escalibur Zarfı'nı ve passphrase kullanan her cüzdanın passphrase'ini hazır bulundur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy chuẩn bị sẵn cụm từ khôi phục của từng ví (12 hoặc 24 từ) hoặc Phong bì Escalibur, cùng passphrase của từng ví có dùng passphrase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请准备好各钱包的助记词（那 12 或 24 个单词）或 Escalibur 信封，以及每个使用 passphrase 的钱包的 passphrase。"
          }
        }
      }
    },
