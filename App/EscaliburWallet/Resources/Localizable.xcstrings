    "%@ um comentário ou memo, cole aqui exatamente igual. Para uma carteira pessoal, deixe vazio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ تعليقًا أو مذكرة، فالصقه هنا كما هو تمامًا. إذا كان الإرسال إلى محفظة شخصية، فاتركه فارغًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ einen Kommentar oder ein Memo bekommen hast, füge es hier genau so ein. Für ein persönliches Wallet lass das Feld leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a comment or memo, paste it here exactly as given. For a personal wallet, leave this empty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ un comentario o memo, pégalo aquí exactamente igual. Para una billetera personal, déjalo vacío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ un commentaire ou un mémo, collez-le ici exactement à l’identique. Pour un portefeuille personnel, laissez vide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कोई कमेंट या मेमो दिया है, तो उसे यहां बिल्कुल वैसा ही पेस्ट करें. निजी वॉलेट के लिए इसे खाली छोड़ें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ komentar atau memo, tempel di sini persis sama. Untuk dompet pribadi, biarkan kosong."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@コメントまたはメモが指定された場合は、そのまま正確にここに貼り付けてください。個人のウォレットの場合は空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 코멘트나 메모를 받았다면 여기에 그대로 붙여 넣으세요. 개인 지갑으로 보낸다면 비워 두세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir yorum veya memo verdiyse, buraya aynen yapıştır. Kişisel bir cüzdan için boş bırak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ một bình luận hoặc memo, hãy dán vào đây đúng y như vậy. Với ví cá nhân, hãy để trống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@备注或 Memo，请原样粘贴到这里。如果是个人钱包，请留空。"
          }
        }
      }
    },
