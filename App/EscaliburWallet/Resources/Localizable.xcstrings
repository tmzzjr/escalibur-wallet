        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटा जांचने के लिए काफ़ी प्रोवाइडर ने जवाब नहीं दिया. थोड़ी देर में फिर से कोशिश करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
