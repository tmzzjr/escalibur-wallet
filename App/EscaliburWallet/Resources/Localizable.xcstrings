    "Enviar e receber já funcionam em todas as redes. A troca entra rede por rede, cada uma depois de passar pela validação de segurança." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sending and receiving already work on every network. Swaps are added network by network, each after passing security validation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar y recibir ya funcionan en todas las redes. El intercambio llega red por red, cada una después de pasar la validación de seguridad."
          }
        }
      }
    },
    "Enviar só o livre, %@" : {
      "localizations" : {
        "en" : {
