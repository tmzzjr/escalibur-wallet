    "Esquecer a passphrase é perder o que estiver nesta carteira. Ninguém recupera, nem a Escalibur." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgetting the passphrase means losing whatever is in this wallet. No one can recover it, not even Escalibur."
          }
        },
