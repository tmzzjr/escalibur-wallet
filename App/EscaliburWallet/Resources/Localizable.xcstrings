    "A tela está sendo gravada ou espelhada. Pare a gravação ou o AirPlay para seguir." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تسجيل الشاشة أو عكسها. أوقف التسجيل أو AirPlay للمتابعة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bildschirm wird aufgenommen oder gespiegelt. Beende die Aufnahme oder AirPlay, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
