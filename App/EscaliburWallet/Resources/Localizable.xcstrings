        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspicious"
          }
        }
      }
    },
    "São %lld transações, uma por provedor, confirmadas com um único %@. Cada parte é independente: se uma não passar, você fica com o que foi trocado, e o saldo daquela parte continua na sua carteira." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are %lld transactions, one per provider, confirmed with a single %@. Each part is independent: if one doesn't go through, you keep what was swapped, and the balance for that part stays in your wallet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "São %1$lld transações, uma por provedor, confirmadas com um único %2$@. Cada parte é independente: se uma não passar, você fica com o que foi trocado, e o saldo daquela parte continua na sua carteira."
          }
        }
