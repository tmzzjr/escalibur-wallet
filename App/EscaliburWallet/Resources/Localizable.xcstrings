        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크가 알려 준 USDT 지갑이 이 계정의 것이 아닙니다. 아무것도 준비되지 않았습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
