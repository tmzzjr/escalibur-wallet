    "Desta carteira você vê saldo e histórico. Enviar e trocar ficam desligados." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في هذه المحفظة ترى الرصيد والسجل. الإرسال والمبادلة متوقفان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesem Wallet siehst du Guthaben und Verlauf. Senden und Tauschen sind ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For this wallet you can see the balance and history. Sending and swapping are turned off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De esta billetera ves el saldo y el historial. Enviar e intercambiar están desactivados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ce portefeuille, vous voyez le solde et l’historique. L’envoi et l’échange sont désactivés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वॉलेट का बैलेंस और हिस्ट्री आप देख सकते हैं. भेजना और स्वैप करना बंद है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk dompet ini Anda bisa melihat saldo dan riwayat. Kirim dan tukar dinonaktifkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウォレットでは残高と履歴を確認できます。送信とスワップはオフになっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지갑은 잔액과 내역만 볼 수 있습니다. 보내기와 스왑은 꺼져 있습니다."
