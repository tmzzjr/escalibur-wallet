    "%@ A conta tem %@, menos que isso. Envie TON para esta conta antes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ The account has %@, less than that. Send TON to this account first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ La cuenta tiene %@, menos que eso. Envía TON a esta cuenta primero."
