          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respons jaringan tidak cocok dengan transaksi yang ditandatangani. Periksa Aktivitas sebelum mengirim lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークの応答が署名済みトランザクションと一致しません。もう一度送信する前に「アクティビティ」を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "네트워크 응답이 서명된 트랜잭션과 일치하지 않습니다. 다시 보내기 전에 활동을 확인하세요."
          }
        },
        "tr" : {
