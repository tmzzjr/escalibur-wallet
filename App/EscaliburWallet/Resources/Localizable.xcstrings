    },
    "O envio montado não confere com o destino pedido. Nada foi assinado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prepared transfer doesn't match the requested destination. Nothing was signed."
          }
