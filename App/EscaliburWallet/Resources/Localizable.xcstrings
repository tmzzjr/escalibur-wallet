        }
      }
    },
    "Segundo o indexador. Chegou por transação interna, que o recibo não mostra" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفقًا للمفهرس. وصل عبر معاملة داخلية لا يُظهرها الإيصال"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laut Indexer. Kam über eine interne Transaktion, die der Beleg nicht zeigt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "According to the indexer. It arrived through an internal transaction, which the receipt doesn't show"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el indexador. Llegó por una transacción interna, que el recibo no muestra"
          }
        },
