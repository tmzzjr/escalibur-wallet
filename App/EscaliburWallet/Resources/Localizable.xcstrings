            "value" : "署名済みの注文は CoW に直接送られます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명된 주문은 CoW로 바로 전송됨"
          }
        },
        "tr" : {
          "stringUnit" : {
