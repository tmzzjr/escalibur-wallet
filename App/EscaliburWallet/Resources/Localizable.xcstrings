    "Nenhum: %@ que sobraria fica abaixo do mínimo que vale guardar e vai para a taxa" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد: %@ المتبقي أقل من الحد الأدنى الذي يستحق الاحتفاظ به ويذهب إلى الرسوم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keines: Der Rest von %@ liegt unter dem Minimum, das sich zu behalten lohnt, und geht in die Gebühr"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None: the %@ left over is below the minimum worth keeping and goes to the fee"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno: el sobrante de %@ queda por debajo del mínimo que vale la pena guardar y va a la comisión"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune : le reste de %@ est sous le minimum utile à conserver et part dans les frais"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई नहीं: बचने वाला %@ रखने लायक न्यूनतम से कम है और शुल्क में चला जाता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada: sisa %@ di bawah minimum yang layak disimpan dan masuk ke biaya"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なし：残るはずの %@ は保管する価値のある最低額を下回るため、手数料に回ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "없음: 남을 %@ 금액은 보관할 가치가 있는 최소 금액보다 적어 수수료로 들어감"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yok: artacak %@, saklamaya değecek minimumun altında kalır ve ücrete gider"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có: %@ còn dư thấp hơn mức tối thiểu đáng giữ lại nên được cộng vào phí"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无：剩余的 %@ 低于值得保留的最低金额，将计入手续费"
          }
        }
      }
    },
    "Nenhum: envia tudo o que as moedas escolhidas pagam; %@ de fora" : {
      "localizations" : {
