    },
    "A palavra %lld não está na lista em inglês. Toque nela para corrigir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word %lld isn't on the English list. Tap it to fix it."
          }
        }
      }
    },
    "A palavra %lld não existe na lista. Confira no papel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكلمة رقم %lld غير موجودة في القائمة. تحقق من الورقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wort %lld steht nicht auf der Liste. Prüfe dein Papier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Word %lld isn't on the list. Check your paper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La palabra %lld no está en la lista. Revísala en el papel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
