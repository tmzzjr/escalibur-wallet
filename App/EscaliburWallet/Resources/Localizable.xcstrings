    "Toque numa posição e digite a palavra. Ninguém da Escalibur pede estas palavras." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على موضع واكتب الكلمة. لا أحد من Escalibur يطلب هذه الكلمات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Position und gib das Wort ein. Niemand von Escalibur fragt nach diesen Wörtern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a position and type the word. No one from Escalibur asks for these words."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una posición y escribe la palabra. Nadie de Escalibur pide estas palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une position et saisissez le mot. Personne chez Escalibur ne demande ces mots."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी स्थान पर टैप करें और शब्द टाइप करें. Escalibur से कोई भी ये शब्द नहीं मांगता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk sebuah posisi dan ketik katanya. Tidak ada pihak Escalibur yang meminta kata-kata ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置をタップして単語を入力してください。Escalibur がこれらの単語を求めることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 탭하고 단어를 입력하세요. Escalibur는 이 단어를 절대 요청하지 않습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
