    "XRP livre insuficiente para este valor mais a taxa. A reserva da conta fica presa pela rede." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد XRP حر كافٍ لهذا المبلغ مع الرسوم. تحتجز الشبكة احتياطي الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug freies XRP für diesen Betrag plus Gebühr. Die Kontoreserve ist vom Netzwerk gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough free XRP for this amount plus the fee. The account reserve is locked by the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XRP libre insuficiente para esta cantidad más la comisión. La reserva de la cuenta queda bloqueada por la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez de XRP disponibles pour ce montant plus les frais. La réserve du compte est bloquée par le réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस राशि और शुल्क के लिए उपलब्ध XRP काफ़ी नहीं है. खाते का रिज़र्व नेटवर्क लॉक रखता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "XRP bebas tidak cukup untuk jumlah ini ditambah biaya. Cadangan akun dikunci oleh jaringan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この金額と手数料に対して、利用可能な XRP が不足しています。アカウントのリザーブはネットワークによってロックされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수수료를 포함한 이 금액에 쓸 수 있는 XRP가 부족합니다. 계정 준비금은 네트워크에 묶여 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu tutar ve ücret için serbest XRP yetersiz. Hesap rezervi ağ tarafından kilitlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không đủ XRP khả dụng cho số tiền này cộng phí. Khoản dự trữ của tài khoản bị mạng khóa."
