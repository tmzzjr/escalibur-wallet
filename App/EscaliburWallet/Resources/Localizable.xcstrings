          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "견적 이후 가격 영향이 커졌습니다. 견적을 새로고침하고 다시 확인하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyat etkisi tekliften bu yana arttı. Teklifi yenile ve yeniden onayla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tác động giá đã tăng kể từ lúc báo giá. Hãy làm mới báo giá và xác nhận lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自报价以来价格影响已上升。请刷新报价并再次确认。"
          }
        }
      }
    },
    "O indexador público da %@ está recusando pedidos de aplicativos agora. O histórico dela fica no explorador." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفهرس العام لـ %@ يرفض طلبات التطبيقات الآن. السجل متاح في مستكشف الكتل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der öffentliche Indexer für %@ lehnt gerade Anfragen von Apps ab. Der Verlauf ist im Block-Explorer verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
