    "Muitas consultas seguidas. Espere alguns segundos e tente de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبات كثيرة متتالية. انتظر بضع ثوانٍ وحاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Anfragen hintereinander. Warte ein paar Sekunden und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many requests in a row. Wait a few seconds and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiadas consultas seguidas. Espera unos segundos e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de requêtes d’affilée. Attendez quelques secondes et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार बहुत ज़्यादा अनुरोध. कुछ सेकंड रुकें और फिर से कोशिश करें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak permintaan beruntun. Tunggu beberapa detik dan coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連続した問い合わせが多すぎます。数秒待ってから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연속 요청이 너무 많습니다. 몇 초 기다린 후 다시 시도하세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Art arda çok fazla istek. Birkaç saniye bekle ve tekrar dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều yêu cầu liên tiếp. Hãy chờ vài giây rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连续请求过多。请等待几秒后重试。"
          }
        }
      }
    },
    "Muitas passphrases erradas. Tente de novo às %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many wrong passphrases. Try again at %@."
          }
        }
      }
    },
    "Muitas tentativas de voz seguidas. As operações que pedem voz voltam às %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محاولات صوتية كثيرة متتالية. ستتاح العمليات التي تتطلب الصوت مجددًا في الساعة %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Sprachversuche hintereinander. Aktionen mit Sprachbestätigung sind ab %@ wieder verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too many voice attempts in a row. Actions that require voice will be available again at %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos de voz seguidos. Las operaciones que piden voz vuelven a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives vocales d’affilée. Les opérations qui demandent la voix seront à nouveau disponibles à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगातार बहुत ज़्यादा वॉइस कोशिशें. वॉइस वाली कार्रवाइयां %@ बजे फिर से उपलब्ध होंगी."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu banyak percobaan suara beruntun. Tindakan yang memerlukan suara tersedia lagi pukul %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声の試行が続けて多すぎました。音声が必要な操作は %@ に再び利用できるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 시도가 연속으로 너무 많았습니다. 음성이 필요한 작업은 %@에 다시 사용할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Art arda çok fazla sesli deneme yapıldı. Ses gerektiren işlemler saat %@ itibarıyla yeniden kullanılabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá nhiều lần thử giọng nói liên tiếp. Các thao tác cần giọng nói sẽ khả dụng lại lúc %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连续语音尝试次数过多。需要语音的操作将于 %@ 恢复。"
          }
        }
      }
    },
    "Muito fraca. Quem pegar o arquivo abre em %@." : {
