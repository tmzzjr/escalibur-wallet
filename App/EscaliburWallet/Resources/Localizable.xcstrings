    "Você escolhe a senha que abre o arquivo. Ela não sai do iPhone e ninguém mais sabe." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wählst das Passwort, das die Datei öffnet. Es verlässt das iPhone nie, und niemand sonst kennt es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You choose the password that opens the file. It never leaves the iPhone and no one else knows it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eliges la contraseña que abre el archivo. No sale del iPhone y nadie más la sabe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous choisissez le mot de passe qui ouvre le fichier. Il ne quitte jamais l’iPhone et personne d’autre ne le connaît."
          }
        }
      }
    },
    "Você fez uma captura de tela" : {
      "localizations" : {
        "ar" : {
