        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hợp đồng cần phê duyệt không tồn tại trên mạng này. Chưa có gì được ký."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要授权的合约在此网络上不存在。未签署任何内容。"
          }
        }
      }
    },
