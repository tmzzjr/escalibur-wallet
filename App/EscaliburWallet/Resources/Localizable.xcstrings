        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sin internet no está disponible en este iPhone ahora. Suele estar disponible cuando añades un teclado en %@ en los Ajustes del iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance en %@ hors connexion n’est pas disponible sur cet iPhone pour le moment. Elle le devient généralement quand vous ajoutez un clavier %@ dans les Réglages de l’iPhone."
