    "Forte. Nem um governo abre em tempo útil." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوية. حتى الحكومة لا تستطيع فتحه في وقت مجدٍ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stark. Nicht einmal ein Staat öffnet ihn in absehbarer Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strong. Not even a government could open it in a useful amount of time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuerte. Ni un gobierno la abre en un tiempo útil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fort. Même un gouvernement ne l’ouvrirait pas en un temps utile."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मज़बूत. कोई सरकार भी इसे काम के समय में नहीं खोल सकती."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuat. Bahkan pemerintah pun tidak bisa membukanya dalam waktu yang wajar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強い。政府機関でも現実的な時間では開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강함. 정부 기관도 현실적인 시간 안에 열 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güçlü. Bir devlet bile makul sürede açamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mạnh. Ngay cả một chính phủ cũng không mở được trong thời gian hữu ích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强。即使是政府机构也无法在有效时间内破解。"
          }
        }
      }
    },
    "Fraca. Um grupo com placas de vídeo abre em %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضعيفة. يمكن لمجموعة تملك بطاقات رسوميات فتحه خلال %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwach. Eine Gruppe mit Grafikkarten öffnet ihn in %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weak. A group with graphics cards could open it in %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débil. Un grupo con tarjetas gráficas la abre en %@."
