            "state" : "translated",
            "value" : "Aucun : regrouper les monnaies restitue plus de stockage que l’envoi ne coûte"
          }
        }
      }
    },
    "Nenhuma; o que vier acima da estimativa fica com a Velora" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
