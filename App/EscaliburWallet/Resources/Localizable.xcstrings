          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phong bì này được niêm phong gắn với iPhone đã tạo ra nó và chỉ mở được trong ứng dụng Escalibur trên thiết bị đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
