          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas disponible pour le moment. Vérifiez qu’il est activé pour Escalibur dans les Réglages de l’iPhone, puis réessayez. Avec la recopie de l’iPhone, cela ne fonctionne pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ अभी उपलब्ध नहीं है. जांचें कि iPhone सेटिंग्स में यह Escalibur के लिए चालू है, और फिर से कोशिश करें. iPhone मिररिंग से यह काम नहीं करता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak tersedia saat ini. Periksa apakah fitur ini aktif untuk Escalibur di Pengaturan iPhone, lalu coba lagi. Ini tidak berfungsi melalui Pencerminan iPhone."
          }
