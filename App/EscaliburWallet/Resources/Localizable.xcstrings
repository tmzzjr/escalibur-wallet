        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver est activé et lit les mots à voix haute. Utilisez des écouteurs."
          }
        }
      }
    },
    "O andamento da ordem não está disponível nesta rede." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Order progress isn't available on this network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
