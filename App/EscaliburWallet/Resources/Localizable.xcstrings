    "Leva %@, e cada tentativa custa o mesmo para quem tentar adivinhar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستغرق ذلك %@، وكل محاولة تكلّف الشيء نفسه لأي شخص يحاول التخمين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dauert %@, und jeder Versuch kostet jeden, der zu raten versucht, genauso viel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It takes %@, and each attempt costs the same for anyone trying to guess."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarda %@, y cada intento cuesta lo mismo a quien intente adivinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela prend %@, et chaque tentative coûte autant à quiconque essaie de deviner."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें %@ लगते हैं, और अंदाज़ा लगाने की कोशिश करने वाले हर व्यक्ति को हर कोशिश पर इतना ही समय लगता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memerlukan %@, dan setiap percobaan memakan waktu yang sama bagi siapa pun yang mencoba menebak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ かかります。推測しようとする人にとっても、1 回の試行に同じ時間がかかります。"
