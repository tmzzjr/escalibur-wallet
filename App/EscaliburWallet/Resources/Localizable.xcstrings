    "Taxa máxima da rede: %@. A rede cobra só o gas usado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأقصى لرسوم الشبكة: %@. لا تتقاضى الشبكة إلا الغاز المستخدم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Netzwerkgebühr: %@. Das Netzwerk berechnet nur das genutzte Gas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum network fee: %@. The network only charges the gas used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comisión de red máxima: %@. La red solo cobra el gas usado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frais de réseau maximaux : %@. Le réseau ne facture que le gaz utilisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिकतम नेटवर्क शुल्क: %@. नेटवर्क सिर्फ़ इस्तेमाल हुआ गैस लेता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biaya jaringan maksimum: %@. Jaringan hanya memungut gas yang terpakai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大ネットワーク手数料：%@。ネットワークが請求するのは使用したガス代だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최대 네트워크 수수료: %@. 네트워크는 사용한 가스만 청구합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimum ağ ücreti: %@. Ağ yalnızca kullanılan gas'ı alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phí mạng tối đa: %@. Mạng chỉ tính phần gas đã dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高网络费：%@。网络只收取实际使用的 Gas。"
          }
        }
      }
    },
    "Taxa máxima da rede: %@. O que não for usado volta para a conta." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأقصى لرسوم الشبكة: %@. ما لا يُستخدم يعود إلى الحساب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximale Netzwerkgebühr: %@. Ungenutztes geht zurück an das Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum network fee: %@. Whatever isn't used returns to the account."
          }
        },
        "es" : {
          "stringUnit" : {
