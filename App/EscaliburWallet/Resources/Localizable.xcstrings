    "Nenhuma cotação passou na conferência de segurança da carteira. Nada foi assinado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يجتز أي عرض سعر فحص الأمان في المحفظة. لم يتم توقيع أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Angebot hat die Sicherheitsprüfung des Wallets bestanden. Nichts wurde signiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No quote passed the wallet's security check. Nothing was signed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna cotización pasó la comprobación de seguridad de la billetera. No se firmó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune cotation n’a passé le contrôle de sécurité du portefeuille. Rien n’a été signé."
          }
