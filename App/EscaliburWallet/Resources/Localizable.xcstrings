    "%@ com este contrato já está na lista verificada. Ele aparece sozinho na Carteira quando houver saldo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ بهذا العقد موجود بالفعل في القائمة الموثّقة. يظهر في المحفظة تلقائيًا عندما يكون له رصيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mit diesem Vertrag steht bereits auf der verifizierten Liste. Er erscheint von selbst in Wallet, sobald ein Guthaben da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ with this contract is already on the verified list. It shows up in Wallet on its own when there's a balance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ con este contrato ya está en la lista verificada. Aparece automáticamente en Billetera cuando haya saldo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ avec ce contrat figure déjà dans la liste vérifiée. Il apparaît tout seul dans Portefeuille dès qu’il y a un solde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस कॉन्ट्रैक्ट वाला %@ पहले से वेरिफ़ाइड सूची में है. बैलेंस होने पर यह वॉलेट में अपने आप दिखता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dengan kontrak ini sudah ada di daftar terverifikasi. Token ini muncul sendiri di Dompet saat ada saldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコントラクトの %@ はすでに検証済みリストにあります。残高があれば「ウォレット」に自動で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컨트랙트의 %@ 토큰은 이미 검증된 목록에 있습니다. 잔액이 생기면 지갑에 자동으로 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kontrata sahip %@ zaten doğrulanmış listede. Bakiye olduğunda Cüzdan'da kendiliğinden görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ với hợp đồng này đã có trong danh sách đã xác minh. Token sẽ tự hiển thị trong Ví khi có số dư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
