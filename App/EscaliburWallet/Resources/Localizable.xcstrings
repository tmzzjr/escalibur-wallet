    "%@ ficam presos pelo armazenamento da conta na rede e ficam fora do máximo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ محجوز لتخزين بيانات الحساب على الشبكة ولا يُحتسب في الحد الأقصى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sind für den Speicher des Kontos im Netzwerk gesperrt und zählen nicht zum Maximum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is locked for the account's storage on the network and is left out of the maximum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ están bloqueados por el almacenamiento de la cuenta en la red y quedan fuera del máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stockage du compte sur le réseau bloque %@, qui n’entre pas dans le maximum."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क पर खाते के स्टोरेज के लिए %@ लॉक है और अधिकतम में शामिल नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terkunci untuk penyimpanan akun di jaringan dan tidak dihitung dalam jumlah maksimum."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はネットワーク上のアカウントのストレージ用にロックされているため、最大額に含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 금액은 네트워크의 계정 저장 공간용으로 묶여 있어 최대 금액에서 제외됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
