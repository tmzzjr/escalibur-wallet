    "O impacto no preço subiu desde a cotação. Atualize a cotação e confirme de novo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتفع تأثير السعر منذ عرض السعر. حدّث عرض السعر وأكّد مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Preiswirkung ist seit dem Angebot gestiegen. Aktualisiere das Angebot und bestätige erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The price impact went up since the quote. Refresh the quote and confirm again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El impacto en el precio subió desde la cotización. Actualiza la cotización y confirma de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
