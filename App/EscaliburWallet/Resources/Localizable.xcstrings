        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux comptes de ce jeton sont gelés par l’émetteur dès leur création."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस टोकन के नए खाते जारीकर्ता द्वारा फ़्रीज़ होकर शुरू होते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akun baru untuk token ini langsung dibekukan oleh penerbit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このトークンの新しいアカウントは、発行者によって凍結された状態で作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 토큰의 새 계정은 발행자에 의해 동결된 상태로 생성됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu token'ın yeni hesapları ihraççı tarafından dondurulmuş olarak başlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản mới của token này bị bên phát hành đóng băng ngay từ đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代币的新账户在创建时就会被发行方冻结。"
          }
        }
