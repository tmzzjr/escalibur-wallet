    "Endereço salvo vira atalho no envio e entra na conferência de endereço parecido. Salvar pede %@ ou PIN." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصبح العنوان المحفوظ اختصارًا عند الإرسال ويدخل في فحص العناوين المتشابهة. الحفظ يتطلب %@ أو PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine gespeicherte Adresse wird beim Senden zur Abkürzung und fließt in die Prüfung auf ähnliche Adressen ein. Speichern verlangt %@ oder PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saved address becomes a shortcut when sending and is included in the similar-address check. Saving requires %@ or your PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dirección guardada se convierte en un atajo al enviar y entra en la comprobación de direcciones parecidas. Guardar pide %@ o PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse enregistrée devient un raccourci lors de l’envoi et entre dans le contrôle des adresses similaires. L’enregistrement demande %@ ou votre PIN."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेव किया गया पता भेजते समय शॉर्टकट बन जाता है और मिलते-जुलते पते की जांच में शामिल होता है. सेव करने के लिए %@ या PIN चाहिए."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat yang disimpan menjadi pintasan saat mengirim dan ikut dalam pemeriksaan alamat mirip. Menyimpan memerlukan %@ atau PIN."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したアドレスは送金時のショートカットになり、似たアドレスのチェックにも使われます。保存には %@ または PIN が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 주소는 보낼 때 바로가기가 되고, 비슷한 주소 확인에도 사용됩니다. 저장하려면 %@ 또는 PIN이 필요합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedilen adres, gönderirken kısayol olur ve benzer adres kontrolüne dahil edilir. Kaydetmek için %@ veya PIN gerekir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Địa chỉ đã lưu sẽ thành lối tắt khi gửi và được đưa vào bước kiểm tra địa chỉ tương tự. Lưu cần %@ hoặc PIN."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存的地址会成为发送时的快捷方式，并纳入相似地址检查。保存需要 %@ 或 PIN 码验证。"
          }
        }
      }
    },
