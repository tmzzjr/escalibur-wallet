    },
    "A taxa deste envio passaria do teto absoluto da carteira. Nada foi montado." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسوم هذا التحويل ستتجاوز السقف المطلق للمحفظة. لم يتم تجهيز أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gebühr für diesen Transfer würde die absolute Obergrenze des Wallets überschreiten. Nichts wurde vorbereitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fee for this transfer would exceed the wallet's absolute cap. Nothing was prepared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comisión de este envío superaría el tope absoluto de la billetera. No se preparó nada."
