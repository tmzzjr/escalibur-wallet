    "Fica no livro até executar ou ser cancelada" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى في دفتر الأوامر حتى يُنفَّذ أو يُلغى"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt im Orderbuch, bis sie ausgeführt oder storniert wird"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stays on the order book until it executes or is canceled"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda en el libro hasta que se ejecute o se cancele"
          }
