    "%@ uma tag (um número), cole aqui. Sem ela, a exchange pode não achar o depósito. Para uma carteira pessoal, deixe vazio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ علامة (رقمًا)، فالصقها هنا. بدونها، قد لا تجد المنصة إيداعك. إذا كان الإرسال إلى محفظة شخصية، فاتركها فارغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ einen Tag (eine Zahl) bekommen hast, füge ihn hier ein. Ohne ihn findet die Börse deine Einzahlung eventuell nicht. Für ein persönliches Wallet lass das Feld leer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a tag (a number), paste it here. Without it, the exchange may not find your deposit. For a personal wallet, leave this empty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ una etiqueta (un número), pégala aquí. Sin ella, el exchange podría no encontrar el depósito. Para una billetera personal, déjalo vacío."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ un tag (un nombre), collez-le ici. Sans lui, la plateforme risque de ne pas trouver le dépôt. Pour un portefeuille personnel, laissez vide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कोई टैग (एक नंबर) दिया है, तो उसे यहां पेस्ट करें. इसके बिना एक्सचेंज शायद आपका डिपॉज़िट न ढूंढ पाए. निजी वॉलेट के लिए इसे खाली छोड़ें."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tag (berupa angka), tempel di sini. Tanpa tag, exchange mungkin tidak menemukan deposit Anda. Untuk dompet pribadi, biarkan kosong."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@タグ（数字）が指定された場合は、ここに貼り付けてください。タグがないと、取引所が入金を見つけられない場合があります。個人のウォレットの場合は空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 태그(숫자)를 받았다면 여기에 붙여 넣으세요. 태그가 없으면 거래소가 입금을 찾지 못할 수 있습니다. 개인 지갑으로 보낸다면 비워 두세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bir etiket (bir sayı) verdiyse, buraya yapıştır. Etiket olmadan borsa yatırmayı bulamayabilir. Kişisel bir cüzdan için boş bırak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ một tag (dạng số), hãy dán vào đây. Thiếu tag, sàn có thể không tìm thấy khoản nạp của bạn. Với ví cá nhân, hãy để trống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@标签（一串数字），请粘贴到这里。没有标签，交易所可能找不到你的充值。如果是个人钱包，请留空。"
          }
        }
      }
    },
    "%@ vezes o preço de mercado: a ordem provavelmente nunca executa." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ضعف سعر السوق: على الأرجح لن يُنفَّذ الأمر أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das %@-Fache des Marktpreises: Die Order wird wahrscheinlich nie ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ times the market price: the order will probably never execute."
          }
        },
