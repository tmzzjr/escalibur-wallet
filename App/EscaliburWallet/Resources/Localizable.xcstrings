    },
    "%@ ficam reservados pela rede enquanto a conta, as linhas de confiança e as ofertas dela existirem." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ محجوز لدى الشبكة كاحتياطي ما دام الحساب وخطوط الثقة والعروض الخاصة به موجودة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hält das Netzwerk als Reserve zurück, solange das Konto, seine Trustlines und seine Angebote bestehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is held in reserve by the network while the account, its trustlines and its offers exist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quedan reservados por la red mientras existan la cuenta, sus líneas de confianza y sus ofertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau garde %@ en réserve tant que le compte, ses lignes de confiance et ses offres existent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक खाता, उसकी ट्रस्टलाइन और उसके ऑफ़र मौजूद हैं, नेटवर्क %@ रिज़र्व में रखता है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ditahan sebagai cadangan oleh jaringan selama akun, trustline, dan penawarannya masih ada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントとそのトラストライン、オファーが存在する間、%@ はネットワークのリザーブとして確保されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 금액은 계정과 그 트러스트라인, 오퍼가 존재하는 동안 네트워크 준비금으로 묶여 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, hesap ve hesabın güven hatları ile teklifleri var olduğu sürece ağ tarafından rezerv olarak tutulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ được mạng giữ làm khoản dự trữ chừng nào tài khoản, các trustline và lệnh của tài khoản còn tồn tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要账户及其信任线和挂单存在，%@ 就会由网络作为储备金保留。"
          }
        }
      }
    },
