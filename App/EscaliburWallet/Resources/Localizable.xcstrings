          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받는 쪽은 %2$@ 네트워크로 %1$@ 토큰을 받습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Quem vai receber aceita %1$@ pela %2$@"
          }
        },
