    "Senha muito fraca: guarde o arquivo num pendrive ou no seu computador, nunca na nuvem nem por e-mail." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمة مرور ضعيفة جدًا: احفظ الملف على ذاكرة USB أو على حاسوبك، وليس في السحابة أو عبر البريد الإلكتروني أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr schwaches Passwort: Bewahre die Datei auf einem USB-Stick oder deinem Computer auf, nie in der Cloud oder per E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Very weak password: keep the file on a USB drive or your computer, never in the cloud or by email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraseña muy débil: guarda el archivo en una memoria USB o en tu equipo, nunca en la nube ni por correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mot de passe très faible : gardez le fichier sur une clé USB ou sur votre ordinateur, jamais dans le cloud ni par e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बहुत कमज़ोर पासवर्ड: फ़ाइल पेनड्राइव या अपने कंप्यूटर पर रखें, कभी क्लाउड में या ईमेल से नहीं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi sangat lemah: simpan file di flashdisk atau komputer Anda, jangan pernah di cloud atau lewat email."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常に弱いパスワードです。ファイルは USB メモリかコンピュータに保管し、クラウドやメールには絶対に保存しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매우 약한 비밀번호: 파일을 USB 드라이브나 컴퓨터에 보관하고, 절대 클라우드나 이메일에 두지 마세요."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok zayıf şifre: dosyayı bir USB bellekte veya bilgisayarında sakla; asla bulutta veya e-postada değil."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mật khẩu rất yếu: hãy cất tệp trong USB hoặc máy tính của bạn, đừng bao giờ để trên đám mây hay gửi qua email."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码非常弱：请将文件存放在 U 盘或你的电脑上，切勿存到云端或通过电子邮件发送。"
          }
        }
      }
    },
