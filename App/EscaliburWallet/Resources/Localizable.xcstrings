        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई भी कोट वॉलेट की सुरक्षा जांच में पास नहीं हुआ. कुछ भी साइन नहीं हुआ."
          }
        },
        "id" : {
          "stringUnit" : {
