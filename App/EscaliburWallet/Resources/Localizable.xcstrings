    "Três palavras por vez. Arraste o cartão ou toque em Próximas." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاث كلمات في كل مرة. اسحب البطاقة أو اضغط التالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei Wörter auf einmal. Wische die Karte oder tippe auf Nächste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three words at a time. Swipe the card or tap Next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres palabras a la vez. Desliza la tarjeta o toca Siguientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois mots à la fois. Faites glisser la carte ou touchez Suivants."
