    "Carteiras com passphrase e carteiras com as palavras ainda não confirmadas ficam de fora. Desligar apaga o arquivo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحافظ التي تستخدم passphrase والمحافظ التي لم تُؤكَّد كلماتها بعد مستثناة. الإيقاف يحذف الملف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallets mit Passphrase und Wallets, deren Wörter noch nicht bestätigt sind, bleiben außen vor. Ausschalten löscht die Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallets with a passphrase and wallets whose words haven't been confirmed yet are left out. Turning it off deletes the file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las billeteras con passphrase y las billeteras con las palabras aún sin confirmar quedan fuera. Desactivarlo borra el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les portefeuilles avec passphrase et ceux dont les mots ne sont pas encore confirmés sont exclus. Désactiver supprime le fichier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासफ़्रेज़ वाले वॉलेट और वे वॉलेट जिनके शब्दों की अभी पुष्टि नहीं हुई है, इसमें शामिल नहीं होते. बंद करने पर फ़ाइल मिट जाती है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet dengan passphrase dan dompet yang kata-katanya belum dikonfirmasi tidak disertakan. Menonaktifkannya akan menghapus file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスフレーズ付きのウォレットと、単語がまだ確認されていないウォレットは対象外です。オフにするとファイルは削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패스프레이즈 지갑과 아직 단어를 확인하지 않은 지갑은 제외됩니다. 끄면 파일이 삭제됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passphrase'li cüzdanlar ve kelimeleri henüz onaylanmamış cüzdanlar dahil edilmez. Kapatmak dosyayı siler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví có passphrase và ví chưa xác nhận các từ sẽ không được tính. Tắt đi sẽ xóa tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 passphrase 的钱包和单词尚未确认的钱包不包括在内。关闭后会删除该文件。"
          }
        }
      }
    },
    "Carteiras com passphrase ficam de fora. Dá para mudar em Ajustes, Aviso de recebimento." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المحافظ التي تستخدم passphrase مستثناة. يمكنك تغيير ذلك في الإعدادات، تنبيه الاستلام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallets mit Passphrase bleiben außen vor. Du kannst das unter Einstellungen, Hinweis bei Eingang ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wallets with a passphrase are left out. You can change this in Settings, Incoming alert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las billeteras con passphrase quedan fuera. Puedes cambiarlo en Ajustes, Aviso de recepción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les portefeuilles avec passphrase sont exclus. Vous pouvez modifier cela dans Réglages, Alerte de réception."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पासफ़्रेज़ वाले वॉलेट इसमें शामिल नहीं होते. आप इसे सेटिंग्स, प्राप्ति अलर्ट में बदल सकते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dompet dengan passphrase tidak disertakan. Anda bisa mengubahnya di Pengaturan, Notifikasi dana masuk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスフレーズ付きのウォレットは対象外です。「設定」>「受け取り通知」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패스프레이즈 지갑은 제외됩니다. 설정 > 입금 알림에서 변경할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passphrase'li cüzdanlar dahil edilmez. Bunu Ayarlar > Gelen transfer bildirimi bölümünden değiştirebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ví có passphrase sẽ không được tính. Bạn có thể thay đổi trong Cài đặt, Thông báo nhận tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 passphrase 的钱包不包括在内。可以在“设置”>“到账提醒”中更改。"
          }
        }
      }
    },
