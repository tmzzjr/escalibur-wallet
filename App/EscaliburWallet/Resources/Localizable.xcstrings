    "Este envio junta moedas demais para uma transação só. Envie um valor menor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا التحويل يجمع عملات كثيرة جدًا لمعاملة واحدة. أرسل مبلغًا أصغر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
