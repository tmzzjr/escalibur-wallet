        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस खाते के %@ Sui के एड्रेस बैलेंस में हैं, जिसे Escalibur अभी मूव नहीं कर सकता. अधिकतम में सिर्फ़ SUI कॉइन गिने जाते हैं."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
