    "Este iPhone não reconhece fala sem internet agora." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا iPhone التعرف على الكلام دون اتصال بالإنترنت الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann Sprache gerade nicht offline erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone can't recognize speech offline right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no reconoce voz sin internet ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas reconnaître la parole hors connexion pour le moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone अभी बिना इंटरनेट के बोली नहीं पहचान सकता."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak bisa mengenali ucapan tanpa internet saat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone は現在オフラインで音声を認識できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 지금 인터넷 없이 음성을 인식할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone şu an internet olmadan konuşma tanıyamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone này hiện không nhận dạng được giọng nói khi ngoại tuyến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 目前无法离线识别语音。"
          }
        }
      }
    },
    "Este iPhone não reconhece fala sem internet, nem em português nem em inglês, então a confirmação por voz não está disponível." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا iPhone التعرف على الكلام دون اتصال بالإنترنت، لا بالبرتغالية ولا بالإنجليزية، لذا فالتأكيد الصوتي غير متاح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann Sprache weder auf Portugiesisch noch auf Englisch offline erkennen, daher ist die Sprachbestätigung nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPhone can't recognize speech offline in either Portuguese or English, so voice confirmation isn't available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no reconoce voz sin internet, ni en portugués ni en inglés, así que la confirmación por voz no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas reconnaître la parole hors connexion, ni en portugais ni en anglais : la confirmation vocale n’est donc pas disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone बिना इंटरनेट के न पुर्तगाली में बोली पहचान सकता है, न अंग्रेज़ी में, इसलिए वॉइस पुष्टि उपलब्ध नहीं है."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak bisa mengenali ucapan tanpa internet, baik dalam bahasa Portugis maupun Inggris, jadi konfirmasi suara tidak tersedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone はオフラインでポルトガル語も英語も音声認識できないため、音声確認は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 인터넷 없이 포르투갈어와 영어 음성을 모두 인식할 수 없어 음성 확인을 사용할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone internet olmadan ne Portekizce ne de İngilizce konuşma tanıyabiliyor; bu yüzden sesli onay kullanılamıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone này không nhận dạng được giọng nói khi ngoại tuyến, cả tiếng Bồ Đào Nha lẫn tiếng Anh, nên không dùng được xác nhận bằng giọng nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 无法离线识别葡萄牙语或英语语音，因此无法使用语音确认。"
          }
        }
      }
    },
