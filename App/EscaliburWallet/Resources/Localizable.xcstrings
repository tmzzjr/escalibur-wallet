                  "value" : "على XRP Ledger، ليس للرموز المميزة خانات عشرية ثابتة. تعرض المحفظة حتى %lld خانة عشرية."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "على XRP Ledger، ليس للرموز المميزة خانات عشرية ثابتة. تعرض المحفظة حتى %lld خانتين عشريتين."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "على XRP Ledger، ليس للرموز المميزة خانات عشرية ثابتة. تعرض المحفظة حتى %lld خانة عشرية."
                }
              }
            }
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem XRP Ledger haben Token keine festen Dezimalstellen. Das Wallet zeigt bis zu %lld Stellen."
