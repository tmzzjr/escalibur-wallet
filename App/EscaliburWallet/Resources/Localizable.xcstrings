            "state" : "translated",
            "value" : "Sin copia de seguridad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune sauvegarde"
          }
        }
      }
    },
    "Sem ela, as palavras acima abrem uma carteira diferente e vazia." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it, the words above open a different, empty wallet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin ella, las palabras de arriba abren una billetera distinta y vacía."
          }
