    "A rede %@ não usa tag nem memo. Envie só com o endereço." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شبكة %@ لا تستخدم علامة أو مذكرة. أرسل بالعنوان فقط."
          }
