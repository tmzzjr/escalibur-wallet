    "Esta carteira só acompanha um endereço. A passphrase precisa da senha de 12 ou 24 palavras." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet only tracks an address. A passphrase needs a 12 or 24-word recovery phrase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta billetera solo sigue una dirección. La passphrase necesita una frase de recuperación de 12 o 24 palabras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce portefeuille ne fait que suivre une adresse. Une passphrase nécessite une phrase de récupération de 12 ou 24 mots."
          }
        }
      }
    },
    "Esta carteira só acompanha: para cancelar, abra a carteira que assina." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This wallet is watch-only: to cancel, open the wallet that signs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta billetera es de solo lectura: para cancelar, abre la billetera que firma."
          }
